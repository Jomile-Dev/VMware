# Authenticate as the local System Domain admin
$header = New-Object 'System.Collections.Generic.Dictionary[String,String]'
$header.Add('Accept', 'application/json')
$header.Add('Content-Type', 'application/json')

$authBody = @{
    username   = $vidmTenantCreds.UserName
    password   = $vidmTenantCreds.GetNetworkCredential().Password
    issueToken = 'true'
} | ConvertTo-Json -Compress

$uri = "https://$vidmTenant/SAAS/API/1.0/REST/auth/system/login"

$authResponse = Invoke-RestMethod `
    -Uri $uri `
    -Headers $header `
    -Method Post `
    -Body $authBody `
    -ErrorAction Stop

$vidmSessionToken = $authResponse.sessionToken

if (-not $vidmSessionToken) {
    throw "No System Domain session token was returned."
}

$header.Add('Authorization', "HZN $vidmSessionToken")
