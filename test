# Build Basic auth header from client_id:client_secret
$basicAuth = [Convert]::ToBase64String(
    [Text.Encoding]::UTF8.GetBytes("${vidmClientId}:${vidmClientSecret}")
)

$header = @{
    Accept          = 'application/json'
    'Content-Type'  = 'application/x-www-form-urlencoded'
    Authorization   = "Basic $basicAuth"
}

# Request access token via client_credentials grant
$uri = "https://$vidmTenant/SAAS/auth/oauthtoken?grant_type=client_credentials"

try {
    $authResponse = Invoke-RestMethod -Uri $uri -Headers $header `
        -Method Post -ErrorAction Stop
}
catch {
    Write-Warning "OAuth token request failed: $($_.ErrorDetails.Message)"
    throw
}

$vidmAccessToken = $authResponse.access_token

if ($vidmAccessToken) {
    $header = @{
        Accept          = 'application/json'
        'Content-Type'  = 'application/json'
        Authorization   = "Bearer $vidmAccessToken"
    }
}
else {
    Write-Warning "Token missing, cannot continue"
    break
}
