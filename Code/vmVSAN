# VMware PowerCLI Script to get ALL VMs with storage location and actual storage usage
# Reports whether each VM is on SAN, vSAN, NFS, other storage, or a mix
# Loops through multiple vCenter Servers
# Optimized for performance

# vCenter Servers to process (replace with your vCenter details)
$vCenterServers = @(
    "<vcenter-fqdn-01>",
    "<vcenter-fqdn-02>",
    "<vcenter-fqdn-03>"
)

# Set to $true to be prompted for a separate credential for each vCenter
$UsePerVCenterCredential = $false

if (-not $UsePerVCenterCredential) {
    $Credential = Get-Credential -Message "Credential for all vCenter Servers"
}

# Function to build the datastore cache for the connected vCenter
function Get-DatastoreInfoCache {
    param($Server)

    $cache = @{}
    $datastores = Get-Datastore -Server $Server

    foreach ($ds in $datastores) {
        $cache[$ds.Name] = @{
            Type        = $ds.Type
            Name        = $ds.Name
            IsExternal  = $false
            StorageType = "Other"
        }

        if ($ds.Type -eq "vsan") {
            $cache[$ds.Name].StorageType = "vSAN"
        }
        elseif ($ds.Type -eq "VMFS") {
            # Check if shared across multiple hosts (external storage indicator)
            if ($ds.ExtensionData.Summary.MultipleHostAccess) {
                $cache[$ds.Name].IsExternal = $true
                $cache[$ds.Name].StorageType = "SAN"
            }
            # Also check by naming convention (faster than LUN inspection)
            if ($ds.Name -match "(SAN|FC|iSCSI|PURE|NETAPP|EMC|DELL|HP|3PAR|COMPELLENT|EQUALLOGIC)") {
                $cache[$ds.Name].IsExternal = $true
                $cache[$ds.Name].StorageType = "SAN"
            }
        }
        elseif ($ds.Type -eq "NFS" -or $ds.Type -eq "NFS41") {
            $cache[$ds.Name].StorageType = "NFS"
        }
    }

    return $cache
}

# Function to get VM storage breakdown quickly
function Get-VMStorageBreakdown {
    param($VM, $DatastoreInfo)

    $storageBreakdown = @{
        SAN   = @{ Used = 0; Provisioned = 0; Datastores = @() }
        vSAN  = @{ Used = 0; Provisioned = 0; Datastores = @() }
        NFS   = @{ Used = 0; Provisioned = 0; Datastores = @() }
        Other = @{ Used = 0; Provisioned = 0; Datastores = @() }
    }

    # Get VM view for storage information
    $vmView  = $VM | Get-View
    $vmDisks = Get-HardDisk -VM $VM

    # Calculate total used space from VM summary
    $totalUsedGB = 0

    if ($vmView.Summary.Storage.Committed) {
        $totalUsedGB = [math]::Round(($vmView.Summary.Storage.Committed / 1GB), 2)
    }

    # Get datastore usage breakdown
    $datastoreUsage = @{}
    $totalDiskProvisioned = 0

    # First pass: calculate provisioned space per datastore
    foreach ($disk in $vmDisks) {
        try {
            $datastoreName = $disk.Filename.Split('[')[1].Split(']')[0]
            $diskProvisionedGB = [math]::Round($disk.CapacityGB, 2)
            $totalDiskProvisioned += $diskProvisionedGB

            if (-not $datastoreUsage[$datastoreName]) {
                $datastoreUsage[$datastoreName] = @{
                    Provisioned = 0
                    Used        = 0
                    Type        = "Other"
                }
            }

            $datastoreUsage[$datastoreName].Provisioned += $diskProvisionedGB

            # Get datastore info from cache
            $dsInfo = $DatastoreInfo[$datastoreName]
            if ($dsInfo) {
                $datastoreUsage[$datastoreName].Type = $dsInfo.StorageType
            }
        }
        catch {
            Write-Warning "Error processing disk $($disk.Name): $($_.Exception.Message)"
        }
    }

    # Calculate used space proportionally based on provisioned space
    if ($totalDiskProvisioned -gt 0 -and $totalUsedGB -gt 0) {
        foreach ($dsName in $datastoreUsage.Keys) {
            $provisionedRatio = $datastoreUsage[$dsName].Provisioned / $totalDiskProvisioned
            $datastoreUsage[$dsName].Used = [math]::Round(($totalUsedGB * $provisionedRatio), 2)
        }
    }
    else {
        # If we can't get used space, use provisioned as fallback
        foreach ($dsName in $datastoreUsage.Keys) {
            $datastoreUsage[$dsName].Used = $datastoreUsage[$dsName].Provisioned
        }
    }

    # Categorize by storage type
    foreach ($dsName in $datastoreUsage.Keys) {
        $usage = $datastoreUsage[$dsName]
        $bucket = $storageBreakdown[$usage.Type]

        $bucket.Used += $usage.Used
        $bucket.Provisioned += $usage.Provisioned
        if ($bucket.Datastores -notcontains $dsName) {
            $bucket.Datastores += $dsName
        }
    }

    # Round all values
    foreach ($type in @("SAN", "vSAN", "NFS", "Other")) {
        $storageBreakdown[$type].Used        = [math]::Round($storageBreakdown[$type].Used, 2)
        $storageBreakdown[$type].Provisioned = [math]::Round($storageBreakdown[$type].Provisioned, 2)
    }

    # Build storage location label (e.g. "SAN", "vSAN", "vSAN + SAN")
    $locations = @()
    foreach ($type in @("vSAN", "SAN", "NFS", "Other")) {
        if ($storageBreakdown[$type].Datastores.Count -gt 0) {
            $locations += $type
        }
    }

    if ($locations.Count -eq 0) {
        $storageBreakdown.StorageLocation = "No disks"
    }
    else {
        $storageBreakdown.StorageLocation = $locations -join " + "
    }

    return $storageBreakdown
}

$vmResults = @()
$failedVCenters = @()
$vcIndex = 0

foreach ($vCenterServer in $vCenterServers) {
    $vcIndex++
    Write-Host "`n===== [$vcIndex/$($vCenterServers.Count)] $vCenterServer =====" -ForegroundColor Cyan

    # Connect to this vCenter
    try {
        if ($UsePerVCenterCredential) {
            $vcCredential = Get-Credential -Message "Credential for $vCenterServer"
        }
        else {
            $vcCredential = $Credential
        }
        $viServer = Connect-VIServer -Server $vCenterServer -Credential $vcCredential -ErrorAction Stop
    }
    catch {
        Write-Warning "Failed to connect to $vCenterServer : $($_.Exception.Message)"
        $failedVCenters += $vCenterServer
        continue
    }

    try {
        # Pre-cache datastore information for this vCenter
        Write-Host "Caching datastore information..." -ForegroundColor Green
        $datastoreInfo = Get-DatastoreInfoCache -Server $viServer

        # Get all VMs at once for performance
        Write-Host "Retrieving all VMs..." -ForegroundColor Green
        $allVMs = @(Get-VM -Server $viServer)

        Write-Host "Processing all VMs and calculating actual usage..." -ForegroundColor Green
        $processedCount = 0

        foreach ($vm in $allVMs) {
            $processedCount++
            Write-Progress -Activity "Processing VMs on $vCenterServer" -Status "Processing $($vm.Name) ($processedCount of $($allVMs.Count))" -PercentComplete (($processedCount / $allVMs.Count) * 100)

            $storageBreakdown = Get-VMStorageBreakdown -VM $vm -DatastoreInfo $datastoreInfo

            $vmResults += [PSCustomObject]@{
                vCenter              = $vCenterServer
                VMName               = $vm.Name
                StorageLocation      = $storageBreakdown.StorageLocation
                PowerState           = $vm.PowerState
                CPUs                 = $vm.NumCpu
                CPUCoresPerSocket    = $vm.CoresPerSocket
                CPUHotAddEnabled     = $vm.ExtensionData.Config.CpuHotAddEnabled
                MemoryGB             = [math]::Round($vm.MemoryGB, 2)
                MemoryMB             = $vm.MemoryMB
                MemoryHotAddEnabled  = $vm.ExtensionData.Config.MemoryHotAddEnabled

                # vSAN Storage
                vSAN_UsedGB          = $storageBreakdown.vSAN.Used
                vSAN_ProvisionedGB   = $storageBreakdown.vSAN.Provisioned
                vSAN_Datastores      = ($storageBreakdown.vSAN.Datastores -join ", ")

                # SAN Storage (external)
                SAN_UsedGB           = $storageBreakdown.SAN.Used
                SAN_ProvisionedGB    = $storageBreakdown.SAN.Provisioned
                SAN_Datastores       = ($storageBreakdown.SAN.Datastores -join ", ")

                # NFS Storage
                NFS_UsedGB           = $storageBreakdown.NFS.Used
                NFS_ProvisionedGB    = $storageBreakdown.NFS.Provisioned
                NFS_Datastores       = ($storageBreakdown.NFS.Datastores -join ", ")

                # Other Storage (local VMFS or unclassified)
                Other_UsedGB         = $storageBreakdown.Other.Used
                Other_ProvisionedGB  = $storageBreakdown.Other.Provisioned
                Other_Datastores     = ($storageBreakdown.Other.Datastores -join ", ")

                # Totals
                Total_UsedGB         = [math]::Round(($storageBreakdown.SAN.Used + $storageBreakdown.vSAN.Used + $storageBreakdown.NFS.Used + $storageBreakdown.Other.Used), 2)
                Total_ProvisionedGB  = [math]::Round(($storageBreakdown.SAN.Provisioned + $storageBreakdown.vSAN.Provisioned + $storageBreakdown.NFS.Provisioned + $storageBreakdown.Other.Provisioned), 2)

                # Metadata
                Host                 = $vm.VMHost.Name
                Cluster              = (Get-Cluster -VM $vm -Server $viServer).Name
            }
        }

        Write-Progress -Completed -Activity "Processing VMs on $vCenterServer"
    }
    catch {
        Write-Warning "Error processing $vCenterServer : $($_.Exception.Message)"
        $failedVCenters += $vCenterServer
    }
    finally {
        # Disconnect from this vCenter before moving to the next
        Disconnect-VIServer -Server $viServer -Confirm:$false -ErrorAction SilentlyContinue
    }
}

# Display results
Write-Host "`nAll VMs (showing storage location and actual used/provisioned space):" -ForegroundColor Yellow
$vmResults | Sort-Object vCenter, StorageLocation, VMName | Format-Table vCenter, VMName, StorageLocation, PowerState, CPUs, MemoryGB, vSAN_UsedGB, SAN_UsedGB, Total_UsedGB, Total_ProvisionedGB -AutoSize

# Export to CSV (all vCenters combined)
$exportPath = "C:\temp\VM_Storage_Location_$(Get-Date -Format 'yyyyMMdd_HHmmss').csv"
$vmResults | Sort-Object vCenter, StorageLocation, VMName | Export-Csv -Path $exportPath -NoTypeInformation
Write-Host "`nResults exported to: $exportPath" -ForegroundColor Green

# VM count by storage location
Write-Host "`nVM Count by Storage Location:" -ForegroundColor Cyan
$vmResults | Group-Object -Property StorageLocation | Sort-Object Name | ForEach-Object {
    Write-Host "  $($_.Name): $($_.Count) VMs"
}

# Per-vCenter summary
Write-Host "`nPer-vCenter Summary:" -ForegroundColor Cyan
$vmResults | Group-Object -Property vCenter | ForEach-Object {
    $vcvSAN = ($_.Group | Measure-Object -Property vSAN_UsedGB -Sum).Sum
    $vcSAN  = ($_.Group | Measure-Object -Property SAN_UsedGB -Sum).Sum
    Write-Host "  $($_.Name): $($_.Count) VMs, vSAN $([math]::Round($vcvSAN, 2)) GB used, SAN $([math]::Round($vcSAN, 2)) GB used"
}

# Overall summary
Write-Host "`nEnvironment Storage Summary (all vCenters):" -ForegroundColor Cyan
Write-Host "vCenters processed: $($vCenterServers.Count - $failedVCenters.Count) of $($vCenterServers.Count)"
Write-Host "Total VMs: $($vmResults.Count)"
Write-Host "Total CPU cores: $(($vmResults | Measure-Object -Property CPUs -Sum).Sum)"
Write-Host "Total Memory GB: $(($vmResults | Measure-Object -Property MemoryGB -Sum).Sum)"

$totals = @{}
foreach ($type in @("vSAN", "SAN", "NFS", "Other")) {
    $totals[$type] = @{
        Used        = [math]::Round((($vmResults | Measure-Object -Property "$($type)_UsedGB" -Sum).Sum), 2)
        Provisioned = [math]::Round((($vmResults | Measure-Object -Property "$($type)_ProvisionedGB" -Sum).Sum), 2)
    }
}

$grandTotalUsed        = $totals.vSAN.Used + $totals.SAN.Used + $totals.NFS.Used + $totals.Other.Used
$grandTotalProvisioned = $totals.vSAN.Provisioned + $totals.SAN.Provisioned + $totals.NFS.Provisioned + $totals.Other.Provisioned

Write-Host "`nStorage Usage Breakdown:" -ForegroundColor White
Write-Host "  vSAN Storage: $($totals.vSAN.Used) GB used / $($totals.vSAN.Provisioned) GB provisioned" -ForegroundColor Magenta
Write-Host "  SAN Storage: $($totals.SAN.Used) GB used / $($totals.SAN.Provisioned) GB provisioned" -ForegroundColor Green
Write-Host "  NFS Storage: $($totals.NFS.Used) GB used / $($totals.NFS.Provisioned) GB provisioned" -ForegroundColor Yellow
Write-Host "  Other Storage: $($totals.Other.Used) GB used / $($totals.Other.Provisioned) GB provisioned" -ForegroundColor Gray
Write-Host "  TOTAL: $grandTotalUsed GB used / $grandTotalProvisioned GB provisioned" -ForegroundColor White

if ($grandTotalProvisioned -gt 0) {
    $utilizationPercent = [math]::Round(($grandTotalUsed / $grandTotalProvisioned * 100), 1)
    Write-Host "  Overall Storage Utilization: $utilizationPercent%" -ForegroundColor Cyan
}

if ($failedVCenters.Count -gt 0) {
    Write-Host "`nvCenters that failed:" -ForegroundColor Red
    $failedVCenters | ForEach-Object { Write-Host "  $_" -ForegroundColor Red }
}