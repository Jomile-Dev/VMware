# ============================================================================
# VM POWER ACTION FROM CSV - POWER ON / POWER OFF (GRACEFUL)
# Reads a list of VMs from CSV and powers them on or gracefully shuts them down
# Searches across multiple vCenter servers
# Exports BEFORE and AFTER power state side by side to a CSV report
# PowerOff = graceful guest OS shutdown ONLY - no hard power off at any point
# DryRun is ON by default - NO changes are made until set to $false
# Requires: VMware PowerCLI
# ============================================================================
#
# CSV FORMAT:
#   Name,Action
#   <vm-name-01>,PowerOff
#   <vm-name-02>,PowerOn
#   <vm-name-03>,
#
# Name     - required
# Action   - required column - PowerOn | PowerOff - blank = do nothing for that VM
#
# Every VM is searched for across ALL vCenters in $vCenterServers
# If the same VM name exists more than once, it is skipped as Ambiguous
# ============================================================================

# ============================================================================
# CONFIGURATION SECTION
# ============================================================================

# vCenter connection parameters - REPLACE WITH YOUR ACTUAL SERVER NAMES
$vCenterServers = @(
    '<vcenter-01-fqdn>',
    '<vcenter-02-fqdn>',
    '<vcenter-03-fqdn>'
)

$CredentialPath    = 'C:\<path>\vcenter_creds.xml'  # Saved credential file - one login used for ALL vCenters

$MainDirectory     = 'C:\<path>\VMPowerAction'      # Main working directory
$FileName          = 'vm-list.csv'                  # Input CSV file name (inside main directory)

$CsvPath           = Join-Path $MainDirectory $FileName
$OutputFolder      = Join-Path $MainDirectory 'Reports'   # Reports saved here (created if missing)

$NameColumn        = 'Name'                         # CSV column with VM name
$ActionColumn      = 'Action'                       # CSV column with action - PowerOn | PowerOff (graceful)

$DryRun            = $true                          # Set to $false to actually make changes

# ============================================================================
# TIMEOUT SETTINGS
# ============================================================================

$TimeoutSeconds    = 600                            # Max wait for VMs to reach target state
$PollSeconds       = 10                             # Seconds between state checks

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

function Get-VmState {
    param(
        [Parameter(Mandatory)]$VM,
        [Parameter(Mandatory)]$Server
    )

    # Re-read the VM by Id from its own vCenter - VM Ids are not unique across vCenters
    $v = Get-VM -Id $VM.Id -Server $Server -ErrorAction Stop

    # Host parent is the cluster - blank for standalone hosts
    $cluster = ''
    if ($v.VMHost -and $v.VMHost.Parent) { $cluster = [string]$v.VMHost.Parent.Name }

    [pscustomobject]@{
        PowerState  = [string]$v.PowerState
        ToolsStatus = [string]$v.ExtensionData.Guest.ToolsRunningStatus
        VMHost      = [string]$v.VMHost.Name
        Cluster     = $cluster
    }
}

function Wait-VmTargetState {
    param(
        [Parameter(Mandatory)]$Items,
        [Parameter(Mandatory)][int]$Timeout,
        [Parameter(Mandatory)][int]$Interval
    )

    # Poll all Pending VMs until they reach target state or timeout
    $deadline = (Get-Date).AddSeconds($Timeout)
    do {
        $pending = @($Items | Where-Object { $_.Result -eq 'Pending' })
        foreach ($p in $pending) {
            try {
                $state = [string](Get-VM -Id $p.VM.Id -Server $p.Server -ErrorAction Stop).PowerState
                if ($state -eq $p.TargetState) { $p.Result = 'Success' }
            }
            catch {
                # Fail this VM only - do not stop the whole run
                $p.Result  = 'Failed'
                $p.Message = "State check failed: $($_.Exception.Message)"
            }
        }

        # Exit early once nothing is left pending
        $pending = @($Items | Where-Object { $_.Result -eq 'Pending' })
        if ($pending.Count -eq 0) { break }

        $remaining = [int]($deadline - (Get-Date)).TotalSeconds
        Write-Host ("  Waiting on {0} VM(s)... {1}s remaining" -f $pending.Count, [Math]::Max($remaining, 0)) -ForegroundColor DarkGray
        Start-Sleep -Seconds $Interval
    } while ((Get-Date) -lt $deadline)
}

# ============================================================================
# MAIN SCRIPT EXECUTION
# ============================================================================

$ErrorActionPreference = 'Stop'
$validActions = @('PowerOn', 'PowerOff')
$timestamp    = Get-Date -Format 'yyyyMMdd-HHmmss'
$runMode      = if ($DryRun) { 'DryRun' } else { 'Live' }

# Validate main directory and CSV file exist, create report folder
if (-not (Test-Path -Path $MainDirectory)) { throw "Main directory not found: $MainDirectory" }
if (-not (Test-Path -Path $CsvPath)) { throw "CSV not found: $CsvPath" }
if (-not (Test-Path -Path $OutputFolder)) { New-Item -ItemType Directory -Path $OutputFolder | Out-Null }

$reportPath = Join-Path $OutputFolder ("VmPowerAction_{0}_{1}.csv" -f $runMode, $timestamp)

# Read CSV file
$rows = @(Import-Csv -Path $CsvPath)
if ($rows.Count -eq 0) { throw "CSV is empty: $CsvPath" }

# Validate CSV headers
$columns = $rows[0].PSObject.Properties.Name
if ($columns -notcontains $NameColumn) {
    throw "CSV is missing required column '$NameColumn'. Found: $($columns -join ', ')"
}
if ($columns -notcontains $ActionColumn) {
    throw "CSV is missing required column '$ActionColumn'. Found: $($columns -join ', ')"
}

Write-Host "`nMode: $runMode" -ForegroundColor $(if ($DryRun) { 'Yellow' } else { 'Red' })
Write-Host "CSV:  $CsvPath ($($rows.Count) row(s))`n"

# ============================================================================
# Load vCenter credentials (same account used for every vCenter)
# ============================================================================
# To save credentials the first time, run:
#   Get-Credential | Export-Clixml -Path "C:\<path>\vcenter_creds.xml"
# The file can only be read by the same Windows user on the same machine

Write-Host "Loading vCenter credentials from: $CredentialPath" -ForegroundColor Cyan

if (-not (Test-Path -Path $CredentialPath)) {
    throw "Credential file not found: $CredentialPath - create it with: Get-Credential | Export-Clixml -Path `"$CredentialPath`""
}

try {
    $cred = Import-Clixml -Path $CredentialPath -ErrorAction Stop
    Write-Host "Credentials loaded successfully.`n" -ForegroundColor Green
}
catch {
    throw "Failed to load credentials: $($_.Exception.Message)"
}

$connectedServers = @()
$results          = New-Object System.Collections.Generic.List[object]

try {
    # ============================================================================
    # Connect to all vCenter servers
    # ============================================================================

    foreach ($vc in $vCenterServers) {
        if ([string]::IsNullOrWhiteSpace($vc)) { continue }
        Write-Host "[$vc] Connecting..." -ForegroundColor Cyan
        try {
            $connectedServers += Connect-VIServer -Server $vc.Trim() -Credential $cred -ErrorAction Stop
            Write-Host "[$vc] Connected." -ForegroundColor Green
        }
        catch {
            # Carry on with the other vCenters
            Write-Warning "[$vc] Connection failed: $($_.Exception.Message)"
        }
    }

    if ($connectedServers.Count -eq 0) { throw "Failed to connect to any vCenter servers" }
    Write-Host "Connected to $($connectedServers.Count) of $($vCenterServers.Count) vCenter server(s)`n" -ForegroundColor Green

    # ============================================================================
    # STEP 1: Find each VM and capture BEFORE state
    # ============================================================================

    Write-Host "Phase 1: Capturing BEFORE state" -ForegroundColor Cyan
    foreach ($row in $rows) {
        $name = ([string]$row.$NameColumn).Trim()
        if ([string]::IsNullOrWhiteSpace($name)) { continue }

        # Read action for this row - blank = do nothing
        $action = ([string]$row.$ActionColumn).Trim()

        # Create report row - VM, Server and TargetState are not exported
        $item = [pscustomobject][ordered]@{
            VMName            = $name
            Action            = $action
            vCenter           = ''
            Cluster           = ''
            VMHost            = ''
            BeforePowerState  = ''
            BeforeToolsStatus = ''
            AfterPowerState   = ''
            AfterToolsStatus  = ''
            Result            = ''
            Message           = ''
            RunMode           = $runMode
            VM                = $null
            Server            = $null
            TargetState       = ''
        }
        $results.Add($item)

        # Blank action - do nothing, just report it
        if ([string]::IsNullOrWhiteSpace($action)) {
            $item.Result  = 'NoAction'
            $item.Message = 'Action blank - nothing done'
            continue
        }

        # Validate action (not case sensitive)
        $match = $validActions | Where-Object { $_ -eq $action }
        if (-not $match) {
            $item.Result  = 'InvalidAction'
            $item.Message = "Action '$action' not recognised. Use: $($validActions -join ', ')"
            continue
        }
        $item.Action = [string]$match

        # Search every connected vCenter - exact name match only
        $found = @()
        foreach ($srv in $connectedServers) {
            $found += @(Get-VM -Name $name -Server $srv -ErrorAction SilentlyContinue |
                        Where-Object { $_.Name -eq $name } |
                        ForEach-Object { [pscustomobject]@{ VM = $_; Server = $srv } })
        }

        # Skip if not found
        if ($found.Count -eq 0) {
            $item.Result  = 'NotFound'
            $item.Message = 'No VM with this exact name in any connected vCenter'
            continue
        }

        # Skip if more than one VM has the same name (same or different vCenters)
        if ($found.Count -gt 1) {
            $where = ($found | ForEach-Object { $_.Server.Name } | Sort-Object -Unique) -join ', '
            $item.Result  = 'Ambiguous'
            $item.Message = "$($found.Count) VMs share this name ($where) - skipped"
            continue
        }

        # Capture BEFORE state
        $item.VM      = $found[0].VM
        $item.Server  = $found[0].Server
        $item.vCenter = $found[0].Server.Name
        try {
            $before = Get-VmState -VM $item.VM -Server $item.Server
            $item.Cluster           = $before.Cluster
            $item.VMHost            = $before.VMHost
            $item.BeforePowerState  = $before.PowerState
            $item.BeforeToolsStatus = $before.ToolsStatus
        }
        catch {
            $item.Result  = 'Failed'
            $item.Message = "Could not read state: $($_.Exception.Message)"
        }
    }

    # ============================================================================
    # STEP 2: Issue power actions - all sent up front, no waiting per VM
    # ============================================================================

    Write-Host "`nPhase 2: Issuing power actions" -ForegroundColor Cyan
    foreach ($item in ($results | Where-Object { $_.VM -and -not $_.Result })) {

        # Set target state for this action
        $item.TargetState = if ($item.Action -eq 'PowerOn') { 'PoweredOn' } else { 'PoweredOff' }

        # Skip if already in target state
        if ($item.BeforePowerState -eq $item.TargetState) {
            $item.Result  = 'NoChange'
            $item.Message = "Already $($item.TargetState)"
            continue
        }

        # Skip suspended VMs for power off - no running guest to shut down
        if ($item.Action -eq 'PowerOff' -and $item.BeforePowerState -eq 'Suspended') {
            $item.Result  = 'Skipped'
            $item.Message = 'VM is suspended - graceful shutdown not possible'
            continue
        }

        # Check VMware Tools is running (needed for graceful shutdown)
        $toolsRunning = ($item.BeforeToolsStatus -eq 'guestToolsRunning')

        # DryRun - report what would happen, make NO changes
        if ($DryRun) {
            $item.Result = 'DryRun'
            switch ($item.Action) {
                'PowerOn'  { $item.Message = 'Would power on' }
                'PowerOff' {
                    if ($toolsRunning) { $item.Message = 'Would graceful shutdown' }
                    else               { $item.Message = 'Tools not running - would skip' }
                }
            }
            Write-Host ("  [DryRun] [{0}] {1}: {2}" -f $item.vCenter, $item.VMName, $item.Message) -ForegroundColor Yellow
            continue
        }

        # Live - issue the power action
        try {
            switch ($item.Action) {
                'PowerOn' {
                    Start-VM -VM $item.VM -Confirm:$false -RunAsync | Out-Null
                    $item.Result  = 'Pending'
                    $item.Message = 'Power on issued'
                }
                'PowerOff' {
                    if ($toolsRunning) {
                        # Graceful guest OS shutdown
                        Shutdown-VMGuest -VM $item.VM -Confirm:$false | Out-Null
                        $item.Result  = 'Pending'
                        $item.Message = 'Graceful shutdown issued'
                    }
                    else {
                        # No Tools - cannot shut down gracefully, skip
                        $item.Result  = 'Skipped'
                        $item.Message = 'VMware Tools not running - graceful shutdown not possible'
                    }
                }
            }
            Write-Host ("  [{0}] {1}: {2}" -f $item.vCenter, $item.VMName, $item.Message)
        }
        catch {
            $item.Result  = 'Failed'
            $item.Message = $_.Exception.Message
            Write-Host ("  [{0}] {1}: FAILED - {2}" -f $item.vCenter, $item.VMName, $item.Message) -ForegroundColor Red
        }
    }

    # ============================================================================
    # STEP 3: Wait for VMs to reach target state
    # ============================================================================

    if (@($results | Where-Object { $_.Result -eq 'Pending' }).Count -gt 0) {
        Write-Host "`nPhase 3: Waiting for target state (timeout ${TimeoutSeconds}s)" -ForegroundColor Cyan
        Wait-VmTargetState -Items $results -Timeout $TimeoutSeconds -Interval $PollSeconds

        # Anything still pending = Timeout - VM is left as is, NOT forced off
        foreach ($item in ($results | Where-Object { $_.Result -eq 'Pending' })) {
            $item.Result  = 'Timeout'
            $item.Message = "$($item.Message); did not reach $($item.TargetState) within timeout"
        }
    }

    # ============================================================================
    # STEP 4: Capture AFTER state
    # ============================================================================

    Write-Host "`nPhase 4: Capturing AFTER state" -ForegroundColor Cyan
    foreach ($item in ($results | Where-Object { $_.VM })) {
        try {
            $after = Get-VmState -VM $item.VM -Server $item.Server
            $item.AfterPowerState  = $after.PowerState
            $item.AfterToolsStatus = $after.ToolsStatus
        }
        catch {
            $item.AfterPowerState = 'Unknown'
            if (-not $item.Message) { $item.Message = "After-state read failed: $($_.Exception.Message)" }
        }
    }
}
finally {
    # ============================================================================
    # EXPORT REPORT + DISCONNECT (runs even if the script fails part-way)
    # ============================================================================

    if ($results.Count -gt 0) {
        $results |
            Select-Object VMName, Action, vCenter, Cluster, VMHost,
                          BeforePowerState, BeforeToolsStatus,
                          AfterPowerState, AfterToolsStatus,
                          Result, Message, RunMode |
            Export-Csv -Path $reportPath -NoTypeInformation -Encoding UTF8

        Write-Host "`nReport: $reportPath" -ForegroundColor Green

        # Summary count by result
        $results | Group-Object Result | Select-Object Name, Count | Format-Table -AutoSize
    }

    # Disconnect from all vCenters
    foreach ($srv in $connectedServers) {
        Disconnect-VIServer -Server $srv -Confirm:$false -ErrorAction SilentlyContinue
        Write-Host "[$($srv.Name)] Disconnected." -ForegroundColor Gray
    }
}
