# --- config (fill in locally; do not commit real values) ---
$vraServer = "<vra-server-fqdn>"
$module    = "<module-namespace>"        # the .returns namespace before /getVmApplications
$vmName    = "<vm-name>"
$project   = "<project-name>"
$credPath  = "<path-to-cred-xml>"        # e.g. C:\Scripts\Creds\getCred.xml
$logDump   = "<local-log-path>"          # folder for the raw dump, e.g. C:\Logs

# --- tls ---
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
[System.Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }

# --- auth ---
$cred = Import-Clixml -Path $credPath
$authToken = (Invoke-RestMethod -Uri "https://$vraServer/csp/gateway/am/api/login" -Method Post -ContentType "application/json" -Body (@{ username = $cred.UserName; password = $cred.GetNetworkCredential().Password } | ConvertTo-Json)).cspAuthToken

$getH  = @{ Authorization = "Bearer $authToken"; Accept = "application/json" }
$postH = @{ Authorization = "Bearer $authToken"; "Content-Type" = "application/json"; Accept = "application/json" }

# --- run the action ---
$body = @{ parameters = @(
    @{ name = 'vmName';      type = 'string'; value = @{ string = @{ value = $vmName } } },
    @{ name = 'projectName'; type = 'string'; value = @{ string = @{ value = $project } } }
) } | ConvertTo-Json -Depth 6

$run = Invoke-RestMethod -Uri "https://$vraServer/vco/api/actions/$module/getVmApplications/executions" -Method Post -Headers $postH -Body $body
$id  = $run.'execution-id'; if (-not $id) { $id = $run.id }
"execId: $id"

Start-Sleep -Seconds 3

# --- fetch the run log with the full condition set the GUI uses ---
# type=both is the key param; build the query so all conditions survive.
$conds  = @("conditions=severity=info","conditions=locallyOnly=false","conditions=type=both") -join "&"
$logUri = "https://$vraServer/vco/api/actions/$id/logs?$conds&maxResult=100000"
"URL: $logUri"     # confirm this still contains type=both and all conditions

$logResp = Invoke-RestMethod -Uri $logUri -Headers $getH -Method Get

# --- raw inspection: dump full response + list severity per record ---
if (-not (Test-Path $logDump)) { New-Item -ItemType Directory -Path $logDump -Force | Out-Null }
$logResp | ConvertTo-Json -Depth 20 | Set-Content (Join-Path $logDump "action-log-raw.json")

"logs count: " + @($logResp.logs).Count
"severities: " + (@($logResp.logs | ForEach-Object { $_.severity }) -join ", ")

# --- does the log contain the upstream block? ---
$json = $logResp | ConvertTo-Json -Depth 40
"has upstream block: " + [bool]($json -match 'retrieveCIRelationshipInfoByKey')
"has upstreamCIs:     " + [bool]($json -match 'upstreamCIs')

# --- show per-record summary; dump full JSON if the block is present ---
$logResp.logs | Select-Object severity, origin, 'short-description' | Format-List

if ($json -match 'retrieveCIRelationshipInfoByKey') {
    "----- MATCH: full log JSON written to action-log-raw.json -----"
}
