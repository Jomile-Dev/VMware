$r = Invoke-RestMethod -Uri "https://$vraServer/vco/api/actions/$execId/logs?maxResult=10000" -Headers @{ Authorization = "Bearer $authToken"; Accept = "application/json" } -Method Get
"logs count: " + @($r.logs).Count
$r | ConvertTo-Json -Depth 8

$vraServer = "<your-vra-server>"
$module    = "<module>"          # the part before /getVmApplications
$vmName    = "<a-real-vm-name>"
$project   = "<its-project-name>"

[Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }
$cred = Get-Credential
$authToken = (Invoke-RestMethod -Uri "https://$vraServer/csp/gateway/am/api/login" -Method Post -ContentType "application/json" -Body (@{ username=$cred.UserName; password=$cred.GetNetworkCredential().Password } | ConvertTo-Json)).cspAuthToken
$h = @{ Authorization = "Bearer $authToken"; Accept = "application/json" }

$run = Invoke-RestMethod -Uri "https://$vraServer/vco/api/actions/$module/getVmApplications/executions" -Method Post -Headers $h -Body (@{ parameters=@(@{name='vmName';type='string';value=@{string=@{value=$vmName}}},@{name='projectName';type='string';value=@{string=@{value=$project}}}) } | ConvertTo-Json -Depth 6)
$id = $run.'execution-id'; if (-not $id) { $id = $run.id }
Start-Sleep 3

$r = Invoke-RestMethod -Uri "https://$vraServer/vco/api/actions/$id/logs?maxResult=10000" -Headers $h -Method Get
"execId: $id"
"logs count: " + @($r.logs).Count
$r | ConvertTo-Json -Depth 8
