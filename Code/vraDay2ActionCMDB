$authToken = $authResponse.cspAuthToken
Write-Log "Authentication successful!" -Color Green

# Normalise application name for comparison
function Normalize-AppName {
    param($Name)
    if (-not $Name) { return "" }
    return ($Name.ToLower().Trim() -replace '[_\s\-\.]+', '')
}

# ---------------------------------------------------------------------------
# vRO Action REST API helper
# Runs a vRO action synchronously and returns its output normalised:
#   - string return  -> [string]
#   - array return   -> [string[]]
#   - anything else  -> raw .value object
# CONFIRM this against your environment: endpoint path, auth scheme, and the
# request/response envelope. Swap in your own helper if it differs.
# ---------------------------------------------------------------------------
function Invoke-VroActionRest {
    param(
        [string]$VraServer,
        [string]$AuthToken,
        [string]$ActionUri,      # "module/actionName"
        [hashtable]$Parameters,
        [switch]$Raw,
        [int]$TimeoutSec = $(if ($VroTimeoutSec) { $VroTimeoutSec } else { 30 })
    )

    $lastSlash  = $ActionUri.LastIndexOf('/')
    $module     = $ActionUri.Substring(0, $lastSlash)
    $actionName = $ActionUri.Substring($lastSlash + 1)

    $paramList = foreach ($k in $Parameters.Keys) {
        $val = $Parameters[$k]
        if ($val -is [bool]) {
            @{ name = $k; type = "boolean"; value = @{ boolean = @{ value = $val } } }
        }
        else {
            @{ name = $k; type = "string"; value = @{ string = @{ value = [string]$val } } }
        }
    }

    $body = @{ parameters = @($paramList) } | ConvertTo-Json -Depth 6
    $uri  = "https://$VraServer/vco/api/actions/$module/$actionName/executions"
    $headers = @{
        "Authorization" = "Bearer $AuthToken"
        "Content-Type"  = "application/json"
        "Accept"        = "application/json"
    }

    $resp = Invoke-RestMethod -Uri $uri -Method Post -Headers $headers -Body $body -TimeoutSec $TimeoutSec
    if ($Raw) { return $resp }
    $v = $resp.value
    if ($null -ne $v.string) { return $v.string.value }
    elseif ($null -ne $v.array) { return @($v.array.elements | ForEach-Object { $_.string.value }) }
    else { return $v }
}

# Parse the flat getCagApplications string array into App / Sub-App buckets.
# Shape: ["--- Applications ---","app01","app02","--- Sub-Applications ---","sub01",...]
function Get-CagCatalog {
    param($RawArray)
    $apps    = [System.Collections.Generic.List[string]]::new()
    $subApps = [System.Collections.Generic.List[string]]::new()
    $bucket  = $null
    foreach ($line in @($RawArray)) {
        $t = ("" + $line).Trim()
        if (-not $t) { continue }
        if     ($t -match '^-+\s*Applications\s*-+$')      { $bucket = 'app'; continue }
        elseif ($t -match '^-+\s*Sub-?Applications\s*-+$') { $bucket = 'sub'; continue }
        if     ($bucket -eq 'app') { $apps.Add($t) }
        elseif ($bucket -eq 'sub') { $subApps.Add($t) }
    }
    return [PSCustomObject]@{ Apps = $apps; SubApps = $subApps }
}

# Per-project cache so getCagApplications is called once per project, not per VM
$cagCache = @{}
function Get-CagForProject {
    param($ProjectName, $VraServer, $AuthToken, $CagUri, $PhasedOut)
    if (-not $ProjectName) { return [PSCustomObject]@{ Apps = @(); SubApps = @() } }
    if ($cagCache.ContainsKey($ProjectName)) { return $cagCache[$ProjectName] }
    try {
        $raw = Invoke-VroActionRest -VraServer $VraServer -AuthToken $AuthToken -ActionUri $CagUri -Parameters @{
            projectName      = $ProjectName
            phasedOutEnabled = $PhasedOut
        }
        $cat = Get-CagCatalog -RawArray $raw
    }
    catch {
        $cat = [PSCustomObject]@{ Apps = @(); SubApps = @() }
    }
    $cagCache[$ProjectName] = $cat
    return $cat
}

# Defensively pull an array of objects out of a vRO action REST response.
# Handles a native array in .value.array.elements (either .properties key/value
# pairs or a JSON string per element), a single JSON-string return, or an
# already-native array/object. Confirm the actual envelope against your logs.
function Get-VroObjectArray {
    param($Response)
    if ($null -eq $Response) { return @() }

    $v = $Response.value
    if ($v -and $v.array -and $v.array.elements) {
        $out = foreach ($el in $v.array.elements) {
            if ($el.properties) {
                $o = @{}
                foreach ($p in $el.properties) { $o[$p.key] = $p.value.string.value }
                [PSCustomObject]$o
            }
            elseif ($el.string -and $el.string.value) {
                try { $el.string.value | ConvertFrom-Json -ErrorAction Stop } catch { $el.string.value }
            }
            else { $el }
        }
        return @($out)
    }
    if ($v -and $v.string -and $v.string.value) {
        try { return @($v.string.value | ConvertFrom-Json -ErrorAction Stop) } catch { return @() }
    }
    if ($Response -is [string]) {
        try { return @($Response | ConvertFrom-Json -ErrorAction Stop) } catch { return @() }
    }
    return @($Response)
}

# First non-empty value across a set of candidate field names
function Get-FirstFieldValue {
    param($Object, [string[]]$Fields)
    foreach ($f in $Fields) {
        $val = $Object.$f
        if ($val) { return [string]$val }
    }
    return ""
}

# Unwrap a returnApplicationVms REST response to a JSON object.
# The action returns a JSON string (vRO envelope at value.string.value); ConvertFrom-Json it.
function Get-VroJson {
    param($Response)
    if ($null -eq $Response) { return $null }
    $s = $null
    if ($Response.value -and $Response.value.string) { $s = $Response.value.string.value }
    elseif ($Response -is [string]) { $s = $Response }
    if ($s) { try { return ($s | ConvertFrom-Json -ErrorAction Stop) } catch { return $null } }
    # Array return: scan each string element for one that parses as JSON
    if ($Response.value -and $Response.value.array -and $Response.value.array.elements) {
        foreach ($el in $Response.value.array.elements) {
            $ev = $el.string.value
            if ($ev -and ($ev.TrimStart().StartsWith('{'))) {
                try { return ($ev | ConvertFrom-Json -ErrorAction Stop) } catch { }
            }
        }
        return $null
    }
    return $Response
}

# Pull the upstreamCIs array out of a parsed returnApplicationVms object,
# handling retrieveCiInfoByKey.Information[] nesting or a flatter shape.
function Get-UpstreamCIs {
    param($Obj)
    if ($null -eq $Obj) { return @() }
    $ups = @()
    if ($Obj.retrieveCiInfoByKey.Information) {
        foreach ($info in @($Obj.retrieveCiInfoByKey.Information)) { $ups += @($info.upstreamCIs) }
    }
    elseif ($Obj.Information) {
        foreach ($info in @($Obj.Information)) { $ups += @($info.upstreamCIs) }
    }
    elseif ($Obj.retrieveCIRelationshipInfoByKey.upstreamCIs) {
        $ups += @($Obj.retrieveCIRelationshipInfoByKey.upstreamCIs)
    }
    elseif ($Obj.upstreamCIs) {
        $ups += @($Obj.upstreamCIs)
    }
    return @($ups | Where-Object { $_ })
}

# CI-level Status values from retrieveCiInfoByKey.Information[] - this is where
# a disposed/retired sub-app shows even when there is no upstream relationship.
function Get-CiStatuses {
    param($Obj)
    if ($null -eq $Obj) { return @() }
    $infos = @()
    if     ($Obj.retrieveCiInfoByKey.Information) { $infos = @($Obj.retrieveCiInfoByKey.Information) }
    elseif ($Obj.Information)                     { $infos = @($Obj.Information) }
    return @($infos | ForEach-Object { $_.Status } | Where-Object { $_ })
}

# Extract the JSON object surrounding a marker string from log text.
# Brace-matching - fragile if values contain literal braces.
function Get-JsonBlockFromText {
    param($Text, $Marker)
    if (-not $Text) { return $null }
    $idx = $Text.IndexOf($Marker)
    if ($idx -lt 0) { return $null }
    $start = $Text.LastIndexOf('{', $idx)
    if ($start -lt 0) { return $null }
    $depth = 0; $end = -1
    for ($i = $start; $i -lt $Text.Length; $i++) {
        $c = $Text[$i]
        if     ($c -eq '{') { $depth++ }
        elseif ($c -eq '}') { $depth--; if ($depth -eq 0) { $end = $i; break } }
    }
    if ($end -lt 0) { return $null }
    $json = $Text.Substring($start, $end - $start + 1)
    try { return ($json | ConvertFrom-Json -ErrorAction Stop) } catch { return $null }
}

# From log text: upstreamCIs out of the retrieveCIRelationshipInfoByKey block.
function Get-UpstreamCIsFromLog {
    param($LogText)
    $obj = Get-JsonBlockFromText -Text $LogText -Marker '"retrieveCIRelationshipInfoByKey"'
    if (-not $obj) { $obj = Get-JsonBlockFromText -Text $LogText -Marker '"upstreamCIs"' }
    if (-not $obj) { return @() }
    return @(Get-UpstreamCIs -Obj $obj)
}

# From log text: CI Status values out of the retrieveCiInfoByKey block.
function Get-CiStatusesFromLog {
    param($LogText)
    $obj = Get-JsonBlockFromText -Text $LogText -Marker '"retrieveCiInfoByKey"'
    if (-not $obj) { return @() }
    return @(Get-CiStatuses -Obj $obj)
}

# Run a WORKFLOW via REST and fetch that run's logs. On vRO/Aria 8.x a workflow
# execution exposes its log at /executions/{execId}/syslogs (and /logs), where the
# wrapped action's System.log output - including retrieveCIRelationshipInfoByKey -
# appears. Poll state until the run leaves "running", then read the log.
# Returns the same shape as Invoke-VroActionWithLogs: Value/LogText/LogEndpoint/ExecId.
function Invoke-VroWorkflowWithLogs {
    param(
        $VraServer, $AuthToken, $WorkflowId, [hashtable]$Parameters,
        [int]$WaitSec = 60, [int]$TimeoutSec = 60
    )

    $headers = @{
        "Authorization" = "Bearer $AuthToken"
        "Content-Type"  = "application/json"
        "Accept"        = "application/json"
    }

    # Workflow execution body: parameters use the same typed envelope as actions.
    $paramList = foreach ($k in $Parameters.Keys) {
        $val = $Parameters[$k]
        if ($val -is [bool]) { @{ name = $k; type = "boolean"; value = @{ boolean = @{ value = $val } } } }
        else                 { @{ name = $k; type = "string";  value = @{ string  = @{ value = [string]$val } } } }
    }
    $body = @{ parameters = @($paramList) } | ConvertTo-Json -Depth 6

    $base   = "https://$VraServer/vco/api/workflows/$WorkflowId"
    $execId = $null

    try {
        $resp = Invoke-WebRequest -Uri "$base/executions" -Method Post -Headers $headers -Body $body -TimeoutSec $TimeoutSec -UseBasicParsing
        if ($resp.Headers.Location) { $execId = ([string]$resp.Headers.Location).TrimEnd('/').Split('/')[-1] }
        if (-not $execId -and $resp.Content) {
            try { $p = $resp.Content | ConvertFrom-Json; if ($p.id) { $execId = $p.id } } catch { }
        }
    }
    catch {
        return [PSCustomObject]@{ Value = $null; LogText = ""; LogEndpoint = "wf-run-failed: $($_.Exception.Message)"; ExecId = $null }
    }

    if (-not $execId) {
        return [PSCustomObject]@{ Value = $null; LogText = ""; LogEndpoint = "wf-no-execId"; ExecId = $null }
    }

    # Poll state until it leaves "running" (or we hit the wait cap)
    $waited = 0
    do {
        Start-Sleep -Milliseconds 1000
        $waited++
        $state = "unknown"
        try {
            $st = Invoke-RestMethod -Uri "$base/executions/$execId/state" -Method Get -Headers $headers -TimeoutSec 30
            if ($st.value) { $state = [string]$st.value } elseif ($st.'state') { $state = [string]$st.'state' }
        } catch { }
    } while ($state -eq "running" -and $waited -lt $WaitSec)

    # Read the run log (syslogs carries the detailed System.log lines; /logs is the fallback)
    $logText = ""; $usedEndpoint = "none"
    $candidates = @(
        "$base/executions/$execId/syslogs?maxResult=10000",
        "$base/executions/$execId/logs?maxResult=10000"
    )
    foreach ($cand in $candidates) {
        try {
            $logResp = Invoke-RestMethod -Uri $cand -Method Get -Headers $headers -TimeoutSec 30
            $lines = @()
            foreach ($e in @($logResp.logs)) {
                $m = $null
                if     ($e.entry.'long-message')  { $m = $e.entry.'long-message' }
                elseif ($e.entry.'short-message') { $m = $e.entry.'short-message' }
                elseif ($e.message)               { $m = $e.message }
                if ($m) { $lines += $m }
            }
            if (-not $lines -and $logResp -is [string]) { $lines = @($logResp) }
            if ($lines) { $logText = ($lines -join "`n"); $usedEndpoint = $cand; break }
        }
        catch { continue }
    }

    return [PSCustomObject]@{ Value = $null; LogText = $logText; LogEndpoint = $usedEndpoint; ExecId = $execId }
}

# Run an action (same module/name URI as everywhere else) and fetch that run's
# logs - the same data the GUI Logs tab shows. Also returns the action's value.
function Invoke-VroActionWithLogs {
    param($VraServer, $AuthToken, $ActionUri, [hashtable]$Parameters, [int]$TimeoutSec = 60)

    $lastSlash  = $ActionUri.LastIndexOf('/')
    $module     = $ActionUri.Substring(0, $lastSlash)
    $actionName = $ActionUri.Substring($lastSlash + 1)

    $headers = @{
        "Authorization" = "Bearer $AuthToken"
        "Content-Type"  = "application/json"
        "Accept"        = "application/json"
    }
    $paramList = foreach ($k in $Parameters.Keys) {
        $val = $Parameters[$k]
        if ($val -is [bool]) { @{ name = $k; type = "boolean"; value = @{ boolean = @{ value = $val } } } }
        else { @{ name = $k; type = "string"; value = @{ string = @{ value = [string]$val } } } }
    }
    $body = @{ parameters = @($paramList) } | ConvertTo-Json -Depth 6

    $base   = "https://$VraServer/vco/api/actions/$module/$actionName"
    $execId = $null; $value = $null
    try {
        $resp = Invoke-WebRequest -Uri "$base/executions" -Method Post -Headers $headers -Body $body -TimeoutSec $TimeoutSec -UseBasicParsing
        if ($resp.Headers.Location) { $execId = ([string]$resp.Headers.Location).TrimEnd('/').Split('/')[-1] }
        if ($resp.Content) {
            try {
                $parsed = $resp.Content | ConvertFrom-Json
                $value = $parsed
                if (-not $execId -and $parsed.id) { $execId = $parsed.id }
                if (-not $execId -and $parsed.'execution-id') { $execId = $parsed.'execution-id' }
            } catch { }
        }
    }
    catch { return [PSCustomObject]@{ Value = $null; LogText = ""; LogEndpoint = "run-failed: $($_.Exception.Message)"; ExecId = $null } }

    $logText = ""; $usedEndpoint = "none"
    if ($execId) {
        $candidates = @(
            "$base/executions/$execId/syslogs?maxResult=10000",
            "$base/executions/$execId/logs?maxResult=10000"
        )
        foreach ($cand in $candidates) {
            try {
                $logResp = Invoke-RestMethod -Uri $cand -Method Get -Headers $headers -TimeoutSec 30
                $lines = @()
                foreach ($e in @($logResp.logs)) {
                    $m = $null
                    if     ($e.entry.'long-message')  { $m = $e.entry.'long-message' }
                    elseif ($e.entry.'short-message') { $m = $e.entry.'short-message' }
                    elseif ($e.message)               { $m = $e.message }
                    if ($m) { $lines += $m }
                }
                if (-not $lines -and $logResp -is [string]) { $lines = @($logResp) }
                if ($lines) { $logText = ($lines -join "`n"); $usedEndpoint = $cand; break }
            }
            catch { continue }
        }
    }

    return [PSCustomObject]@{ Value = $value; LogText = $logText; LogEndpoint = $usedEndpoint; ExecId = $execId }
}

# Build the six review fields for one VM result object
function Invoke-CmdbReview {
    param(
        $Vm, $Catalog, $VraServer, $AuthToken, $GetVmAppsUri, $ReturnAppVmsUri,
        $PhasedOut, $ClassFields, $DebugPath,
        $UseWorkflowLogs, $WorkflowId, $WfInputVmName, $WfInputProjectName, $WorkflowWaitSec
    )

    $nsxMatch = switch ($Vm.CompareResult) {
        "Match"                 { "NSX tag matches CMDB" }
        "Match - Multiple Tags" { "NSX tag matches CMDB (multiple tags)" }
        "Mismatch"              { "No match - review segment or tag" }
        "Missing Data"          { "Missing data - review" }
        default                 { [string]$Vm.CompareResult }
    }

    $tags = if ($Vm.AppApplication) { $Vm.AppApplication -split ";\s*" } else { @() }

    # --- App vs Sub-App per tag (from getCagApplications catalogue) ---
    $appOrSub = @()
    foreach ($tag in $tags) {
        $normTag = ($tag.ToLower().Trim() -replace '[_\s\-\.]+', '')
        $isApp = $Catalog.Apps    | Where-Object { (($_.ToLower().Trim()) -replace '[_\s\-\.]+', '') -eq $normTag }
        $isSub = $Catalog.SubApps | Where-Object { (($_.ToLower().Trim()) -replace '[_\s\-\.]+', '') -eq $normTag }
        if     ($isApp) { $appOrSub += "${tag}: Application - convert to sub-app" }
        elseif ($isSub) { $appOrSub += "${tag}: Sub-Application" }
        else            { $appOrSub += "${tag}: Not found in CAG" }
    }
    if ($appOrSub.Count -eq 0) { $appOrSub = @("No tag") }

    # --- Upstream relationship from getVmApplications LOGS ---
    # The upstream data (retrieveCIRelationshipInfoByKey.upstreamCIs) is written to
    # the getVmApplications run's LOG output, not its return value. On vRO 8.18.1 an
    # ACTION execution does not expose its log over REST, so the reliable path is to
    # run a thin WORKFLOW that wraps getVmApplications and read the WORKFLOW run log.
    # Keyed on vmName + projectName (one call per VM). Falls back to the action-log
    # path when $UseWorkflowLogs is off.
    $upstreamCIs = @()
    $ciStatuses  = @()
    $returnRaws  = @()
    try {
        if ($UseWorkflowLogs -and $WorkflowId -and $WorkflowId -notmatch '^<') {
            # Run the wrapper workflow and read its run log
            $wfInputs = @{}
            $wfInputs[$WfInputVmName]      = $Vm.VMName
            $wfInputs[$WfInputProjectName] = $Vm.ProjectName
            $runRes = Invoke-VroWorkflowWithLogs -VraServer $VraServer -AuthToken $AuthToken -WorkflowId $WorkflowId -Parameters $wfInputs -WaitSec $WorkflowWaitSec
            $runMode = "workflow"
        }
        else {
            # Fallback: action execution (log not retrievable via REST on 8.18.1)
            $runRes = Invoke-VroActionWithLogs -VraServer $VraServer -AuthToken $AuthToken -ActionUri $GetVmAppsUri -Parameters @{
                vmName      = $Vm.VMName
                projectName = $Vm.ProjectName
            }
            $runMode = "action"
        }
        $returnRaws += [ordered]@{ vmName = $Vm.VMName; runMode = $runMode; execId = $runRes.ExecId; logEndpoint = $runRes.LogEndpoint; logChars = @($runRes.LogText).Length; log = $runRes.LogText; value = $runRes.Value }
        # Upstream CIs: from the log's retrieveCIRelationshipInfoByKey block
        # (falls back to the return value if it ever carries the JSON)
        $upstreamCIs += @(Get-UpstreamCIsFromLog -LogText $runRes.LogText)
        $obj = Get-VroJson -Response $runRes.Value
        $upstreamCIs += @(Get-UpstreamCIs -Obj $obj)
        # CI Status (disposed/retired) : from retrieveCiInfoByKey.Information[]
        # in the return AND the log - covers decomm even with no upstream
        $ciStatuses += @(Get-CiStatuses -Obj $obj)
        $ciStatuses += @(Get-CiStatusesFromLog -LogText $runRes.LogText)
    }
    catch { }
    $upstreamCIs = @($upstreamCIs | Where-Object { $_ })
    $ciStatuses  = @($ciStatuses  | Where-Object { $_ })

    $upstreamToApp = "N/A"; $multiUpstream = "No multiple upstream"; $noUpstream = "N/A"; $decomm = "N/A"

    if ($upstreamCIs.Count -gt 0) {
        $classes = @($upstreamCIs | ForEach-Object { Get-FirstFieldValue -Object $_ -Fields $ClassFields })
        if ($classes -contains "Application") {
            $upstreamToApp = "Upstream to Application"
        }
        elseif ($classes -contains "SubApplication") {
            $upstreamToApp = "Upstream is Sub-Application - review upstream relationship"
        }
        else {
            $upstreamToApp = "Upstream class unknown ($($classes -join ',')) - review"
        }

        if ($upstreamCIs.Count -gt 1) {
            $multiUpstream = "Multiple upstreams ($($upstreamCIs.Count)) - review"
        }
    }
    elseif ($tags.Count -eq 0) {
        $noUpstream = "No CMDB relationship - add"
    }
    else {
        $noUpstream = "No upstream - review/fix upstream relationship"
    }

    # Decommissioned: upstream CI statuses AND the CI's own Status - so a
    # disposed sub-app with no upstream relationship still gets flagged
    $allStatuses = @($upstreamCIs | ForEach-Object { $_.UpstreamCIStatus }) + $ciStatuses
    $decommed = @($allStatuses | Where-Object { $_ -match 'dispos|retire|decommission' } | Select-Object -Unique)
    if ($decommed.Count -gt 0) {
        $decomm = "App/Sub-App decommissioned ($($decommed -join '; ')) - review"
    }

    # --- Debug dump: raw + parsed data per VM for troubleshooting ---
    if ($DebugPath) {
        $dbg = [ordered]@{
            VMName           = $Vm.VMName
            ProjectName      = $Vm.ProjectName
            Tags             = $tags
            CagApps          = @($Catalog.Apps).Count
            CagSubApps       = @($Catalog.SubApps).Count
            UpstreamCount    = $upstreamCIs.Count
            UpstreamCIs      = @($upstreamCIs | ForEach-Object {
                @($_.PSObject.Properties | ForEach-Object { "$($_.Name) = $($_.Value)" })
            })
            ClassFieldsRead  = @($upstreamCIs | ForEach-Object { Get-FirstFieldValue -Object $_ -Fields $ClassFields })
            UpstreamStatuses = @($upstreamCIs | ForEach-Object { $_.UpstreamCIStatus })
            CiStatuses       = $ciStatuses
            RawReturnAppVms  = $returnRaws
        }
        "==================== $($Vm.VMName) ====================" | Add-Content -Path $DebugPath -Encoding UTF8
        ($dbg | ConvertTo-Json -Depth 12) | Add-Content -Path $DebugPath -Encoding UTF8
    }

    return [PSCustomObject]@{
        NSXMatchCMDB           = $nsxMatch
        AppOrSubApp            = ($appOrSub -join "; ")
        UpstreamToApp          = $upstreamToApp
        MultipleUpstream       = $multiUpstream
        NoUpstreamRelationship = $noUpstream
        Decommissioned         = $decomm
    }
}

if ($ReplayFromCsv) {
    Write-Log "`n=== REPLAY MODE: loading $ReplayCsvPath ===" -Color Cyan
    if (-not (Test-Path -LiteralPath $ReplayCsvPath)) {
        Write-Log "Replay CSV not found: $ReplayCsvPath" -Color Red
        return
    }
    $results = [System.Collections.Generic.List[object]]::new()
    Import-Csv -LiteralPath $ReplayCsvPath | ForEach-Object { $results.Add($_) }
    $vmQueue      = @($results)
    $successCount = @($results).Count
    $failCount    = 0
    $stopwatch    = [System.Diagnostics.Stopwatch]::StartNew()
    Write-Log "Loaded $($results.Count) rows from replay CSV" -Color Green
}
else {

# Fetch all deployments with resources in one pass (size=1000, same as working export script)
Write-Log "`n=== FETCHING DEPLOYMENTS ===" -Color Cyan
$headers = @{
    "Authorization" = "Bearer $authToken"
    "Content-Type" = "application/json"
}

# Build projectId -> projectName map. The deployment API frequently returns
# projectId but a blank projectName, and the vRO actions need projectName.
# Endpoint may differ in your environment - wrapped so a miss can't break the run.
$projectMap = @{}
try {
    $projResp = Invoke-RestMethod -Uri "https://$vraServer/iaas/api/projects?`$top=1000" -Method Get -Headers $headers -TimeoutSec 60
    foreach ($p in @($projResp.content)) { $projectMap[$p.id] = $p.name }
    Write-Log "Loaded $($projectMap.Count) projects for id->name resolution" -Color Green
}
catch {
    Write-Log "Could not load project map: $($_.Exception.Message)" -Color Yellow
}

$vmQueue = [System.Collections.Generic.List[hashtable]]::new()
$seenVMs = [System.Collections.Generic.HashSet[string]]::new()
$page = 0
$size = 200          # smaller pages: expand=resources at size=1000 can drop the connection
$totalProcessed = 0
$deploymentsWithVMs = 0
$skippedCount = 0
$maxRetries = 3

do {
    $uri = "https://$vraServer/deployment/api/deployments?page=$page&size=$size&expand=resources"
    Write-Log " Page $($page + 1)..." -Color Gray

    $response = $null
    for ($attempt = 1; $attempt -le $maxRetries; $attempt++) {
        try {
            $response = Invoke-RestMethod -Uri $uri -Method Get -Headers $headers -TimeoutSec 120
            break
        }
        catch {
            Write-Log "  Page $($page + 1) attempt $attempt failed: $($_.Exception.Message)" -Color Yellow
            if ($attempt -lt $maxRetries) { Start-Sleep -Seconds ($attempt * 3) }
            else { Write-Log "  Giving up on page $($page + 1) after $maxRetries attempts - stopping fetch" -Color Red }
        }
    }
    if (-not $response) { break }   # don't reprocess a stale $response from a prior page

    $deployments = if ($response.content) { $response.content } else { $response }

    $capReached = $false
    foreach ($dep in $deployments) {
        # Skip deleted/failed deployments
        if ($dep.status -and $dep.status -in @("DELETE_SUCCESSFUL", "FAILED", "DELETE_INPROGRESS")) {
            $skippedCount++
            continue
        }

        $machines = @($dep.resources | Where-Object { $_.type -eq "Cloud.vSphere.Machine" })
        if ($machines.Count -eq 0) { continue }

        $addedForThisDep = 0
        foreach ($machine in $machines) {
            # Skip failed or missing VMs
            if ($machine.state -and $machine.state -notin @("OK", "STARTED", "")) { continue }

            $vmName = if ($machine.properties.resourceName) { $machine.properties.resourceName }
                      elseif ($machine.properties.hostname) { $machine.properties.hostname }
                      else { $machine.name }

            # Dedupe: a retried or re-run page can't add the same VM twice
            if (-not $seenVMs.Add("$($dep.name)|$vmName")) { continue }

            $projName = if ($dep.projectName) { $dep.projectName }
                        elseif ($dep.projectId -and $projectMap.ContainsKey($dep.projectId)) { $projectMap[$dep.projectId] }
                        else { "" }

            $vmQueue.Add(@{
                DeploymentName = $dep.name
                VMName = $vmName
                ProjectId = $dep.projectId
                ProjectName = $projName
            })
            $addedForThisDep++
        }

        # Cap counts only deployments that actually contributed VMs
        if ($addedForThisDep -gt 0) {
            $deploymentsWithVMs++
            if ($MaxDeployments -gt 0 -and $deploymentsWithVMs -ge $MaxDeployments) {
                $capReached = $true
                break
            }
        }
    }

    $totalProcessed += $deployments.Count
    $page++
    if ($capReached) {
        Write-Log " Reached $MaxDeployments deployments with VMs - stopping fetch" -Color Yellow
        break
    }
    $hasMore = if ($response.totalPages) {
        $page -lt $response.totalPages
    } elseif ($response.totalElements) {
        $totalProcessed -lt $response.totalElements
    } else {
        $deployments.Count -eq $size
    }
} while ($hasMore)

Write-Log "Scanned: $totalProcessed deployments ($deploymentsWithVMs with VMs, skipped $skippedCount deleted/failed)" -Color Cyan
Write-Log "VMs to process: $($vmQueue.Count)" -Color Cyan

# Scriptblock that runs in each runspace
$scriptBlock = {
    param($VraServer, $AuthToken, $ShowVmDetailsUri, $GetVmAppsUri, $VMName, $ProjectId, $ProjectName, $DeploymentName)

    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    [System.Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }

    $headers = @{
        "Authorization" = "Bearer $AuthToken"
        "Content-Type" = "application/json"
    }

    $uri = "https://$VraServer/form-service/api/forms/renderer/external-values?projectId=$ProjectId"

    $bodyArray = @(
        @{
            uri = $ShowVmDetailsUri
            dataSource = "scriptAction"
            parameters = @(
                @{ name = "vmName"; value = $VMName }
            )
            useResultsFromRequestId = -1
            fieldType = @{ dataType = "complex" }
            fields = @(
                @{ label = "Scope"; type = @{ dataType = "string" }; id = "scope" },
                @{ label = "Tag"; type = @{ dataType = "string" }; id = "tag" }
            )
            isMultiple = $true
            requestId = 1
        },
        @{
            uri = $GetVmAppsUri
            dataSource = "scriptAction"
            parameters = @(
                @{ name = "vmName"; value = $VMName },
                @{ name = "projectName"; value = $ProjectName }
            )
            useResultsFromRequestId = -1
            fieldType = @{ dataType = "string" }
            isMultiple = $true
            requestId = 2
        }
    )

    $body = "[" + (($bodyArray | ForEach-Object { $_ | ConvertTo-Json -Depth 5 -Compress }) -join ",") + "]"

    try {
        $response = Invoke-RestMethod -Uri $uri -Method Post -Headers $headers -Body $body

        $appApplications = [System.Collections.ArrayList]::new()
        $infraOs = ""
        $appLayer = ""
        $vmApplications = ""

        foreach ($result in $response) {
            switch ($result.requestId) {
                1 {
                    if ($result.data -is [array]) {
                        foreach ($item in $result.data) {
                            if ($item.scope -and $item.tag) {
                                if ($item.scope -eq "app-application") {
                                    [void]$appApplications.Add($item.tag)
                                }
                                elseif ($item.scope -eq "infra-os") {
                                    $infraOs = $item.tag
                                }
                                elseif ($item.scope -eq "app-layer") {
                                    $appLayer = $item.tag
                                }
                            }
                        }
                    }
                }
                2 {
                    if ($result.data -is [array]) {
                        $vmApplications = ($result.data | Where-Object { $_ -and $_ -notmatch "^---" }) -join "; "
                    }
                }
            }
        }

        $appApplication = ($appApplications | Select-Object -Unique) -join "; "

        # Compare each tag against each CMDB CI entry
        $match = "Missing Data"
        $matchedApps = @()
        if ($appApplications.Count -gt 0 -and $vmApplications) {
            $ciList = $vmApplications -split ";\s*"
            foreach ($tag in $appApplications) {
                $normTag = ($tag.ToLower().Trim() -replace '[_\s\-\.]+', '')
                foreach ($ci in $ciList) {
                    $normCI = ($ci.ToLower().Trim() -replace '[_\s\-\.]+', '')
                    if ($normTag -and $normCI -and $normTag -eq $normCI) {
                        $matchedApps += $tag
                        break
                    }
                }
            }
            if ($matchedApps.Count -gt 0) {
                if ($appApplications.Count -gt 1) {
                    $match = "Match - Multiple Tags"
                } else {
                    $match = "Match"
                }
            } else {
                $match = "Mismatch"
            }
        }

        $matchedAppsStr = ($matchedApps | Select-Object -Unique) -join "; "

        return [PSCustomObject]@{
            DeploymentName = $DeploymentName
            VMName = $VMName
            ProjectName = $ProjectName
            ProjectId = $ProjectId
            AppApplication = $appApplication
            InfraOS = $infraOs
            AppLayer = $appLayer
            CMDBCI = $vmApplications
            CompareResult = $match
            Status = "Success"
        }
    }
    catch {
        return [PSCustomObject]@{
            DeploymentName = $DeploymentName
            VMName = $VMName
            ProjectName = $ProjectName
            ProjectId = $ProjectId
            AppApplication = ""
            InfraOS = ""
            AppLayer = ""
            CMDBCI = ""
            CompareResult = ""
            Status = "Failed: $($_.Exception.Message)"
        }
    }
}

# Process with single runspace pool and timeout per job
$poolSize = 30
$jobTimeoutSeconds = 120
Write-Log "`n=== PROCESSING $($vmQueue.Count) VMs ($poolSize parallel threads, ${jobTimeoutSeconds}s timeout) ===" -Color Cyan
$stopwatch = [System.Diagnostics.Stopwatch]::StartNew()

$runspacePool = [System.Management.Automation.Runspaces.RunspaceFactory]::CreateRunspacePool(1, $poolSize)
$runspacePool.Open()

$results = [System.Collections.Generic.List[object]]::new()
$jobs = [System.Collections.Generic.List[object]]::new()
$completed = 0
$successCount = 0
$failCount = 0

# Queue all jobs
foreach ($vm in $vmQueue) {
    $ps = [PowerShell]::Create().AddScript($scriptBlock)
    $ps.AddArgument($vraServer) | Out-Null
    $ps.AddArgument($authToken) | Out-Null
    $ps.AddArgument($showVmDetailsUri) | Out-Null
    $ps.AddArgument($getVmAppsUri) | Out-Null
    $ps.AddArgument($vm.VMName) | Out-Null
    $ps.AddArgument($vm.ProjectId) | Out-Null
    $ps.AddArgument($vm.ProjectName) | Out-Null
    $ps.AddArgument($vm.DeploymentName) | Out-Null
    $ps.RunspacePool = $runspacePool

    $jobs.Add(@{
        PowerShell = $ps
        Handle = $ps.BeginInvoke()
        VMName = $vm.VMName
    })
}

# Collect results with timeout
foreach ($job in $jobs) {
    $completed++
    if ($job.Handle.AsyncWaitHandle.WaitOne($jobTimeoutSeconds * 1000)) {
        $result = $job.PowerShell.EndInvoke($job.Handle)
        if ($result) {
            foreach ($r in $result) {
                if ($r.Status -eq "Success") {
                    $successCount++
                    $matchColor = switch ($r.CompareResult) {
                        "Match" { "Green" }
                        "Mismatch" { "Red" }
                        default { "Gray" }
                    }
                    # Show what was returned for Missing Data so you can see what's empty
                    if ($r.CompareResult -eq "Missing Data") {
                        $tagVal = if ($r.AppApplication) { $r.AppApplication } else { "(empty)" }
                        $appVal = if ($r.CMDBCI) { $r.CMDBCI } else { "(empty)" }
                        Write-Log "[$completed/$($vmQueue.Count)] $($r.VMName) | Tag: $tagVal | CMDB CI: $appVal | Missing Data" -Color Gray
                    }
                    else {
                        Write-Log "[$completed/$($vmQueue.Count)] $($r.VMName) | $($r.AppApplication) | $($r.CompareResult)" -Color $matchColor
                    }
                }
                else {
                    $failCount++
                    Write-Log "[$completed/$($vmQueue.Count)] $($r.VMName) | FAILED - $($r.Status)" -Color Red
                }

                $results.Add([PSCustomObject]@{
                    DeploymentName = [string]$r.DeploymentName
                    VMName = [string]$r.VMName
                    ProjectName = [string]$r.ProjectName
                    ProjectId = [string]$r.ProjectId
                    AppApplication = [string]$r.AppApplication
                    InfraOS = [string]$r.InfraOS
                    AppLayer = [string]$r.AppLayer
                    CMDBCI = [string]$r.CMDBCI
                    CompareResult = [string]$r.CompareResult
                })
            }
        }
    }
    else {
        $failCount++
        Write-Log "[$completed/$($vmQueue.Count)] $($job.VMName) | TIMEOUT after ${jobTimeoutSeconds}s" -Color Red
        $job.PowerShell.Stop()
    }
    $job.PowerShell.Dispose()
}

if ($runspacePool) { $runspacePool.Close(); $runspacePool.Dispose() }
$stopwatch.Stop()
}

# NSX Fallback - fill in missing AppApplication from NSX VM tags
$missingAppVMs = @($results | Where-Object { -not $_.AppApplication })
if (-not $ReplayFromCsv -and $missingAppVMs.Count -gt 0) {
    Write-Log "`n=== NSX FALLBACK: $($missingAppVMs.Count) VMs with empty AppApplication ===" -Color Cyan

    # NSX Auth functions (from working NSX firewall script)
    function Connect-NSXManagerFallback {
        param(
            [string]$Server,
            [PSCredential]$Credential,
            [string]$AuthMode = "Local",
            [string]$VIDMDomain = ""
        )

        $headers = @{
            "Content-Type" = "application/json"
            "Accept" = "application/json"
        }

        if ($AuthMode -eq "Local") {
            $pair = "{0}:{1}" -f $Credential.UserName, $Credential.GetNetworkCredential().Password
            $bytes = [System.Text.Encoding]::ASCII.GetBytes($pair)
            $base64 = [System.Convert]::ToBase64String($bytes)
            $headers["Authorization"] = "Basic $base64"
            Write-Log " NSX authenticating (Local/Basic)..." -Color Cyan
        }
        else {
            Write-Log " NSX authenticating via vIDM session..." -Color Cyan
            $sessionUri = "https://${Server}/api/session/create"
            $rawUser = $Credential.UserName
            $password = $Credential.GetNetworkCredential().Password

            if ($rawUser -match '^(.+)\\(.+)$') { $samName = $Matches[2] }
            elseif ($rawUser -match '^([^@]+)@') { $samName = $Matches[1] }
            else { $samName = $rawUser }

            $usernamesToTry = @(
                $samName
            )

            $authenticated = $false
            foreach ($username in $usernamesToTry) {
                Write-Log " Trying: $username" -Color Gray
                $body = "j_username=$([uri]::EscapeDataString($username))&j_password=$([uri]::EscapeDataString($password))"
                try {
                    $sessionResponse = Invoke-WebRequest -Uri $sessionUri `
                        -Method Post `
                        -ContentType "application/x-www-form-urlencoded" `
                        -Body $body `
                        -SessionVariable "nsxSession" `
                        -UseBasicParsing `
                        -ErrorAction Stop

                    $xsrfToken = $sessionResponse.Headers["X-XSRF-TOKEN"]
                    if (-not $xsrfToken) {
                        Write-Log " No X-XSRF-TOKEN for '$username', trying next..." -Color Yellow
                        continue
                    }

                    $headers["X-XSRF-TOKEN"] = $xsrfToken
                    $script:NSXFallbackSession = $nsxSession
                    $authenticated = $true
                    Write-Log " NSX authenticated as: $username" -Color Green
                    break
                }
                catch {
                    Write-Log " Failed: $username - $($_.Exception.Message)" -Color Yellow
                    continue
                }
            }

            if (-not $authenticated) {
                throw "NSX vIDM authentication failed for all username formats"
            }
        }

        # Test connectivity
        $testUri = "https://${Server}/policy/api/v1/infra"
        $testParams = @{ Uri = $testUri; Headers = $headers; Method = "Get"; ErrorAction = "Stop" }
        if ($script:NSXFallbackSession) { $testParams["WebSession"] = $script:NSXFallbackSession }
        $null = Invoke-RestMethod @testParams
        Write-Log " NSX connection verified" -Color Green

        return $headers
    }

    # Switch SSL mode for NSX (NSX requires TrustAllCertsPolicy, not ServerCertificateValidationCallback)
    [System.Net.ServicePointManager]::ServerCertificateValidationCallback = $null
    if (-not ([System.Management.Automation.PSTypeName]'TrustAllCertsPolicy').Type) {
        Add-Type @"
using System.Net;
using System.Security.Cryptography.X509Certificates;
public class TrustAllCertsPolicy : ICertificatePolicy {
    public bool CheckValidationResult(
        ServicePoint srvPoint, X509Certificate certificate,
        WebRequest request, int certificateProblem) { return true; }
}
"@
    }
    [System.Net.ServicePointManager]::CertificatePolicy = New-Object TrustAllCertsPolicy

    # Import NSX credentials
    $script:NSXFallbackSession = $null
    if (Test-Path $NSXCredPath) {
        $nsxCred = Import-Clixml -Path $NSXCredPath
        Write-Log " Credentials imported from: $NSXCredPath" -Color Green
    } else {
        $nsxCred = Get-Credential -Message "Enter NSX Manager credentials"
        $credDir = Split-Path $NSXCredPath -Parent
        if (-not (Test-Path $credDir)) { New-Item -ItemType Directory -Path $credDir -Force | Out-Null }
        $nsxCred | Export-Clixml -Path $NSXCredPath
        Write-Log " Credentials saved to: $NSXCredPath" -Color Green
    }

    try {
        $nsxHeaders = Connect-NSXManagerFallback -Server $NSXManager -Credential $nsxCred -AuthMode $NSXAuthMode -VIDMDomain $NSXvIDMDomain
        $nsxFilled = 0

        foreach ($vm in $missingAppVMs) {
            try {
                $nsxUri = "https://${NSXManager}/api/v1/fabric/virtual-machines?display_name=$($vm.VMName)"
                $invokeParams = @{
                    Uri = $nsxUri
                    Headers = $nsxHeaders
                    Method = "Get"
                }
                if ($script:NSXFallbackSession) { $invokeParams["WebSession"] = $script:NSXFallbackSession }
                $nsxResponse = Invoke-RestMethod @invokeParams

                if ($nsxResponse.results -and $nsxResponse.results.Count -gt 0) {
                    $nsxVM = $nsxResponse.results[0]
                    if ($nsxVM.tags) {
                        $nsxAppTags = @()
                        foreach ($tag in $nsxVM.tags) {
                            # Strip ST- prefix from NSX tags for consistency
                            $tagValue = $tag.tag -replace '^ST-', ''
                            switch ($tag.scope) {
                                "app-application" {
                                    $nsxAppTags += $tagValue
                                }
                                "infra-os" {
                                    if (-not $vm.InfraOS) { $vm.InfraOS = $tagValue }
                                }
                                "app-layer" {
                                    if (-not $vm.AppLayer) { $vm.AppLayer = $tagValue }
                                }
                            }
                        }

                        if ($nsxAppTags.Count -gt 0) {
                            $vm.AppApplication = ($nsxAppTags | Select-Object -Unique) -join "; "
                            $nsxFilled++
                            Write-Log " $($vm.VMName) | NSX Tags: $($vm.AppApplication)" -Color Green

                            # Re-run comparison with multiple tags
                            $matchedApps = @()
                            if ($vm.CMDBCI) {
                                $ciList = $vm.CMDBCI -split ";\s*"
                                foreach ($tag in $nsxAppTags) {
                                    $normTag = ($tag.ToLower().Trim() -replace '[_\s\-\.]+', '')
                                    foreach ($ci in $ciList) {
                                        $normCI = ($ci.ToLower().Trim() -replace '[_\s\-\.]+', '')
                                        if ($normTag -and $normCI -and $normTag -eq $normCI) {
                                            $matchedApps += $tag
                                            break
                                        }
                                    }
                                }
                            }

                            if ($matchedApps.Count -gt 0) {
                                if ($nsxAppTags.Count -gt 1) {
                                    $vm.CompareResult = "Match - Multiple Tags"
                                } else {
                                    $vm.CompareResult = "Match"
                                }
                            } else {
                                $vm.CompareResult = "Mismatch"
                            }
                        }
                        else {
                            Write-Log " $($vm.VMName) | No app-application tag in NSX" -Color Gray
                        }
                    }
                }
                else {
                    Write-Log " $($vm.VMName) | Not found in NSX" -Color Gray
                }
            }
            catch {
                Write-Log " $($vm.VMName) | NSX lookup failed: $($_.Exception.Message)" -Color Red
            }
            Start-Sleep -Milliseconds 100
        }

        Write-Log " NSX filled: $nsxFilled / $($missingAppVMs.Count)" -Color Cyan
    }
    catch {
        Write-Log " NSX authentication failed: $($_.Exception.Message)" -Color Red
        Write-Log " Skipping NSX fallback" -Color Yellow
    }
}

# ---------------------------------------------------------------------------
# CMDB Relationship Review phase
# Runs after NSX fallback so AppApplication is as complete as possible.
# Adds six columns: NSXMatchCMDB, AppOrSubApp, UpstreamToApp,
# MultipleUpstream, NoUpstreamRelationship, Decommissioned.
# Sequential first cut - parallelise with a runspace pool once the vRO
# action calls are confirmed working.
# ---------------------------------------------------------------------------
if ($RunReview) {
    Write-Log "`n=== CMDB RELATIONSHIP REVIEW ($($results.Count) VMs) ===" -Color Cyan

    # Reset SSL callback to vRA mode (NSX fallback may have cleared/changed it)
    [System.Net.ServicePointManager]::CertificatePolicy = $null
    [System.Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }

    # Probe: confirm the /vco/api/actions endpoint responds and see the raw shape
    if ($ProbeVroActions) {
        $probeVm = if ($ProbeVMName) { $results | Where-Object { $_.VMName -eq $ProbeVMName } | Select-Object -First 1 }
                   else { $results | Select-Object -First 1 }
        if ($probeVm) {
            Write-Log " ===== PROBE: $($probeVm.VMName) | project $($probeVm.ProjectName) | tags '$($probeVm.AppApplication)' =====" -Color Yellow

            # 1) getCagApplications - does the catalogue return anything, and how does it parse?
            Write-Log "`n --- getCagApplications (raw) ---" -Color Yellow
            try {
                $cagRaw = Invoke-VroActionRest -VraServer $vraServer -AuthToken $authToken -ActionUri $getCagAppsUri -Parameters @{
                    projectName      = $probeVm.ProjectName
                    phasedOutEnabled = $phasedOutEnabled
                }
                Write-Log ($cagRaw | ConvertTo-Json -Depth 8) -Color Gray
                $cagCat = Get-CagCatalog -RawArray $cagRaw
                Write-Log " Parsed CAG -> Apps: $($cagCat.Apps.Count), SubApps: $($cagCat.SubApps.Count)" -Color Cyan
                Write-Log ("  Apps sample:    " + (($cagCat.Apps    | Select-Object -First 5) -join ' | ')) -Color Gray
                Write-Log ("  SubApps sample: " + (($cagCat.SubApps | Select-Object -First 5) -join ' | ')) -Color Gray
            }
            catch { Write-Log " getCagApplications failed: $($_.Exception.Message)" -Color Red }

            # 2) getVmApplications - raw shape AND the real property names on each object
            Write-Log "`n --- getVmApplications (raw) ---" -Color Yellow
            try {
                $vmRaw = Invoke-VroActionRest -VraServer $vraServer -AuthToken $authToken -ActionUri $getVmAppsUri -Raw -Parameters @{
                    projectName = $probeVm.ProjectName
                    vmName      = $probeVm.VMName
                }
                Write-Log ($vmRaw | ConvertTo-Json -Depth 10) -Color Gray
                $objs = @(Get-VroObjectArray -Response $vmRaw)
                Write-Log " Parsed objects: $($objs.Count)" -Color Cyan
                if ($objs.Count -gt 0) {
                    Write-Log ("  Property names on object[0]: " + (($objs[0].PSObject.Properties.Name) -join ', ')) -Color Green
                    Write-Log ($objs[0] | ConvertTo-Json -Depth 6) -Color Gray
                }
            }
            catch { Write-Log " getVmApplications failed: $($_.Exception.Message)" -Color Red }

            # 3) returnApplicationVms - raw shape for the first tag
            $firstTag = ($probeVm.AppApplication -split ";\s*" | Where-Object { $_ } | Select-Object -First 1)
            if ($firstTag) {
                Write-Log "`n --- returnApplicationVms (raw) for tag '$firstTag' ---" -Color Yellow
                try {
                    $rRaw = Invoke-VroActionRest -VraServer $vraServer -AuthToken $authToken -ActionUri $returnAppVmsUri -Raw -Parameters @{
                        applicationName  = ($firstTag -replace '_', ' ')
                        projectName      = $probeVm.ProjectName
                        vmName           = $probeVm.VMName
                        phasedOutEnabled = $phasedOutEnabled
                    }
                    Write-Log ($rRaw | ConvertTo-Json -Depth 10) -Color Gray
                }
                catch { Write-Log " returnApplicationVms failed: $($_.Exception.Message)" -Color Red }
            }
        }
        Write-Log "`n Probe done - set `$ProbeVroActions = `$false to run the full review." -Color Yellow
        return
    }

    if ($ReviewDebug -and (Test-Path $ReviewDebugPath)) { Remove-Item $ReviewDebugPath -Force }

    $reviewSet = if ($ReviewLimit -gt 0) { @($results | Select-Object -First $ReviewLimit) } else { $results }
    $reviewTotal = @($reviewSet).Count
    if ($ReviewLimit -gt 0) { Write-Log " (limited to first $reviewTotal VMs)" -Color Yellow }

    $reviewed = 0
    foreach ($vm in $reviewSet) {
        Write-Log " [$($reviewed + 1)/$reviewTotal] $($vm.VMName)..." -Color DarkGray
        $cat = Get-CagForProject -ProjectName $vm.ProjectName -VraServer $vraServer -AuthToken $authToken -CagUri $getCagAppsUri -PhasedOut $phasedOutEnabled
        $rev = Invoke-CmdbReview -Vm $vm -Catalog $cat -VraServer $vraServer -AuthToken $authToken -GetVmAppsUri $getVmAppsUri -ReturnAppVmsUri $returnAppVmsUri -PhasedOut $phasedOutEnabled -ClassFields $UpstreamClassFields -DebugPath $(if ($ReviewDebug) { $ReviewDebugPath } else { $null }) -UseWorkflowLogs $UseWorkflowLogs -WorkflowId $UpstreamWorkflowId -WfInputVmName $UpstreamWfInputVmName -WfInputProjectName $UpstreamWfInputProjectName -WorkflowWaitSec $WorkflowWaitSec

        Add-Member -InputObject $vm -NotePropertyName NSXMatchCMDB           -NotePropertyValue $rev.NSXMatchCMDB           -Force
        Add-Member -InputObject $vm -NotePropertyName AppOrSubApp            -NotePropertyValue $rev.AppOrSubApp            -Force
        Add-Member -InputObject $vm -NotePropertyName UpstreamToApp          -NotePropertyValue $rev.UpstreamToApp          -Force
        Add-Member -InputObject $vm -NotePropertyName MultipleUpstream       -NotePropertyValue $rev.MultipleUpstream       -Force
        Add-Member -InputObject $vm -NotePropertyName NoUpstreamRelationship -NotePropertyValue $rev.NoUpstreamRelationship -Force
        Add-Member -InputObject $vm -NotePropertyName Decommissioned         -NotePropertyValue $rev.Decommissioned         -Force

        $reviewed++
        if ($reviewed % 25 -eq 0) { Write-Log " Reviewed $reviewed / $reviewTotal" -Color Gray }
    }
    Write-Log " Review complete: $reviewed VMs" -Color Green
}

