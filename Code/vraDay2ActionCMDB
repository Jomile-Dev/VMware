"# Review debug - $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" | Out-File -FilePath $ReviewDebugPath -Encoding UTF8

$reviewOut = [System.Collections.Generic.List[object]]::new()
$rIdx = 0
foreach ($row in $results) {
    $rIdx++

    $nsxMatch               = if ($row.CompareResult) { $row.CompareResult } else { "N/A" }
    $appOrSubApp            = "N/A"
    $upstreamToApp          = "N/A"
    $multipleUpstream       = "No multiple upstream"
    $noUpstreamRelationship = "N/A"
    $upstreamAppDecomm      = "N/A"

    $tags = @()
    if ($row.AppApplication) { $tags = @($row.AppApplication -split ";\s*" | Where-Object { $_ }) }

    if ($tags.Count -gt 0) {
        # AppOrSubApp classification via CAG (per project)
        $cag = Get-CagForProject -ProjectName $row.ProjectName
        $classifyBits = @()
        foreach ($t in $tags) {
            $normT = Normalize-AppName $t
            $inApps    = $cag.Apps    | Where-Object { (Normalize-AppName $_) -eq $normT } | Select-Object -First 1
            $inSubApps = $cag.SubApps | Where-Object { (Normalize-AppName $_) -eq $normT } | Select-Object -First 1
            if     ($inApps)    { $classifyBits += "$t - convert to sub-app" }
            elseif ($inSubApps) { $classifyBits += "$t - sub-app" }
            else                { $classifyBits += "$t - not found in CAG" }
        }
        $appOrSubApp = ($classifyBits | Select-Object -Unique) -join "; "

        # Upstream via getVmApplications logs (per VM)
        $u = Get-UpstreamForVm -VmName $row.VMName -ProjectName $row.ProjectName
        $upstreamCIs = $u.UpstreamCIs

        # UpstreamToApp: any upstream whose CMSClass is Application / SubApplication
        $appLinked = $upstreamCIs | Where-Object {
            $_.UpstreamCICMSClass -match '^(Application|SubApplication)$'
        }
        if ($appLinked.Count -gt 0) {
            $upstreamToApp = (($appLinked | ForEach-Object {
                "$($_.UpstreamCIName) ($($_.UpstreamCICMSClass))"
            }) | Select-Object -Unique) -join "; "
        }

        # MultipleUpstream
        if ($upstreamCIs.Count -gt 1) {
            $multipleUpstream = (($upstreamCIs | ForEach-Object { $_.UpstreamCIName }) | Select-Object -Unique) -join "; "
        }

        # NoUpstreamRelationship
        if ($upstreamCIs.Count -eq 0) {
            $noUpstreamRelationship = "No upstream - review/fix upstream relationship"
        } else {
            $noUpstreamRelationship = "Has upstream"
        }

        # Upstream App Decomm - upstream with disposed/retired/phased status
        $decomm = $upstreamCIs |
            Where-Object { $_.UpstreamCIStatus -match '(?i)disposed|retired|phased' } |
            ForEach-Object { "$($_.UpstreamCIName): $($_.UpstreamCIStatus)" } |
            Select-Object -Unique
        if ($decomm) { $upstreamAppDecomm = ($decomm -join "; ") }

        Add-Content -Path $ReviewDebugPath -Encoding UTF8 -Value @"
[$rIdx/$($results.Count)] $($row.VMName) (project=$($row.ProjectName))
  Tags: $($row.AppApplication)
  NSXMatchCMDB: $nsxMatch
  AppOrSubApp: $appOrSubApp
  execId=$($u.Meta.ExecId) endpoint=$($u.Meta.LogEndpoint) chars=$($u.Meta.LogChars) upstream=$($upstreamCIs.Count)
  UpstreamToApp: $upstreamToApp
  MultipleUpstream: $multipleUpstream
  NoUpstreamRelationship: $noUpstreamRelationship
  Upstream App Decomm: $upstreamAppDecomm
"@
    }

    $reviewOut.Add([PSCustomObject]@{
        DeploymentName          = ConvertTo-CleanText $row.DeploymentName
        VMName                  = ConvertTo-CleanText $row.VMName
        ProjectId               = ConvertTo-CleanText $row.ProjectId
        ProjectName             = ConvertTo-CleanText $row.ProjectName
        AppApplication          = ConvertTo-CleanText $row.AppApplication
        InfraOS                 = ConvertTo-CleanText $row.InfraOS
        AppLayer                = ConvertTo-CleanText $row.AppLayer
        CMDBCI                  = ConvertTo-CleanText $row.CMDBCI
        NSXMatchCMDB            = ConvertTo-CleanText $nsxMatch
        AppOrSubApp             = ConvertTo-CleanText $appOrSubApp
        UpstreamToApp           = ConvertTo-CleanText $upstreamToApp
        MultipleUpstream        = ConvertTo-CleanText $multipleUpstream
        NoUpstreamRelationship  = ConvertTo-CleanText $noUpstreamRelationship
        'Upstream App Decomm'   = ConvertTo-CleanText $upstreamAppDecomm
    })

    if ($rIdx % 25 -eq 0) {
        Write-Log "  reviewed $rIdx / $($results.Count)" -Color Gray
    }
}


