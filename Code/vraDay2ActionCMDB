[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
[System.Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }

$vraServer = "<vra-server-fqdn>"
$id        = "<execId>"
$getH      = @{ Authorization = "Bearer $authToken"; Accept = "application/json" }

$conds = @(
    "conditions=severity=debug"
    "conditions=localonly=false"
    "conditions=type=both"
) -join "&"
$logUri = "https://$vraServer/vco/api/actions/$id/logs?$conds&maxResult=100000"
"URL: $logUri"

$logResp = Invoke-RestMethod -Uri $logUri -Headers $getH -Method Get
"logs count: " + @($logResp.logs).Count
$json = $logResp | ConvertTo-Json -Depth 40
"has upstream block: " + [bool]($json -match 'retrieveCIRelationshipInfoByKey')
"has upstreamCIs:     " + [bool]($json -match 'upstreamCIs')
"has UpstreamCIType:  " + [bool]($json -match 'UpstreamCIType')
