# VMware Aria Automation - Bulk CMDB Relations Extractor
# Calls the vRO form external-values endpoint to retrieve CMDB data for all VMs
# Uses runspace pooling for parallel execution (ISE compatible)

$vraServer = "vra.yourdomain.com"
$resultsDir = "C:\Logs"

# Email Configuration
$SendEmail = $true
$EmailTo = "admin@company.com"
$EmailFrom = "vmware-reports@company.com"
$EmailSubject = "CMDB Relations Comparison Report - $(Get-Date -Format 'yyyy-MM-dd')"
$SMTPServer = "mail.company.com"
$SMTPPort = 465
$UseSSL = $true

# vRO action URIs - each is the full "<module>/<actionName>" string.
# Format: dotted module namespace + a single forward slash + the action name.
# Do NOT include https:// or /vco/api/... - the code builds that part itself.
# The review-phase actions (getCag, returnAppVms) are called via the vRO Action
# REST API (/vco/api/actions), not the form external-values endpoint.
$showVmDetailsUri = "<module-namespace>/showVmDetails"
$getVmAppsUri     = "<module-namespace>/getVmApplications"
$getCagAppsUri    = "<module-namespace>/getCagApplications"
$returnAppVmsUri  = "<module-namespace>/returnApplicationsVms"

# ---------------------------------------------------------------------------
# UPSTREAM VIA ACTION LOGS (vRO/Aria 8.x)
# The upstream JSON (retrieveCIRelationshipInfoByKey.upstreamCIs) is written to
# the getVmApplications LOG. On 8.x an action run's log IS retrievable over REST,
# but at a different path than the execution resource:
#   GET /vco/api/actions/{executionId}/logs   (NOT /actions/{module}/{name}/executions/{id}/logs)
# Invoke-VroActionWithLogs now hits that correct path first, so no workflow or
# action edit is required. Leave $UseWorkflowLogs = $false to use it.
#
# WORKFLOW FALLBACK (only if the action-log path is blocked in your build):
# set $UseWorkflowLogs = $true and point $UpstreamWorkflowId at a thin wrapper
# workflow that calls getVmApplications with vmName + projectName.
$UseWorkflowLogs      = $false
$UpstreamWorkflowId   = "<workflow-id-guid>"     # only used when $UseWorkflowLogs = $true
# Workflow input parameter names -> mapped from the VM row at runtime.
$UpstreamWfInputVmName      = "vmName"
$UpstreamWfInputProjectName = "projectName"
# Max seconds to wait for a workflow run to leave "running" before giving up.
$WorkflowWaitSec      = 60

# Field(s) on the upstream object that hold "Application" / "SubApplication".
# UpstreamCIType is the current candidate; UpstreamCICMSClass is kept as a fallback.
$UpstreamClassFields = @('UpstreamCICMSClass', 'UpstreamCIType')

$phasedOutEnabled = $true
$RunReview        = $true

# Project placement check: compare the VM's upstream app against the CAG catalogue
# of the VM's OWN project. A VM whose upstream app belongs to a different project's
# CAG is sitting in the wrong project.
# COST: naming the correct project means holding a CAG catalogue for EVERY project
# in the estate, not just the ones in the review set. Each project costs one CAG
# fetch (two when $phasedOutEnabled is true), done once on the main thread before
# the review starts. Set to $false to skip the check and the fetches entirely.
$CheckProjectPlacement = $true

# Replay: skip the slow deployment fetch + main runspace phase and load a prior
# snapshot CSV straight into $results, then run the review against it.
$ReplayFromCsv    = $false
$ReplayCsvPath    = "C:\Logs\results_snapshot.csv"

# Probe: before the full review, run ONE getVmApplications call and dump the raw
# response, so you can confirm the /vco/api/actions endpoint works and see the shape.
$ProbeVroActions  = $false
$ProbeVMName      = ""            # blank = first VM in $results

# Review only the first N VMs (0 = all). Handy for troubleshooting.
$ReviewLimit      = 0

# Fetch only the first N deployments that contain eligible VMs (0 = all).
# Handy for troubleshooting - empty/deleted deployments don't count toward N.
$MaxDeployments   = 0

# Review-phase parallelism. The review makes real CMDB calls through vRO, so keep
# this well below the Phase 1 pool size. 1 = sequential (original behaviour).
# Raise gradually and watch $failedCsvPath for throttling/timeouts.
$ReviewPoolSize       = 6
$ReviewJobTimeoutSec  = 180

# Save a partial CSV every N reviewed VMs, so a long run that dies part-way still
# leaves usable output. Failed VMs are listed separately for a targeted re-run.
$IncrementalSaveEvery = 50

# Write raw + parsed vRO responses per reviewed VM to a file for troubleshooting.
$ReviewDebug      = $false
$ReviewDebugPath  = "C:\Logs\review_debug.txt"

# Partial output (rewritten every $IncrementalSaveEvery VMs) and the failed-VM list
$partialCsvPath   = "C:\Logs\CMDBRelations_PARTIAL.csv"
$failedCsvPath    = "C:\Logs\CMDBRelations_FAILED.csv"

# CSV column definition - defined early so the incremental partial saves during
# the review phase can use the same layout as the final export.
#
# NSX Tag is column D, NSX Tag Category is column E. NSX Tag Category reports the
# classification of the NSX tag as returned by getCagApplications: Sub-Application,
# Application - convert to sub-app, Not found in CAG, or No tag. Everything to the
# right of NSX Tag Category is supporting evidence.
#
# Two review fields are split into two columns each at export time, so the CSV
# is filterable on the verdict alone instead of "<CI>: <verdict>" in one cell:
#   MultipleUpstream  "<Result>: <CI details>"   -> Result + CI   (note: reversed)
#   UpstreamToApp     "<From> > <To>"            -> From   + To
# The underlying properties are unchanged - only the export layout differs.
# If a value doesn't match the expected shape, the first column keeps the raw
# value and the second is blank, so nothing is silently dropped.
$exportColumns = @(
    @{ Name = 'Deployment Name';               Expression = { $_.DeploymentName } }
    @{ Name = 'VM Name';                       Expression = { $_.VMName } }
    @{ Name = 'Project Name';                  Expression = { $_.ProjectName } }

    @{ Name = 'NSX Tag';                       Expression = { $_.AppApplication } }

    # Classification of the NSX tag from getCagApplications.
    @{ Name = 'NSX Tag Category';              Expression = { $_.Action } }

    @{ Name = 'Infra OS';                      Expression = { $_.InfraOS } }
    @{ Name = 'App Layer';                     Expression = { $_.AppLayer } }
    @{ Name = 'InfraPortal CMDB CI';           Expression = { $_.CMDBCI } }
    @{ Name = 'NSX Match CMDB';                Expression = { $_.NSXMatchCMDB } }

    @{ Name = 'VM Upstream Result';            Expression = { $_.MultipleUpstream } }
    @{ Name = 'Multiple Upstream CI';          Expression = { $_.MultipleUpstreamCI } }

    @{ Name = 'Upstream To';                   Expression = { $_.UpstreamTo } }

    @{ Name = 'Project Placement CI';          Expression = { $_.ProjectPlacementCI } }
    @{ Name = 'Project Placement Result';      Expression = { $_.ProjectPlacementResult } }

    @{ Name = 'NSX vs CMDB Decomm';            Expression = { $_.DecommCompare } }

    @{ Name = 'Upstream Lifecycle Status';     Expression = { $_.UpstreamLifecycleStatus } }
)

# Per-action REST timeout (seconds) so a bad/blocked endpoint fails fast
# instead of hanging the whole review.
$VroTimeoutSec    = 30

# NSX Manager Configuration (fallback for VMs with empty AppApplication)
$NSXManager    = "nsx-manager.company.com"
$NSXAuthMode   = "vIDM"
$NSXvIDMDomain = "COMPANY"
$NSXCredPath   = "C:\Scripts\Creds\nsx_cred.xml"

function Write-Log {
    param($Message, $Color = "White")
    Write-Host $Message -ForegroundColor $Color
}

# Configure TLS 1.2 and bypass SSL for vRA
# Use the COMPILED cert policy rather than a { $true } scriptblock callback: the
# scriptblock form throws "There is no Runspace available to run scripts in this
# thread" when the request runs on a background thread, which surfaces as
# "The underlying connection was closed: An unexpected error occurred on a send."
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
[System.Net.ServicePointManager]::Expect100Continue = $false
if (-not ([System.Management.Automation.PSTypeName]'TrustAllCertsPolicy').Type) {
    Add-Type @"
using System.Net;
using System.Security.Cryptography.X509Certificates;
public class TrustAllCertsPolicy : ICertificatePolicy {
    public bool CheckValidationResult(
        ServicePoint srvPoint, X509Certificate certificate,
        WebRequest request, int certificateProblem) { return true; }
}
"@
}
[System.Net.ServicePointManager]::CertificatePolicy = New-Object TrustAllCertsPolicy
[System.Net.ServicePointManager]::ServerCertificateValidationCallback = $null

# Authenticate to VMware Aria
Write-Log "=== AUTHENTICATION ===" -Color Cyan
$credential = Get-Credential -Message "Enter VMware Aria Automation credentials"
$authBody = @{
    username = $credential.UserName
    password = $credential.GetNetworkCredential().Password
} | ConvertTo-Json

$authResponse = Invoke-RestMethod -Uri "https://$vraServer/csp/gateway/am/api/login" `
    -Method Post -Headers @{"Content-Type"="application/json"} -Body $authBody
$authToken = $authResponse.cspAuthToken
Write-Log "Authentication successful!" -Color Green

# Normalise application name for comparison.
# Strips every non-alphanumeric character, not just [_\s\-\.], so typographic
# variants a CMDB CI can carry (en-dash U+2013, em-dash U+2014, NBSP, curly
# quotes, parentheses) don't leave a stray character in the normalised key and
# break a match that should have succeeded. The mojibake cleanup runs at export
# time - too late for the comparison.
function Normalize-AppName {
    param($Name)
    if (-not $Name) { return "" }
    return ($Name.ToLower().Trim() -replace '[^a-z0-9]+', '')
}

# ---------------------------------------------------------------------------
# vRO Action REST API helper
# Runs a vRO action synchronously and returns its output normalised:
#   - string return  -> [string]
#   - array return   -> [string[]]
#   - anything else  -> raw .value object
# CONFIRM this against your environment: endpoint path, auth scheme, and the
# request/response envelope. Swap in your own helper if it differs.
# ---------------------------------------------------------------------------
function Invoke-VroActionRest {
    param(
        [string]$VraServer,
        [string]$AuthToken,
        [string]$ActionUri,      # "module/actionName"
        [hashtable]$Parameters,
        [switch]$Raw,
        [int]$TimeoutSec = $(if ($VroTimeoutSec) { $VroTimeoutSec } else { 30 })
    )

    $lastSlash  = $ActionUri.LastIndexOf('/')
    $module     = $ActionUri.Substring(0, $lastSlash)
    $actionName = $ActionUri.Substring($lastSlash + 1)

    $paramList = foreach ($k in $Parameters.Keys) {
        $val = $Parameters[$k]
        if ($val -is [bool]) {
            @{ name = $k; type = "boolean"; value = @{ boolean = @{ value = $val } } }
        }
        else {
            @{ name = $k; type = "string"; value = @{ string = @{ value = [string]$val } } }
        }
    }

    $body = @{ parameters = @($paramList) } | ConvertTo-Json -Depth 6
    $uri  = "https://$VraServer/vco/api/actions/$module/$actionName/executions"
    $headers = @{
        "Authorization" = "Bearer $AuthToken"
        "Content-Type"  = "application/json"
        "Accept"        = "application/json"
    }

    $resp = Invoke-RestMethod -Uri $uri -Method Post -Headers $headers -Body $body -TimeoutSec $TimeoutSec
    if ($Raw) { return $resp }
    $v = $resp.value
    if ($null -ne $v.string) { return $v.string.value }
    elseif ($null -ne $v.array) { return @($v.array.elements | ForEach-Object { $_.string.value }) }
    else { return $v }
}

# Parse the flat getCagApplications string array into App / Sub-App buckets.
# Shape: ["--- Applications ---","app01","app02","--- Sub-Applications ---","sub01",...]
function Get-CagCatalog {
    param($RawArray)
    $apps    = [System.Collections.Generic.List[string]]::new()
    $subApps = [System.Collections.Generic.List[string]]::new()
    $bucket  = $null
    foreach ($line in @($RawArray)) {
        $t = ("" + $line).Trim()
        if (-not $t) { continue }
        if     ($t -match '^-+\s*Applications\s*-+$')      { $bucket = 'app'; continue }
        elseif ($t -match '^-+\s*Sub-?Applications\s*-+$') { $bucket = 'sub'; continue }
        if     ($bucket -eq 'app') { $apps.Add($t) }
        elseif ($bucket -eq 'sub') { $subApps.Add($t) }
    }
    return [PSCustomObject]@{ Apps = $apps; SubApps = $subApps }
}

# Per-project cache so getCagApplications is called once per project, not per VM
$cagCache = @{}
# Fetch the CAG catalogue through the form-service external-values endpoint - the
# same call the vRO/vRA UI makes. This is the mechanism Phase 1 already uses
# successfully; the /vco/api/actions/.../executions route returns nothing for this
# action in some environments, which silently produced an empty catalogue and made
# every tag report "Not found in CAG".
function Get-CagViaExternalValues {
    param($VraServer, $AuthToken, $ProjectId, $ProjectName, $CagUri, $PhasedOut)

    if (-not $ProjectId) { return @() }
    $headers = @{ Authorization = "Bearer $AuthToken"; "Content-Type" = "application/json" }
    $uri = "https://$VraServer/form-service/api/forms/renderer/external-values?projectId=$ProjectId"

    $req = @{
        uri                     = $CagUri
        dataSource              = "scriptAction"
        parameters              = @(
            @{ name = "projectName";      value = $ProjectName },
            @{ name = "phasedOutEnabled"; value = $PhasedOut }
        )
        useResultsFromRequestId = -1
        fieldType               = @{ dataType = "string" }
        isMultiple              = $true
        requestId               = 1
    }
    $body = "[" + ($req | ConvertTo-Json -Depth 6 -Compress) + "]"

    try {
        $resp = Invoke-RestMethod -Uri $uri -Method Post -Headers $headers -Body $body -TimeoutSec 60
        foreach ($r in @($resp)) {
            if ($r.data) { return @($r.data) }
        }
    }
    catch { }
    return @()
}

function Get-CagForProject {
    param($ProjectName, $ProjectId, $VraServer, $AuthToken, $CagUri, $PhasedOut)
    if (-not $ProjectName) { return [PSCustomObject]@{ Apps = @(); SubApps = @(); PhasedOutApps = @(); PhasedOutSubApps = @() } }
    if ($cagCache.ContainsKey($ProjectName)) { return $cagCache[$ProjectName] }

    # Full catalogue (external-values first, actions REST as fallback)
    $raw = Get-CagViaExternalValues -VraServer $VraServer -AuthToken $AuthToken -ProjectId $ProjectId -ProjectName $ProjectName -CagUri $CagUri -PhasedOut $PhasedOut
    if (-not $raw -or @($raw).Count -eq 0) {
        try {
            $raw = Get-VroObjectArray -Response (Invoke-VroActionRest -VraServer $VraServer -AuthToken $AuthToken -ActionUri $CagUri -Parameters @{
                projectName      = $ProjectName
                phasedOutEnabled = $PhasedOut
            })
        }
        catch { $raw = @() }
    }
    $cat = Get-CagCatalog -RawArray $raw

    # Live-only catalogue: the difference against the full list IS the phased-out set
    $liveApps = @(); $liveSubApps = @()
    if ($PhasedOut) {
        $rawLive = Get-CagViaExternalValues -VraServer $VraServer -AuthToken $AuthToken -ProjectId $ProjectId -ProjectName $ProjectName -CagUri $CagUri -PhasedOut $false
        if ($rawLive -and @($rawLive).Count -gt 0) {
            $live = Get-CagCatalog -RawArray $rawLive
            $liveApps    = @($live.Apps)
            $liveSubApps = @($live.SubApps)
        }
    }

    $liveAppKeys = @{}; foreach ($a in $liveApps)    { $liveAppKeys[(Normalize-AppName $a)] = $true }
    $liveSubKeys = @{}; foreach ($a in $liveSubApps) { $liveSubKeys[(Normalize-AppName $a)] = $true }

    $phasedApps = @(); $phasedSubs = @()
    if ($PhasedOut -and ($liveApps.Count -gt 0 -or $liveSubApps.Count -gt 0)) {
        $phasedApps = @($cat.Apps    | Where-Object { -not $liveAppKeys[(Normalize-AppName $_)] })
        $phasedSubs = @($cat.SubApps | Where-Object { -not $liveSubKeys[(Normalize-AppName $_)] })
    }

    $result = [PSCustomObject]@{
        Apps             = $cat.Apps
        SubApps          = $cat.SubApps
        PhasedOutApps    = $phasedApps
        PhasedOutSubApps = $phasedSubs
    }

    # Do not fail silently - an empty catalogue makes every tag look "Not found in CAG"
    if (@($result.Apps).Count -eq 0 -and @($result.SubApps).Count -eq 0) {
        Write-Log "  WARNING: CAG catalogue is EMPTY for project '$ProjectName' - every tag will report 'Not found in CAG'" -Color Yellow
    }

    $cagCache[$ProjectName] = $result
    return $result
}

# Defensively pull an array of objects out of a vRO action REST response.
# Handles a native array in .value.array.elements (either .properties key/value
# pairs or a JSON string per element), a single JSON-string return, or an
# already-native array/object. Confirm the actual envelope against your logs.
function Get-VroObjectArray {
    param($Response)
    if ($null -eq $Response) { return @() }

    $v = $Response.value
    if ($v -and $v.array -and $v.array.elements) {
        $out = foreach ($el in $v.array.elements) {
            if ($el.properties) {
                $o = @{}
                foreach ($p in $el.properties) { $o[$p.key] = $p.value.string.value }
                [PSCustomObject]$o
            }
            elseif ($el.string -and $el.string.value) {
                try { $el.string.value | ConvertFrom-Json -ErrorAction Stop } catch { $el.string.value }
            }
            else { $el }
        }
        return @($out)
    }
    if ($v -and $v.string -and $v.string.value) {
        try { return @($v.string.value | ConvertFrom-Json -ErrorAction Stop) } catch { return @() }
    }
    if ($Response -is [string]) {
        try { return @($Response | ConvertFrom-Json -ErrorAction Stop) } catch { return @() }
    }
    return @($Response)
}

# First non-empty value across a set of candidate field names
function Get-FirstFieldValue {
    param($Object, [string[]]$Fields)
    foreach ($f in $Fields) {
        $val = $Object.$f
        if ($val) { return [string]$val }
    }
    return ""
}

# Normalise a CMDB class value to one notation for the CSV.
# The raw values are "Application" / "SubApplication"; every column that prints a
# class uses [App] / [Sub-App] so the same CI reads identically across columns.
function Format-CiClass {
    param([string]$Class)
    if ($Class -eq 'SubApplication') { return 'Sub-App' }
    if ($Class -eq 'Application')    { return 'App' }
    if ($Class)                      { return $Class }
    return 'Unknown'
}

# Unwrap a returnApplicationVms REST response to a JSON object.
# The action returns a JSON string (vRO envelope at value.string.value); ConvertFrom-Json it.
function Get-VroJson {
    param($Response)
    if ($null -eq $Response) { return $null }
    $s = $null
    if ($Response.value -and $Response.value.string) { $s = $Response.value.string.value }
    elseif ($Response -is [string]) { $s = $Response }
    if ($s) { try { return ($s | ConvertFrom-Json -ErrorAction Stop) } catch { return $null } }
    # Array return: scan each string element for one that parses as JSON
    if ($Response.value -and $Response.value.array -and $Response.value.array.elements) {
        foreach ($el in $Response.value.array.elements) {
            $ev = $el.string.value
            if ($ev -and ($ev.TrimStart().StartsWith('{'))) {
                try { return ($ev | ConvertFrom-Json -ErrorAction Stop) } catch { }
            }
        }
        return $null
    }
    return $Response
}

# Pull the upstreamCIs array out of a parsed returnApplicationVms object,
# handling retrieveCiInfoByKey.Information[] nesting or a flatter shape.
function Get-UpstreamCIs {
    param($Obj)
    if ($null -eq $Obj) { return @() }
    $ups = @()
    if ($Obj.retrieveCiInfoByKey.Information) {
        foreach ($info in @($Obj.retrieveCiInfoByKey.Information)) { $ups += @($info.upstreamCIs) }
    }
    elseif ($Obj.Information) {
        foreach ($info in @($Obj.Information)) { $ups += @($info.upstreamCIs) }
    }
    elseif ($Obj.retrieveCIRelationshipInfoByKey.upstreamCIs) {
        $ups += @($Obj.retrieveCIRelationshipInfoByKey.upstreamCIs)
    }
    elseif ($Obj.upstreamCIs) {
        $ups += @($Obj.upstreamCIs)
    }
    return @($ups | Where-Object { $_ })
}

# CI-level Status values from retrieveCiInfoByKey.Information[] - this is where
# a disposed/retired sub-app shows even when there is no upstream relationship.
function Get-CiStatuses {
    param($Obj)
    if ($null -eq $Obj) { return @() }
    $infos = @()
    if     ($Obj.retrieveCiInfoByKey.Information) { $infos = @($Obj.retrieveCiInfoByKey.Information) }
    elseif ($Obj.Information)                     { $infos = @($Obj.Information) }
    return @($infos | ForEach-Object { $_.Status } | Where-Object { $_ })
}

# Extract the JSON object surrounding a marker string from log text.
# Brace-matching - fragile if values contain literal braces.
function Get-JsonBlockFromText {
    # Scans EVERY occurrence of $Marker, not just the first.
    # The action log contains the marker twice: once in the outgoing REQUEST
    # (Data: {"retrieveCIRelationshipInfoByKey":{"key":[...],"source":...}} - which
    # has no relationship arrays) and once in the RESPONSE (which holds
    # downstreamCIs / upstreamCIs). Taking the first match returns the request block
    # and finds nothing, so require the block to contain $RequireProperty when given.
    # Also retries after unescaping, since the block can be embedded as an escaped
    # JSON string inside the log message.
    param($Text, $Marker, $RequireProperty)
    if (-not $Text) { return $null }

    $searchAt = 0
    while ($true) {
        $idx = $Text.IndexOf($Marker, $searchAt)
        if ($idx -lt 0) { return $null }
        $searchAt = $idx + 1

        $start = $Text.LastIndexOf('{', $idx)
        if ($start -lt 0) { continue }

        $depth = 0; $end = -1
        for ($i = $start; $i -lt $Text.Length; $i++) {
            $c = $Text[$i]
            if     ($c -eq '{') { $depth++ }
            elseif ($c -eq '}') { $depth--; if ($depth -eq 0) { $end = $i; break } }
        }
        if ($end -lt 0) { continue }

        $json = $Text.Substring($start, $end - $start + 1)

        # Skip blocks that don't carry the property we actually need
        if ($RequireProperty -and ($json -notmatch [regex]::Escape($RequireProperty))) { continue }

        $obj = $null
        try { $obj = $json | ConvertFrom-Json -ErrorAction Stop } catch { $obj = $null }

        if (-not $obj) {
            # Retry as an escaped JSON string embedded in the log message
            $u = $json -replace '\\u0027', "'" -replace '\\u003c', '<' -replace '\\u003e', '>'
            $u = $u -replace '\\"', '"' -replace '\\n', "`n" -replace '\\r', "`r" -replace '\\t', "`t"
            try { $obj = $u | ConvertFrom-Json -ErrorAction Stop } catch { $obj = $null }
        }

        if ($obj) { return $obj }
    }
    return $null
}

# From log text: upstreamCIs out of the retrieveCIRelationshipInfoByKey block.
function Get-UpstreamCIsFromLog {
    param($LogText)
    # Bare key name as the marker so both escaped (\"key\") and plain ("key") hit.
    # Require upstreamCIs so the request-payload block is skipped.
    $obj = Get-JsonBlockFromText -Text $LogText -Marker 'retrieveCIRelationshipInfoByKey' -RequireProperty 'upstreamCIs'
    if (-not $obj) { $obj = Get-JsonBlockFromText -Text $LogText -Marker 'upstreamCIs' -RequireProperty 'UpstreamCIID' }
    if (-not $obj) { return @() }
    return @(Get-UpstreamCIs -Obj $obj)
}

# From log text: CI Status values out of the retrieveCiInfoByKey block.
function Get-CiStatusesFromLog {
    param($LogText)
    $obj = Get-JsonBlockFromText -Text $LogText -Marker 'retrieveCiInfoByKey' -RequireProperty 'Information'
    if (-not $obj) { $obj = Get-JsonBlockFromText -Text $LogText -Marker 'retrieveCiInfoByKey' }
    if (-not $obj) { return @() }
    return @(Get-CiStatuses -Obj $obj)
}

# Run a WORKFLOW via REST and fetch that run's logs. On vRO/Aria 8.x a workflow
# execution exposes its log at /executions/{execId}/syslogs (and /logs), where the
# wrapped action's System.log output - including retrieveCIRelationshipInfoByKey -
# appears. Poll state until the run leaves "running", then read the log.
# Returns the same shape as Invoke-VroActionWithLogs: Value/LogText/LogEndpoint/ExecId.
function Invoke-VroWorkflowWithLogs {
    param(
        $VraServer, $AuthToken, $WorkflowId, [hashtable]$Parameters,
        [int]$WaitSec = 60, [int]$TimeoutSec = 60
    )

    $headers = @{
        "Authorization" = "Bearer $AuthToken"
        "Content-Type"  = "application/json"
        "Accept"        = "application/json"
    }

    # Workflow execution body: parameters use the same typed envelope as actions.
    $paramList = foreach ($k in $Parameters.Keys) {
        $val = $Parameters[$k]
        if ($val -is [bool]) { @{ name = $k; type = "boolean"; value = @{ boolean = @{ value = $val } } } }
        else                 { @{ name = $k; type = "string";  value = @{ string  = @{ value = [string]$val } } } }
    }
    $body = @{ parameters = @($paramList) } | ConvertTo-Json -Depth 6

    $base   = "https://$VraServer/vco/api/workflows/$WorkflowId"
    $execId = $null

    try {
        $resp = Invoke-WebRequest -Uri "$base/executions" -Method Post -Headers $headers -Body $body -TimeoutSec $TimeoutSec -UseBasicParsing
        if ($resp.Headers.Location) { $execId = ([string]$resp.Headers.Location).TrimEnd('/').Split('/')[-1] }
        if (-not $execId -and $resp.Content) {
            try { $p = $resp.Content | ConvertFrom-Json; if ($p.id) { $execId = $p.id } } catch { }
        }
    }
    catch {
        return [PSCustomObject]@{ Value = $null; LogText = ""; LogEndpoint = "wf-run-failed: $($_.Exception.Message)"; ExecId = $null }
    }

    if (-not $execId) {
        return [PSCustomObject]@{ Value = $null; LogText = ""; LogEndpoint = "wf-no-execId"; ExecId = $null }
    }

    # Poll state until it leaves "running" (or we hit the wait cap)
    $waited = 0
    do {
        Start-Sleep -Milliseconds 1000
        $waited++
        $state = "unknown"
        try {
            $st = Invoke-RestMethod -Uri "$base/executions/$execId/state" -Method Get -Headers $headers -TimeoutSec 30
            if ($st.value) { $state = [string]$st.value } elseif ($st.'state') { $state = [string]$st.'state' }
        } catch { }
    } while ($state -eq "running" -and $waited -lt $WaitSec)

    # Read the run log (syslogs carries the detailed System.log lines; /logs is the fallback)
    $logText = ""; $usedEndpoint = "none"
    $candidates = @(
        "$base/executions/$execId/syslogs?maxResult=10000",
        "$base/executions/$execId/logs?maxResult=10000"
    )
    foreach ($cand in $candidates) {
        try {
            $logResp = Invoke-RestMethod -Uri $cand -Method Get -Headers $headers -TimeoutSec 30
            $lines = @()
            foreach ($e in @($logResp.logs)) {
                $m = $null
                if     ($e.entry.'long-message')  { $m = $e.entry.'long-message' }
                elseif ($e.entry.'short-message') { $m = $e.entry.'short-message' }
                elseif ($e.message)               { $m = $e.message }
                if ($m) { $lines += $m }
            }
            if (-not $lines -and $logResp -is [string]) { $lines = @($logResp) }
            if ($lines) { $logText = ($lines -join "`n"); $usedEndpoint = $cand; break }
        }
        catch { continue }
    }

    return [PSCustomObject]@{ Value = $null; LogText = $logText; LogEndpoint = $usedEndpoint; ExecId = $execId }
}

# Run an action (same module/name URI as everywhere else) and fetch that run's
# logs - the same data the GUI Logs tab shows. Also returns the action's value.
function Invoke-VroActionWithLogs {
    param($VraServer, $AuthToken, $ActionUri, [hashtable]$Parameters, [int]$TimeoutSec = 60)

    $lastSlash  = $ActionUri.LastIndexOf('/')
    $module     = $ActionUri.Substring(0, $lastSlash)
    $actionName = $ActionUri.Substring($lastSlash + 1)

    $headers = @{
        "Authorization" = "Bearer $AuthToken"
        "Content-Type"  = "application/json"
        "Accept"        = "application/json"
    }
    $paramList = foreach ($k in $Parameters.Keys) {
        $val = $Parameters[$k]
        if ($val -is [bool]) { @{ name = $k; type = "boolean"; value = @{ boolean = @{ value = $val } } } }
        else { @{ name = $k; type = "string"; value = @{ string = @{ value = [string]$val } } } }
    }
    $body = @{ parameters = @($paramList) } | ConvertTo-Json -Depth 6

    $base   = "https://$VraServer/vco/api/actions/$module/$actionName"
    $execId = $null; $value = $null
    try {
        $resp = Invoke-WebRequest -Uri "$base/executions" -Method Post -Headers $headers -Body $body -TimeoutSec $TimeoutSec -UseBasicParsing
        if ($resp.Headers.Location) { $execId = ([string]$resp.Headers.Location).TrimEnd('/').Split('/')[-1] }
        if ($resp.Content) {
            try {
                $parsed = $resp.Content | ConvertFrom-Json
                $value = $parsed
                if (-not $execId -and $parsed.id) { $execId = $parsed.id }
                if (-not $execId -and $parsed.'execution-id') { $execId = $parsed.'execution-id' }
            } catch { }
        }
    }
    catch { return [PSCustomObject]@{ Value = $null; LogText = ""; LogEndpoint = "run-failed: $($_.Exception.Message)"; ExecId = $null } }

    $logText = ""; $usedEndpoint = "none"
    if ($execId) {
        # Action-log endpoint (vRO 8.x): keyed on the EXECUTION ID directly,
        # NOT under module/name:
        #   GET /vco/api/actions/{executionId}/logs
        # CONFIRMED: the upstream JSON (retrieveCIRelationshipInfoByKey) is logged at
        # DEBUG level. Without conditions=severity=debug the endpoint returns only the
        # handful of info-level factory lines and the upstream block is absent.
        # This condition set matches what the vRO web UI itself sends.
        $actionsRoot = "https://$VraServer/vco/api/actions"
        $debugConds = @(
            "conditions=severity=debug"
            "conditions=localonly=false"
            "conditions=type=both"
        ) -join "&"
        $candidates = @(
            "$actionsRoot/$execId/logs?$debugConds&maxResult=300",
            "$actionsRoot/$execId/logs?maxResult=10000",
            "$base/executions/$execId/syslogs?maxResult=10000",
            "$base/executions/$execId/logs?maxResult=10000"
        )
        foreach ($cand in $candidates) {
            try {
                $logResp = Invoke-RestMethod -Uri $cand -Method Get -Headers $headers -TimeoutSec 60
                $lines = @()
                foreach ($e in @($logResp.logs)) {
                    # This appliance serialises the nested form: logs[].entry.*
                    # Newer published model uses top-level logs[].* - handle both.
                    $entry = if ($e.entry) { $e.entry } else { $e }
                    $m = $null
                    if     ($entry.'long-message')     { $m = $entry.'long-message' }
                    elseif ($entry.'long-description') { $m = $entry.'long-description' }
                    elseif ($entry.'short-message')    { $m = $entry.'short-message' }
                    elseif ($entry.'short-description'){ $m = $entry.'short-description' }
                    elseif ($entry.message)            { $m = $entry.message }
                    if ($m) { $lines += $m }
                }
                if (-not $lines -and $logResp -is [string]) { $lines = @($logResp) }
                if ($lines) { $logText = ($lines -join "`n"); $usedEndpoint = $cand; break }
            }
            catch { continue }
        }
    }

    return [PSCustomObject]@{ Value = $value; LogText = $logText; LogEndpoint = $usedEndpoint; ExecId = $execId }
}

# Build the review fields for one VM result object
# Resolve an application / sub-application: its own status AND its own upstreams.
# Second hop of the chain. The VM's upstream gives us the Sub-App name only;
# returnApplicationVms takes applicationName, so run it and read both the CI status
# and that app's upstreamCIs out of its debug log. Cached per app name.
function Get-AppDecommStatus {
    param($AppName, $VraServer, $AuthToken, $ReturnAppVmsUri, $Cache)

    if (-not $AppName) { return $null }
    $key = ($AppName.ToLower().Trim())
    if ($Cache -and $Cache.ContainsKey($key)) { return $Cache[$key] }

    $statuses = @()
    $ownUpstreams = @()
    try {
        $res = Invoke-VroActionWithLogs -VraServer $VraServer -AuthToken $AuthToken `
            -ActionUri $ReturnAppVmsUri -Parameters @{ applicationName = $AppName }

        if ($res.LogText) {
            $statuses     += @(Get-CiStatusesFromLog -LogText $res.LogText)
            $ownUpstreams += @(Get-UpstreamCIsFromLog -LogText $res.LogText)
        }
        if (-not $statuses -and $res.Value) {
            $obj = Get-VroJson -Response $res.Value
            if ($obj) {
                $statuses     += @(Get-CiStatuses  -Obj $obj)
                $ownUpstreams += @(Get-UpstreamCIs -Obj $obj)
            }
        }
    }
    catch { }

    $statuses = @($statuses | Where-Object { $_ } | Select-Object -Unique)
    $disposed = @($statuses | Where-Object { $_ -match 'dispos|retire|decommission|phased' })

    $result = [PSCustomObject]@{
        AppName      = $AppName
        Statuses     = $statuses
        IsDisposed   = ($disposed.Count -gt 0)
        Disposed     = $disposed
        OwnUpstreams = $ownUpstreams
    }
    if ($Cache) { $Cache[$key] = $result }
    return $result
}


function Invoke-CmdbReview {
    param(
        $Vm, $Catalog, $VraServer, $AuthToken, $GetVmAppsUri, $ReturnAppVmsUri,
        $PhasedOut, $ClassFields, $DebugPath,
        $UseWorkflowLogs, $WorkflowId, $WfInputVmName, $WfInputProjectName, $WorkflowWaitSec,
        $AppStatusCache, $AppToProject, $AppClass
    )

    $nsxMatch = switch ($Vm.CompareResult) {
        "Match"                 { "NSX tag matches CMDB" }
        "Match - Multiple Tags" {
            # List which tags actually matched, rather than just saying "multiple"
            if ($Vm.MatchedApps) { "NSX tag matches CMDB (multiple tags: $($Vm.MatchedApps))" }
            else                 { "NSX tag matches CMDB (multiple tags)" }
        }
        "Mismatch"              { "No match - review CMDB or NSX tag" }
        "Missing Data"          { "CMDB data missing - review" }
        default                 { [string]$Vm.CompareResult }
    }

    # NON_NSX is a marker, not an application - exclude it from every review check
    $tags = if ($Vm.AppApplication) {
        @($Vm.AppApplication -split ";\s*" | Where-Object { $_ -and ($_ -notmatch '^(?i)non[_\s\-]?nsx$') })
    } else { @() }

    # --- App vs Sub-App per tag (from getCagApplications catalogue) ---
    # Classifies each tag against the project's CAG catalogue. When a VM carries
    # several tags one is chosen as primary, preferring a tag that actually resolves
    # in CAG over one that does not: a real classification beats "Not found".
    # Order of preference: Sub-Application, then Application, then unresolved.
    # The chosen tag's classification becomes the Action value for the row.
    $tagClasses = @{}
    $primaryTag = $null; $primaryClass = $null
    foreach ($tag in $tags) {
        $normTag = ($tag.ToLower().Trim() -replace '[^a-z0-9]+', '')
        $isApp = $Catalog.Apps    | Where-Object { (($_.ToLower().Trim()) -replace '[^a-z0-9]+', '') -eq $normTag }
        $isSub = $Catalog.SubApps | Where-Object { (($_.ToLower().Trim()) -replace '[^a-z0-9]+', '') -eq $normTag }

        if     ($isSub) { $cls = 'Sub-Application' }
        elseif ($isApp) { $cls = 'Application - convert to sub-app' }
        elseif ($AppClass -and $AppClass[$normTag]) {
            # Fallback: not in the VM's own project's CAG, but is in some project's CAG.
            # Classify by the class found there. Project Placement column names the
            # project(s) it actually belongs to.
            $globalCls = $AppClass[$normTag]
            if     ($globalCls -eq 'SubApplication') { $cls = 'Sub-Application' }
            elseif ($globalCls -eq 'Application')    { $cls = 'Application - convert to sub-app' }
            else                                     { $cls = 'Not found in CAG' }
        }
        else            { $cls = 'Not found in CAG' }
        $tagClasses[$tag] = $cls

        # First sub-app wins outright; an app only takes the slot if no sub-app has
        # been seen; an unresolved tag only if nothing else has claimed it.
        if ($cls -eq 'Sub-Application') {
            if ($primaryClass -ne 'Sub-Application') { $primaryTag = $tag; $primaryClass = $cls }
        }
        elseif ($cls -eq 'Application - convert to sub-app') {
            if ($primaryClass -notin @('Sub-Application', 'Application - convert to sub-app')) { $primaryTag = $tag; $primaryClass = $cls }
        }
        else {
            if (-not $primaryTag) { $primaryTag = $tag; $primaryClass = $cls }
        }
    }

    # --- Action -------------------------------------------------------------
    # The classification of the NSX tag from the project's CAG catalogue:
    #   Sub-Application
    #   Application - convert to sub-app
    #   Not found in CAG
    #   No tag
    # A property of the tag, not a verdict on the VM. Every column to its right
    # is supporting evidence (upstream, project placement, decomm, etc.).
    if (-not $primaryTag) { $action = "No tag" }
    else                  { $action = $primaryClass }

    # --- Upstream relationship from getVmApplications LOGS ---
    # The upstream data (retrieveCIRelationshipInfoByKey.upstreamCIs) is written to
    # the getVmApplications run's LOG output, not its return value.
    # CONFIRMED on 8.18.1: the action log IS retrievable via
    #   GET /vco/api/actions/{execId}/logs?conditions=severity=debug&...
    # The block is logged at DEBUG level, so the severity=debug condition is required -
    # without it the endpoint returns only the few info-level factory lines.
    # Keyed on vmName + projectName (one call per VM). The workflow-log path remains
    # available via $UseWorkflowLogs but is not needed.
    $upstreamCIs = @()
    $ciStatuses  = @()
    $returnRaws  = @()
    try {
        if ($UseWorkflowLogs -and $WorkflowId -and $WorkflowId -notmatch '^<') {
            # Optional: run a wrapper workflow and read its run log
            $wfInputs = @{}
            $wfInputs[$WfInputVmName]      = $Vm.VMName
            $wfInputs[$WfInputProjectName] = $Vm.ProjectName
            $runRes = Invoke-VroWorkflowWithLogs -VraServer $VraServer -AuthToken $AuthToken -WorkflowId $WorkflowId -Parameters $wfInputs -WaitSec $WorkflowWaitSec
            $runMode = "workflow"
        }
        else {
            # Default: action execution + debug-level action log (confirmed working)
            $runRes = Invoke-VroActionWithLogs -VraServer $VraServer -AuthToken $AuthToken -ActionUri $GetVmAppsUri -Parameters @{
                vmName      = $Vm.VMName
                projectName = $Vm.ProjectName
            }
            $runMode = "action"
        }
        $returnRaws += [ordered]@{ vmName = $Vm.VMName; runMode = $runMode; execId = $runRes.ExecId; logEndpoint = $runRes.LogEndpoint; logChars = @($runRes.LogText).Length; log = $runRes.LogText; value = $runRes.Value }
        # Upstream CIs: from the log's retrieveCIRelationshipInfoByKey block
        # (falls back to the return value if it ever carries the JSON)
        $upstreamCIs += @(Get-UpstreamCIsFromLog -LogText $runRes.LogText)
        $obj = Get-VroJson -Response $runRes.Value
        $upstreamCIs += @(Get-UpstreamCIs -Obj $obj)
        # CI Status (disposed/retired) : from retrieveCiInfoByKey.Information[]
        # in the return AND the log - covers decomm even with no upstream
        $ciStatuses += @(Get-CiStatuses -Obj $obj)
        $ciStatuses += @(Get-CiStatusesFromLog -LogText $runRes.LogText)
    }
    catch { }
    $upstreamCIs = @($upstreamCIs | Where-Object { $_ })
    $ciStatuses  = @($ciStatuses  | Where-Object { $_ })

    $upstreamToApp = "N/A"; $multiUpstream = "No multiple upstream"; $noUpstream = "N/A"; $decomm = "No"
    $upstreamTo = ""; $multiUpstreamCI = ""
    $lifecycleStatus = "N/A"

    # RULE: the chain should be VM > Sub-App > Application.
    # Only Application / SubApplication upstreams are relationship-relevant; the
    # other upstreams a VM carries (OBM Agent, Running Software, etc.) are not app
    # relationships and must not count toward "multiple upstream" or mask a
    # genuinely missing app link.
    $appUpstreams = @($upstreamCIs | Where-Object {
        (Get-FirstFieldValue -Object $_ -Fields $ClassFields) -match '^(Application|SubApplication)$'
    })
    $otherUpstreams = @($upstreamCIs | Where-Object {
        (Get-FirstFieldValue -Object $_ -Fields $ClassFields) -notmatch '^(Application|SubApplication)$'
    })
    # Upstream to an Application is the correct end state; upstream to another
    # Sub-Application does not satisfy the rule and needs review.
    $toApplication    = @($appUpstreams | Where-Object { (Get-FirstFieldValue -Object $_ -Fields $ClassFields) -eq 'Application' })
    $toSubApplication = @($appUpstreams | Where-Object { (Get-FirstFieldValue -Object $_ -Fields $ClassFields) -eq 'SubApplication' })

    if ($appUpstreams.Count -gt 0) {
        # ---- FIRST HOP: what the VM is linked to ----
        $firstHopNames = @($appUpstreams | ForEach-Object {
            "$($_.UpstreamCIName) [$(Format-CiClass (Get-FirstFieldValue -Object $_ -Fields $ClassFields))]"
        } | Select-Object -Unique)

        # Verdict and evidence kept as separate fields rather than one joined string,
        # so neither has to be parsed back out at export time.
        if ($appUpstreams.Count -gt 1) {
            $multiUpstream = "Review - multiple upstream app/sub-app ($($appUpstreams.Count))"
        }
        else {
            $multiUpstream = "Good - single upstream"
        }
        $multiUpstreamCI = ($firstHopNames -join "; ")

        # ---- SECOND HOP: does the VM's upstream itself have an upstream? ----
        # Ideal chain is VM > Sub-App > App. A Sub-App with no upstream App needs
        # review; an Application at the first hop is already top of the chain, so
        # "App to nothing" is expected rather than a fault.
        $hopDetails = @()
        $hopTo      = @()
        $anySecondHop = $false
        $anySubAppMissingApp = $false
        # Lifecycle: apps that came back with UpstreamCIStatus "Planned/On order".
        # Checked at both hops. Distinct from Decomm (dispos|retire|decommission|phased) -
        # this is "not yet live" rather than "no longer live".
        $lifecycleHits = @()

        foreach ($u in $appUpstreams) {
            $uName  = $u.UpstreamCIName
            $uClass = Get-FirstFieldValue -Object $u -Fields $ClassFields
            if (-not $uName) { continue }

            # 1st hop lifecycle: direct upstream's own status
            if ($u.UpstreamCIStatus -match '(?i)planned/on\s*order') {
                $lifecycleHits += "VM upstream: $uName [$(Format-CiClass $uClass)] - $($u.UpstreamCIStatus)"
            }

            $info = Get-AppDecommStatus -AppName $uName -VraServer $VraServer `
                -AuthToken $AuthToken -ReturnAppVmsUri $ReturnAppVmsUri -Cache $AppStatusCache

            $ownApps = @()
            $ownSubs = @()
            if ($info -and $info.OwnUpstreams) {
                foreach ($ou in $info.OwnUpstreams) {
                    $ouClass = Get-FirstFieldValue -Object $ou -Fields $ClassFields
                    if     ($ouClass -eq 'Application')    { $ownApps += $ou.UpstreamCIName }
                    elseif ($ouClass -eq 'SubApplication') { $ownSubs += $ou.UpstreamCIName }

                    # 2nd hop lifecycle: status of the upstream's own upstream
                    if ($ou.UpstreamCIStatus -match '(?i)planned/on\s*order') {
                        $lifecycleHits += "App above ${uName}: $($ou.UpstreamCIName) [$(Format-CiClass $ouClass)] - $($ou.UpstreamCIStatus)"
                    }
                }
            }
            $ownApps = @($ownApps | Where-Object { $_ } | Select-Object -Unique)
            $ownSubs = @($ownSubs | Where-Object { $_ } | Select-Object -Unique)

            if ($uClass -eq 'Application') {
                # VM linked straight to an Application - top of chain, nothing above
                $hopDetails += "$uName [App] > nothing (App is top of chain)"
                $hopTo      += "nothing (App is top of chain)"
            }
            elseif ($ownApps.Count -gt 0) {
                $anySecondHop = $true
                $hopDetails += "$uName [Sub-App] > $($ownApps -join ', ') [App]"
                $hopTo      += "$($ownApps -join ', ') [App]"
            }
            elseif ($ownSubs.Count -gt 0) {
                $anySecondHop = $true
                $hopDetails += "$uName [Sub-App] > $($ownSubs -join ', ') [Sub-App] - review, should point to an App"
                $hopTo      += "$($ownSubs -join ', ') [Sub-App] - review, should point to an App"
            }
            else {
                $anySubAppMissingApp = $true
                $hopDetails += "$uName [Sub-App] > nothing - review, no upstream App"
                $hopTo      += "nothing - review, no upstream App"
            }
        }

        $upstreamToApp = ($hopDetails -join "; ")

        # $upstreamTo is built as its own list rather than parsed out of the joined
        # chain string: with several upstreams the joined form holds multiple
        # "A > B" chains, and splitting on the first ">" would push the remaining
        # chains into the wrong side. Deduped because several sub-apps under one VM
        # commonly resolve to the SAME parent app, which would otherwise repeat.
        $upstreamTo   = (@($hopTo   | Where-Object { $_ } | Select-Object -Unique) -join "; ")

        # Has Upstream Relationship = does the Sub-App/App above the VM have its own upstream?
        if ($anySecondHop)              { $noUpstream = "Yes" }
        elseif ($anySubAppMissingApp)   { $noUpstream = "No - Sub-App has no upstream App, add relationship" }
        else                            { $noUpstream = "N/A - VM upstream is an Application (top of chain)" }

        # Upstream Lifecycle Status: Planned/On order at either hop.
        # "OK" when there ARE app upstreams but none are Planned/On order at either hop.
        # "N/A" stays only for the no-upstream case (handled by the default init above).
        if ($lifecycleHits.Count -gt 0) {
            $lifecycleStatus = ($lifecycleHits | Select-Object -Unique) -join "; "
        }
        else {
            $lifecycleStatus = "OK"
        }
    }
    elseif ($tags.Count -eq 0) {
        $noUpstream    = "No - no CMDB relationship, add"
        $multiUpstream = "No upstream"
    }
    else {
        if ($otherUpstreams.Count -gt 0) {
            $otherCls = @($otherUpstreams | ForEach-Object { Get-FirstFieldValue -Object $_ -Fields $ClassFields } | Select-Object -Unique)
            $noUpstream    = "No - no app/sub-app upstream, add relationship (found only: $($otherCls -join ', '))"
            $multiUpstream = "No app/sub-app upstream (found: $($otherCls -join ', '))"
        }
        else {
            $noUpstream    = "No - no upstream relationship, add"
            $multiUpstream = "No upstream"
        }
    }

    # --- Project placement -------------------------------------------------
    # Reported as two fields: the CI being judged, and the verdict on it.
    # Source is the upstream app when there is one, otherwise the NSX tag - so a VM
    # with no CMDB relationship still gets a placement answer.
    # $AppToProject is a normalised app-name -> project-name index built on the main
    # thread from every project's CAG; $null when $CheckProjectPlacement is off.
    $placementCIs     = @()
    $placementResults = @()

    if ($null -eq $AppToProject) {
        $placementCIs     = @("N/A")
        $placementResults = @("Not checked")
    }
    else {
        # What to judge: upstream app names if present, else the tags themselves
        $placementSubjects = @()
        if ($appUpstreams.Count -gt 0) {
            $placementSubjects = @($appUpstreams | ForEach-Object { $_.UpstreamCIName } | Where-Object { $_ } | Select-Object -Unique)
        }
        else {
            $placementSubjects = @($tags)
        }

        if ($placementSubjects.Count -eq 0) {
            $placementCIs     = @("N/A")
            $placementResults = @("N/A - no app to check")
        }
        else {
            foreach ($subject in $placementSubjects) {
                $sKey = Normalize-AppName $subject
                if (-not $sKey) { continue }

                # Is it in THIS project's catalogue?
                $inOwnCag = $false
                foreach ($a in @($Catalog.Apps))    { if ((Normalize-AppName $a) -eq $sKey) { $inOwnCag = $true; break } }
                if (-not $inOwnCag) {
                    foreach ($a in @($Catalog.SubApps)) { if ((Normalize-AppName $a) -eq $sKey) { $inOwnCag = $true; break } }
                }

                $placementCIs += $subject

                if ($inOwnCag) {
                    $placementResults += "In project CAG"
                }
                else {
                    # $owner may hold several projects when the name is not unique
                    $owner = $AppToProject[$sKey]
                    $ownerList = @($owner) | Where-Object { $_ -and $_ -ne $Vm.ProjectName } | Select-Object -Unique
                    if ($ownerList.Count -gt 0) {
                        $placementResults += "Move VM to project $($ownerList -join ' or ')"
                    }
                    else {
                        $placementResults += "Not in any project CAG, review"
                    }
                }
            }
        }
    }

    $projectPlacementCI     = (@($placementCIs     | Where-Object { $_ }) -join "; ")
    $projectPlacementResult = (@($placementResults | Where-Object { $_ } | Select-Object -Unique) -join "; ")

    # Upstream App Decomm.
    # Second hop: the VM's upstream gives us the app NAME only. Run
    # returnApplicationVms against that name and read ITS status from the log to
    # answer "is the upstream app decommissioned?" - Yes if disposed, else No.
    $decommHits = @()
    foreach ($u in $appUpstreams) {
        if (-not $u.UpstreamCIName) { continue }

        # status already carried on the relationship record
        if ($u.UpstreamCIStatus -match 'dispos|retire|decommission|phased') {
            $decommHits += "$($u.UpstreamCIName): $($u.UpstreamCIStatus)"
            continue
        }

        # otherwise look the app up directly
        $appStat = Get-AppDecommStatus -AppName $u.UpstreamCIName -VraServer $VraServer `
            -AuthToken $AuthToken -ReturnAppVmsUri $ReturnAppVmsUri -Cache $AppStatusCache
        if ($appStat -and $appStat.IsDisposed) {
            $decommHits += "$($u.UpstreamCIName): $($appStat.Disposed -join ', ')"
        }
    }

    # the VM's own CI status still counts
    $ownDecomm = @($ciStatuses | Where-Object { $_ -match 'dispos|retire|decommission|phased' } | Select-Object -Unique)

    if ($decommHits.Count -gt 0) {
        $decomm = "Yes - " + (($decommHits | Select-Object -Unique) -join '; ')
    }
    elseif ($ownDecomm.Count -gt 0) {
        $decomm = "Yes - CI status: " + ($ownDecomm -join '; ')
    }
    elseif ($appUpstreams.Count -eq 0 -and $tags.Count -gt 0) {
        # No upstream at all. If the VM's own CMDB CI is an Application (VM > App)
        # then the chain is wrong - it should be VM > Sub-App > App.
        $vmIsApp = $false
        foreach ($t in $tags) {
            $k = Normalize-AppName $t
            foreach ($a in @($Catalog.Apps)) { if ((Normalize-AppName $a) -eq $k) { $vmIsApp = $true } }
        }
        if ($vmIsApp) {
            $noUpstream = "No - VM linked directly to an Application (VM > App), fix relationship/segment"
        }

        # Direct tag -> CI status lookup.
        # With no upstream there is nothing for the per-upstream decomm loop above to
        # check, so a disposed app whose relationship was REMOVED on decommission
        # would otherwise export "No" - telling the operator to add a relationship to
        # something that was deliberately retired. Query the tagged app itself instead.
        # This is the one place the tag has to be converted into a CMDB key:
        # underscores become spaces (TAG_NAME_HERE -> TAG NAME HERE).
        # Uses the same $AppStatusCache, so a tag shared across many VMs costs one call.
        # NOT VERIFIED: whether returnApplicationVms returns a retrieveCiInfoByKey block
        # for an app that is already disposed. If it returns nothing for those, this
        # check yields nothing and behaviour falls back to the phased-out test below.
        $tagDecommHits = @()
        foreach ($t in $tags) {
            $ciKey = ($t -replace '_', ' ').Trim()
            if (-not $ciKey) { continue }
            try {
                $tagApp = Get-AppDecommStatus -AppName $ciKey -VraServer $VraServer `
                    -AuthToken $AuthToken -ReturnAppVmsUri $ReturnAppVmsUri -Cache $AppStatusCache
                if ($tagApp -and $tagApp.IsDisposed) {
                    $tagDecommHits += "$ciKey : $($tagApp.Disposed -join ', ')"
                }
            }
            catch { }
        }

        # and check whether the tag's app was previously phased out
        $phasedHits = @()
        foreach ($t in $tags) {
            $k = Normalize-AppName $t
            foreach ($p in @($Catalog.PhasedOutApps))    { if ((Normalize-AppName $p) -eq $k) { $phasedHits += "$p (App)" } }
            foreach ($p in @($Catalog.PhasedOutSubApps)) { if ((Normalize-AppName $p) -eq $k) { $phasedHits += "$p (Sub-App)" } }
        }

        # CI status wins over the CAG phased-out flag: it is the authoritative source.
        if ($tagDecommHits.Count -gt 0) {
            $decomm = "Yes - tagged app disposed, relationship removed: " + (($tagDecommHits | Select-Object -Unique) -join '; ')
            $noUpstream = "No upstream - tagged app is disposed, likely decommissioned (no action)"
        }
        elseif ($phasedHits.Count -gt 0) {
            $decomm = "Yes - NSX tag app is phased out: " + (($phasedHits | Select-Object -Unique) -join '; ')
        }
    }

    # --- NSX tag vs CMDB upstream decommission comparison -------------------
    # Answers the two sides independently, then reports whether they agree:
    #   NSX side  - is the app the TAG names disposed / phased out?
    #   CMDB side - is the app the VM's upstream RELATIONSHIP points at disposed?
    # They can disagree, and each disagreement is a different piece of work: a
    # disposed tag on a live app means the tag is stale, a live tag pointing at a
    # disposed app means the relationship is stale.
    # Tag lookups reuse $AppStatusCache, so a tag shared across many VMs is one call.
    $nsxTagDisposed  = $false
    $nsxTagDetail    = @()
    $cmdbDisposed    = ($decommHits.Count -gt 0)
    $cmdbDetail      = @($decommHits | Select-Object -Unique)

    foreach ($t in $tags) {
        # Phased out per the CAG catalogue diff
        $k = Normalize-AppName $t
        foreach ($pp in (@($Catalog.PhasedOutApps) + @($Catalog.PhasedOutSubApps))) {
            if ((Normalize-AppName $pp) -eq $k) { $nsxTagDisposed = $true; $nsxTagDetail += "$t (phased out)" }
        }

        # Disposed per the CI record. Tag -> CMDB key is underscores to spaces.
        $ciKey = ($t -replace '_', ' ').Trim()
        if ($ciKey) {
            try {
                $tagStat = Get-AppDecommStatus -AppName $ciKey -VraServer $VraServer `
                    -AuthToken $AuthToken -ReturnAppVmsUri $ReturnAppVmsUri -Cache $AppStatusCache
                if ($tagStat -and $tagStat.IsDisposed) {
                    $nsxTagDisposed = $true
                    $nsxTagDetail += "$t ($($tagStat.Disposed -join ', '))"
                }
            }
            catch { }
        }
    }
    $nsxTagDetail = @($nsxTagDetail | Select-Object -Unique)

    if ($tags.Count -eq 0) {
        $decommCompare = "No tag to compare"
    }
    elseif ($nsxTagDisposed -and $cmdbDisposed) {
        $decommCompare = "Both disposed - review: NSX $($nsxTagDetail -join '; ') | CMDB $($cmdbDetail -join '; ')"
    }
    elseif ($nsxTagDisposed) {
        $decommCompare = "NSX tag disposed, CMDB good - review: $($nsxTagDetail -join '; ')"
    }
    elseif ($cmdbDisposed) {
        $decommCompare = "NSX good, CMDB upstream disposed - review: $($cmdbDetail -join '; ')"
    }
    else {
        $decommCompare = "Both good"
    }

    # --- Debug dump: raw + parsed data per VM for troubleshooting ---
    if ($DebugPath) {
        $dbg = [ordered]@{
            VMName           = $Vm.VMName
            ProjectName      = $Vm.ProjectName
            Tags             = $tags
            CagApps          = @($Catalog.Apps).Count
            CagSubApps       = @($Catalog.SubApps).Count
            UpstreamCount    = $upstreamCIs.Count
            AppUpstreamCount = $appUpstreams.Count
            AppUpstreams     = @($appUpstreams | ForEach-Object { "$($_.UpstreamCIName) [$(Get-FirstFieldValue -Object $_ -Fields $ClassFields)] status=$($_.UpstreamCIStatus)" })
            OtherUpstreams   = @($otherUpstreams | ForEach-Object { "$($_.UpstreamCIName) [$(Get-FirstFieldValue -Object $_ -Fields $ClassFields)]" })
            UpstreamCIs      = @($upstreamCIs | ForEach-Object {
                @($_.PSObject.Properties | ForEach-Object { "$($_.Name) = $($_.Value)" })
            })
            ClassFieldsRead  = @($upstreamCIs | ForEach-Object { Get-FirstFieldValue -Object $_ -Fields $ClassFields })
            UpstreamStatuses = @($upstreamCIs | ForEach-Object { $_.UpstreamCIStatus })
            CiStatuses       = $ciStatuses
            RawReturnAppVms  = $returnRaws
        }
        "==================== $($Vm.VMName) ====================" | Add-Content -Path $DebugPath -Encoding UTF8
        ($dbg | ConvertTo-Json -Depth 12) | Add-Content -Path $DebugPath -Encoding UTF8
    }

    return [PSCustomObject]@{
        Action                 = $action
        NSXMatchCMDB           = $nsxMatch
        DecommCompare          = $decommCompare
        UpstreamToApp          = $upstreamToApp
        UpstreamTo             = $upstreamTo
        MultipleUpstream       = $multiUpstream
        MultipleUpstreamCI     = $multiUpstreamCI
        NoUpstreamRelationship = $noUpstream
        ProjectPlacementCI     = $projectPlacementCI
        ProjectPlacementResult = $projectPlacementResult
        Decommissioned         = $decomm
        UpstreamLifecycleStatus = $lifecycleStatus
    }
}

if ($ReplayFromCsv) {
    Write-Log "`n=== REPLAY MODE: loading $ReplayCsvPath ===" -Color Cyan
    if (-not (Test-Path -LiteralPath $ReplayCsvPath)) {
        Write-Log "Replay CSV not found: $ReplayCsvPath" -Color Red
        return
    }
    $results = [System.Collections.Generic.List[object]]::new()
    Import-Csv -LiteralPath $ReplayCsvPath | ForEach-Object { $results.Add($_) }
    $vmQueue      = @($results)
    $successCount = @($results).Count
    $failCount    = 0
    $stopwatch    = [System.Diagnostics.Stopwatch]::StartNew()
    Write-Log "Loaded $($results.Count) rows from replay CSV" -Color Green
}
else {

# Fetch all deployments with resources in one pass (size=1000, same as working export script)
Write-Log "`n=== FETCHING DEPLOYMENTS ===" -Color Cyan
$headers = @{
    "Authorization" = "Bearer $authToken"
    "Content-Type" = "application/json"
}

# Build projectId -> projectName map. The deployment API frequently returns
# projectId but a blank projectName, and the vRO actions need projectName.
# Endpoint may differ in your environment - wrapped so a miss can't break the run.
$projectMap = @{}
try {
    $projResp = Invoke-RestMethod -Uri "https://$vraServer/iaas/api/projects?`$top=1000" -Method Get -Headers $headers -TimeoutSec 60
    foreach ($p in @($projResp.content)) { $projectMap[$p.id] = $p.name }
    Write-Log "Loaded $($projectMap.Count) projects for id->name resolution" -Color Green
}
catch {
    Write-Log "Could not load project map: $($_.Exception.Message)" -Color Yellow
}

$vmQueue = [System.Collections.Generic.List[hashtable]]::new()
$seenVMs = [System.Collections.Generic.HashSet[string]]::new()
$page = 0
$size = 200          # smaller pages: expand=resources at size=1000 can drop the connection
$totalProcessed = 0
$deploymentsWithVMs = 0
$skippedCount = 0
$maxRetries = 3

do {
    $uri = "https://$vraServer/deployment/api/deployments?page=$page&size=$size&expand=resources"
    Write-Log " Page $($page + 1)..." -Color Gray

    $response = $null
    for ($attempt = 1; $attempt -le $maxRetries; $attempt++) {
        try {
            $response = Invoke-RestMethod -Uri $uri -Method Get -Headers $headers -TimeoutSec 120
            break
        }
        catch {
            Write-Log "  Page $($page + 1) attempt $attempt failed: $($_.Exception.Message)" -Color Yellow
            if ($attempt -lt $maxRetries) { Start-Sleep -Seconds ($attempt * 3) }
            else { Write-Log "  Giving up on page $($page + 1) after $maxRetries attempts - stopping fetch" -Color Red }
        }
    }
    if (-not $response) { break }   # don't reprocess a stale $response from a prior page

    $deployments = if ($response.content) { $response.content } else { $response }

    $capReached = $false
    foreach ($dep in $deployments) {
        # Skip deleted/failed deployments
        if ($dep.status -and $dep.status -in @("DELETE_SUCCESSFUL", "FAILED", "DELETE_INPROGRESS")) {
            $skippedCount++
            continue
        }

        $machines = @($dep.resources | Where-Object { $_.type -eq "Cloud.vSphere.Machine" })
        if ($machines.Count -eq 0) { continue }

        $addedForThisDep = 0
        foreach ($machine in $machines) {
            # Skip failed or missing VMs
            if ($machine.state -and $machine.state -notin @("OK", "STARTED", "")) { continue }

            $vmName = if ($machine.properties.resourceName) { $machine.properties.resourceName }
                      elseif ($machine.properties.hostname) { $machine.properties.hostname }
                      else { $machine.name }

            # Dedupe: a retried or re-run page can't add the same VM twice
            if (-not $seenVMs.Add("$($dep.name)|$vmName")) { continue }

            $projName = if ($dep.projectName) { $dep.projectName }
                        elseif ($dep.projectId -and $projectMap.ContainsKey($dep.projectId)) { $projectMap[$dep.projectId] }
                        else { "" }

            $vmQueue.Add(@{
                DeploymentName = $dep.name
                VMName = $vmName
                ProjectId = $dep.projectId
                ProjectName = $projName
            })
            $addedForThisDep++
        }

        # Cap counts only deployments that actually contributed VMs
        if ($addedForThisDep -gt 0) {
            $deploymentsWithVMs++
            if ($MaxDeployments -gt 0 -and $deploymentsWithVMs -ge $MaxDeployments) {
                $capReached = $true
                break
            }
        }
    }

    $totalProcessed += $deployments.Count
    $page++
    if ($capReached) {
        Write-Log " Reached $MaxDeployments deployments with VMs - stopping fetch" -Color Yellow
        break
    }
    $hasMore = if ($response.totalPages) {
        $page -lt $response.totalPages
    } elseif ($response.totalElements) {
        $totalProcessed -lt $response.totalElements
    } else {
        $deployments.Count -eq $size
    }
} while ($hasMore)

Write-Log "Scanned: $totalProcessed deployments ($deploymentsWithVMs with VMs, skipped $skippedCount deleted/failed)" -Color Cyan
Write-Log "VMs to process: $($vmQueue.Count)" -Color Cyan

# Scriptblock that runs in each runspace
$scriptBlock = {
    param($VraServer, $AuthToken, $ShowVmDetailsUri, $GetVmAppsUri, $VMName, $ProjectId, $ProjectName, $DeploymentName)

    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    # Compiled policy, not a scriptblock: runspace threads have no default runspace,
    # so a { $true } callback throws and the request fails with "connection was closed".
    if (-not ([System.Management.Automation.PSTypeName]'TrustAllCertsPolicy').Type) {
        Add-Type @"
using System.Net;
using System.Security.Cryptography.X509Certificates;
public class TrustAllCertsPolicy : ICertificatePolicy {
    public bool CheckValidationResult(
        ServicePoint srvPoint, X509Certificate certificate,
        WebRequest request, int certificateProblem) { return true; }
}
"@
    }
    [System.Net.ServicePointManager]::CertificatePolicy = New-Object TrustAllCertsPolicy
    [System.Net.ServicePointManager]::ServerCertificateValidationCallback = $null

    $headers = @{
        "Authorization" = "Bearer $AuthToken"
        "Content-Type" = "application/json"
    }

    $uri = "https://$VraServer/form-service/api/forms/renderer/external-values?projectId=$ProjectId"

    $bodyArray = @(
        @{
            uri = $ShowVmDetailsUri
            dataSource = "scriptAction"
            parameters = @(
                @{ name = "vmName"; value = $VMName }
            )
            useResultsFromRequestId = -1
            fieldType = @{ dataType = "complex" }
            fields = @(
                @{ label = "Scope"; type = @{ dataType = "string" }; id = "scope" },
                @{ label = "Tag"; type = @{ dataType = "string" }; id = "tag" }
            )
            isMultiple = $true
            requestId = 1
        },
        @{
            uri = $GetVmAppsUri
            dataSource = "scriptAction"
            parameters = @(
                @{ name = "vmName"; value = $VMName },
                @{ name = "projectName"; value = $ProjectName }
            )
            useResultsFromRequestId = -1
            fieldType = @{ dataType = "string" }
            isMultiple = $true
            requestId = 2
        }
    )

    $body = "[" + (($bodyArray | ForEach-Object { $_ | ConvertTo-Json -Depth 5 -Compress }) -join ",") + "]"

    try {
        $response = Invoke-RestMethod -Uri $uri -Method Post -Headers $headers -Body $body

        $appApplications = [System.Collections.ArrayList]::new()
        $infraOs = ""
        $appLayer = ""
        $vmApplications = ""

        foreach ($result in $response) {
            switch ($result.requestId) {
                1 {
                    if ($result.data -is [array]) {
                        foreach ($item in $result.data) {
                            if ($item.scope -and $item.tag) {
                                if ($item.scope -eq "app-application") {
                                    [void]$appApplications.Add($item.tag)
                                }
                                elseif ($item.scope -eq "infra-os") {
                                    $infraOs = $item.tag
                                }
                                elseif ($item.scope -eq "app-layer") {
                                    $appLayer = $item.tag
                                }
                            }
                        }
                    }
                }
                2 {
                    if ($result.data -is [array]) {
                        $vmApplications = ($result.data | Where-Object { $_ -and $_ -notmatch "^---" }) -join "; "
                    }
                }
            }
        }

        $appApplication = ($appApplications | Select-Object -Unique) -join "; "

        # Compare each tag against each CMDB CI entry.
        # NON_NSX is a marker meaning the VM isn't NSX-managed - it is not an
        # application name and must never be looked up in CMDB.
        $matchableTags = @($appApplications | Where-Object { $_ -and ($_ -notmatch '^(?i)non[_\s\-]?nsx$') })

        $match = "Missing Data"
        $matchedApps = @()
        if ($matchableTags.Count -gt 0 -and $vmApplications) {
            $ciList = $vmApplications -split ";\s*"
            foreach ($tag in $matchableTags) {
                $normTag = ($tag.ToLower().Trim() -replace '[^a-z0-9]+', '')
                foreach ($ci in $ciList) {
                    $normCI = ($ci.ToLower().Trim() -replace '[^a-z0-9]+', '')
                    if ($normTag -and $normCI -and $normTag -eq $normCI) {
                        $matchedApps += $tag
                        break
                    }
                }
            }
            if ($matchedApps.Count -gt 0) {
                if ($matchableTags.Count -gt 1) {
                    $match = "Match - Multiple Tags"
                } else {
                    $match = "Match"
                }
            } else {
                $match = "Mismatch"
            }
        }

        $matchedAppsStr = ($matchedApps | Select-Object -Unique) -join "; "

        return [PSCustomObject]@{
            DeploymentName = $DeploymentName
            VMName = $VMName
            ProjectName = $ProjectName
            ProjectId = $ProjectId
            AppApplication = $appApplication
            InfraOS = $infraOs
            AppLayer = $appLayer
            CMDBCI = $vmApplications
            CompareResult = $match
            MatchedApps = $matchedAppsStr
            Status = "Success"
        }
    }
    catch {
        return [PSCustomObject]@{
            DeploymentName = $DeploymentName
            VMName = $VMName
            ProjectName = $ProjectName
            ProjectId = $ProjectId
            AppApplication = ""
            InfraOS = ""
            AppLayer = ""
            CMDBCI = ""
            CompareResult = ""
            MatchedApps = ""
            Status = "Failed: $($_.Exception.Message)"
        }
    }
}

# Process with single runspace pool and timeout per job
$poolSize = 30
$jobTimeoutSeconds = 120
Write-Log "`n=== PROCESSING $($vmQueue.Count) VMs ($poolSize parallel threads, ${jobTimeoutSeconds}s timeout) ===" -Color Cyan
$stopwatch = [System.Diagnostics.Stopwatch]::StartNew()

$runspacePool = [System.Management.Automation.Runspaces.RunspaceFactory]::CreateRunspacePool(1, $poolSize)
$runspacePool.Open()

$results = [System.Collections.Generic.List[object]]::new()
$jobs = [System.Collections.Generic.List[object]]::new()
$completed = 0
$successCount = 0
$failCount = 0

# Queue all jobs
foreach ($vm in $vmQueue) {
    $ps = [PowerShell]::Create().AddScript($scriptBlock)
    $ps.AddArgument($vraServer) | Out-Null
    $ps.AddArgument($authToken) | Out-Null
    $ps.AddArgument($showVmDetailsUri) | Out-Null
    $ps.AddArgument($getVmAppsUri) | Out-Null
    $ps.AddArgument($vm.VMName) | Out-Null
    $ps.AddArgument($vm.ProjectId) | Out-Null
    $ps.AddArgument($vm.ProjectName) | Out-Null
    $ps.AddArgument($vm.DeploymentName) | Out-Null
    $ps.RunspacePool = $runspacePool

    $jobs.Add(@{
        PowerShell = $ps
        Handle = $ps.BeginInvoke()
        VMName = $vm.VMName
    })
}

# Collect results with timeout
foreach ($job in $jobs) {
    $completed++
    if ($job.Handle.AsyncWaitHandle.WaitOne($jobTimeoutSeconds * 1000)) {
        $result = $job.PowerShell.EndInvoke($job.Handle)
        if ($result) {
            foreach ($r in $result) {
                if ($r.Status -eq "Success") {
                    $successCount++
                    $matchColor = switch ($r.CompareResult) {
                        "Match" { "Green" }
                        "Mismatch" { "Red" }
                        default { "Gray" }
                    }
                    # Show what was returned for Missing Data so you can see what's empty
                    if ($r.CompareResult -eq "Missing Data") {
                        $tagVal = if ($r.AppApplication) { $r.AppApplication } else { "(empty)" }
                        $appVal = if ($r.CMDBCI) { $r.CMDBCI } else { "(empty)" }
                        Write-Log "[$completed/$($vmQueue.Count)] $($r.VMName) | Tag: $tagVal | CMDB CI: $appVal | Missing Data" -Color Gray
                    }
                    else {
                        Write-Log "[$completed/$($vmQueue.Count)] $($r.VMName) | $($r.AppApplication) | $($r.CompareResult)" -Color $matchColor
                    }
                }
                else {
                    $failCount++
                    Write-Log "[$completed/$($vmQueue.Count)] $($r.VMName) | FAILED - $($r.Status)" -Color Red
                }

                $results.Add([PSCustomObject]@{
                    DeploymentName = [string]$r.DeploymentName
                    VMName = [string]$r.VMName
                    ProjectName = [string]$r.ProjectName
                    ProjectId = [string]$r.ProjectId
                    AppApplication = [string]$r.AppApplication
                    InfraOS = [string]$r.InfraOS
                    AppLayer = [string]$r.AppLayer
                    CMDBCI = [string]$r.CMDBCI
                    CompareResult = [string]$r.CompareResult
                    MatchedApps = [string]$r.MatchedApps
                })
            }
        }
    }
    else {
        $failCount++
        Write-Log "[$completed/$($vmQueue.Count)] $($job.VMName) | TIMEOUT after ${jobTimeoutSeconds}s" -Color Red
        $job.PowerShell.Stop()
    }
    $job.PowerShell.Dispose()
}

if ($runspacePool) { $runspacePool.Close(); $runspacePool.Dispose() }
$stopwatch.Stop()
}

# NSX Fallback - fill in missing AppApplication from NSX VM tags
$missingAppVMs = @($results | Where-Object { -not $_.AppApplication })
if (-not $ReplayFromCsv -and $missingAppVMs.Count -gt 0) {
    Write-Log "`n=== NSX FALLBACK: $($missingAppVMs.Count) VMs with empty AppApplication ===" -Color Cyan

    # NSX Auth functions (from working NSX firewall script)
    function Connect-NSXManagerFallback {
        param(
            [string]$Server,
            [PSCredential]$Credential,
            [string]$AuthMode = "Local",
            [string]$VIDMDomain = ""
        )

        $headers = @{
            "Content-Type" = "application/json"
            "Accept" = "application/json"
        }

        if ($AuthMode -eq "Local") {
            $pair = "{0}:{1}" -f $Credential.UserName, $Credential.GetNetworkCredential().Password
            $bytes = [System.Text.Encoding]::ASCII.GetBytes($pair)
            $base64 = [System.Convert]::ToBase64String($bytes)
            $headers["Authorization"] = "Basic $base64"
            Write-Log " NSX authenticating (Local/Basic)..." -Color Cyan
        }
        else {
            Write-Log " NSX authenticating via vIDM session..." -Color Cyan
            $sessionUri = "https://${Server}/api/session/create"
            $rawUser = $Credential.UserName
            $password = $Credential.GetNetworkCredential().Password

            if ($rawUser -match '^(.+)\\(.+)$') { $samName = $Matches[2] }
            elseif ($rawUser -match '^([^@]+)@') { $samName = $Matches[1] }
            else { $samName = $rawUser }

            $usernamesToTry = @(
                $samName
            )

            $authenticated = $false
            foreach ($username in $usernamesToTry) {
                Write-Log " Trying: $username" -Color Gray
                $body = "j_username=$([uri]::EscapeDataString($username))&j_password=$([uri]::EscapeDataString($password))"
                try {
                    $sessionResponse = Invoke-WebRequest -Uri $sessionUri `
                        -Method Post `
                        -ContentType "application/x-www-form-urlencoded" `
                        -Body $body `
                        -SessionVariable "nsxSession" `
                        -UseBasicParsing `
                        -ErrorAction Stop

                    $xsrfToken = $sessionResponse.Headers["X-XSRF-TOKEN"]
                    if (-not $xsrfToken) {
                        Write-Log " No X-XSRF-TOKEN for '$username', trying next..." -Color Yellow
                        continue
                    }

                    $headers["X-XSRF-TOKEN"] = $xsrfToken
                    $script:NSXFallbackSession = $nsxSession
                    $authenticated = $true
                    Write-Log " NSX authenticated as: $username" -Color Green
                    break
                }
                catch {
                    Write-Log " Failed: $username - $($_.Exception.Message)" -Color Yellow
                    continue
                }
            }

            if (-not $authenticated) {
                throw "NSX vIDM authentication failed for all username formats"
            }
        }

        # Test connectivity
        $testUri = "https://${Server}/policy/api/v1/infra"
        $testParams = @{ Uri = $testUri; Headers = $headers; Method = "Get"; ErrorAction = "Stop" }
        if ($script:NSXFallbackSession) { $testParams["WebSession"] = $script:NSXFallbackSession }
        $null = Invoke-RestMethod @testParams
        Write-Log " NSX connection verified" -Color Green

        return $headers
    }

    # Switch SSL mode for NSX (NSX requires TrustAllCertsPolicy, not ServerCertificateValidationCallback)
    [System.Net.ServicePointManager]::ServerCertificateValidationCallback = $null
    if (-not ([System.Management.Automation.PSTypeName]'TrustAllCertsPolicy').Type) {
        Add-Type @"
using System.Net;
using System.Security.Cryptography.X509Certificates;
public class TrustAllCertsPolicy : ICertificatePolicy {
    public bool CheckValidationResult(
        ServicePoint srvPoint, X509Certificate certificate,
        WebRequest request, int certificateProblem) { return true; }
}
"@
    }
    [System.Net.ServicePointManager]::CertificatePolicy = New-Object TrustAllCertsPolicy

    # Import NSX credentials
    $script:NSXFallbackSession = $null
    if (Test-Path $NSXCredPath) {
        $nsxCred = Import-Clixml -Path $NSXCredPath
        Write-Log " Credentials imported from: $NSXCredPath" -Color Green
    } else {
        $nsxCred = Get-Credential -Message "Enter NSX Manager credentials"
        $credDir = Split-Path $NSXCredPath -Parent
        if (-not (Test-Path $credDir)) { New-Item -ItemType Directory -Path $credDir -Force | Out-Null }
        $nsxCred | Export-Clixml -Path $NSXCredPath
        Write-Log " Credentials saved to: $NSXCredPath" -Color Green
    }

    try {
        $nsxHeaders = Connect-NSXManagerFallback -Server $NSXManager -Credential $nsxCred -AuthMode $NSXAuthMode -VIDMDomain $NSXvIDMDomain
        $nsxFilled = 0

        foreach ($vm in $missingAppVMs) {
            try {
                $nsxUri = "https://${NSXManager}/api/v1/fabric/virtual-machines?display_name=$($vm.VMName)"
                $invokeParams = @{
                    Uri = $nsxUri
                    Headers = $nsxHeaders
                    Method = "Get"
                }
                if ($script:NSXFallbackSession) { $invokeParams["WebSession"] = $script:NSXFallbackSession }
                $nsxResponse = Invoke-RestMethod @invokeParams

                if ($nsxResponse.results -and $nsxResponse.results.Count -gt 0) {
                    $nsxVM = $nsxResponse.results[0]
                    if ($nsxVM.tags) {
                        $nsxAppTags = @()
                        foreach ($tag in $nsxVM.tags) {
                            # Strip ST- prefix from NSX tags for consistency
                            $tagValue = $tag.tag -replace '^ST-', ''
                            switch ($tag.scope) {
                                "app-application" {
                                    $nsxAppTags += $tagValue
                                }
                                "infra-os" {
                                    if (-not $vm.InfraOS) { $vm.InfraOS = $tagValue }
                                }
                                "app-layer" {
                                    if (-not $vm.AppLayer) { $vm.AppLayer = $tagValue }
                                }
                            }
                        }

                        if ($nsxAppTags.Count -gt 0) {
                            $vm.AppApplication = ($nsxAppTags | Select-Object -Unique) -join "; "
                            $nsxFilled++
                            Write-Log " $($vm.VMName) | NSX Tags: $($vm.AppApplication)" -Color Green

                            # Re-run comparison with multiple tags
                            $matchedApps = @()
                            if ($vm.CMDBCI) {
                                $ciList = $vm.CMDBCI -split ";\s*"
                                foreach ($tag in $nsxAppTags) {
                                    $normTag = ($tag.ToLower().Trim() -replace '[^a-z0-9]+', '')
                                    foreach ($ci in $ciList) {
                                        $normCI = ($ci.ToLower().Trim() -replace '[^a-z0-9]+', '')
                                        if ($normTag -and $normCI -and $normTag -eq $normCI) {
                                            $matchedApps += $tag
                                            break
                                        }
                                    }
                                }
                            }

                            if ($matchedApps.Count -gt 0) {
                                if ($nsxAppTags.Count -gt 1) {
                                    $vm.CompareResult = "Match - Multiple Tags"
                                } else {
                                    $vm.CompareResult = "Match"
                                }
                            } else {
                                $vm.CompareResult = "Mismatch"
                            }
                        }
                        else {
                            Write-Log " $($vm.VMName) | No app-application tag in NSX" -Color Gray
                        }
                    }
                }
                else {
                    Write-Log " $($vm.VMName) | Not found in NSX" -Color Gray
                }
            }
            catch {
                Write-Log " $($vm.VMName) | NSX lookup failed: $($_.Exception.Message)" -Color Red
            }
            Start-Sleep -Milliseconds 100
        }

        Write-Log " NSX filled: $nsxFilled / $($missingAppVMs.Count)" -Color Cyan
    }
    catch {
        Write-Log " NSX authentication failed: $($_.Exception.Message)" -Color Red
        Write-Log " Skipping NSX fallback" -Color Yellow
    }
}

# ---------------------------------------------------------------------------
# CMDB Relationship Review phase
# Runs after NSX fallback so AppApplication is as complete as possible.
# Populates the review columns: Action (tag classification), NSXMatchCMDB,
# UpstreamToApp, MultipleUpstream, NoUpstreamRelationship, ProjectPlacement,
# Decommissioned. Runs sequentially or in a runspace pool per $ReviewPoolSize.
# ---------------------------------------------------------------------------
if ($RunReview) {
    Write-Log "`n=== CMDB RELATIONSHIP REVIEW ($($results.Count) VMs) ===" -Color Cyan

    # Ensure the COMPILED cert policy is in force for the review phase.
    # Do NOT revert to a { $true } scriptblock here - the action-log fetch fails with
    # "The underlying connection was closed" when the callback can't find a runspace.
    if (-not ([System.Management.Automation.PSTypeName]'TrustAllCertsPolicy').Type) {
        Add-Type @"
using System.Net;
using System.Security.Cryptography.X509Certificates;
public class TrustAllCertsPolicy : ICertificatePolicy {
    public bool CheckValidationResult(
        ServicePoint srvPoint, X509Certificate certificate,
        WebRequest request, int certificateProblem) { return true; }
}
"@
    }
    [System.Net.ServicePointManager]::CertificatePolicy = New-Object TrustAllCertsPolicy
    [System.Net.ServicePointManager]::ServerCertificateValidationCallback = $null

    # Probe: confirm the /vco/api/actions endpoint responds and see the raw shape
    if ($ProbeVroActions) {
        $probeVm = if ($ProbeVMName) { $results | Where-Object { $_.VMName -eq $ProbeVMName } | Select-Object -First 1 }
                   else { $results | Select-Object -First 1 }
        if ($probeVm) {
            Write-Log " ===== PROBE: $($probeVm.VMName) | project $($probeVm.ProjectName) | tags '$($probeVm.AppApplication)' =====" -Color Yellow

            # 1) getCagApplications - does the catalogue return anything, and how does it parse?
            Write-Log "`n --- getCagApplications (raw) ---" -Color Yellow
            try {
                $cagRaw = Invoke-VroActionRest -VraServer $vraServer -AuthToken $authToken -ActionUri $getCagAppsUri -Parameters @{
                    projectName      = $probeVm.ProjectName
                    phasedOutEnabled = $phasedOutEnabled
                }
                Write-Log ($cagRaw | ConvertTo-Json -Depth 8) -Color Gray
                $cagCat = Get-CagCatalog -RawArray $cagRaw
                Write-Log " Parsed CAG -> Apps: $($cagCat.Apps.Count), SubApps: $($cagCat.SubApps.Count)" -Color Cyan
                Write-Log ("  Apps sample:    " + (($cagCat.Apps    | Select-Object -First 5) -join ' | ')) -Color Gray
                Write-Log ("  SubApps sample: " + (($cagCat.SubApps | Select-Object -First 5) -join ' | ')) -Color Gray
            }
            catch { Write-Log " getCagApplications failed: $($_.Exception.Message)" -Color Red }

            # 2) getVmApplications - raw shape AND the real property names on each object
            Write-Log "`n --- getVmApplications (raw) ---" -Color Yellow
            try {
                $vmRaw = Invoke-VroActionRest -VraServer $vraServer -AuthToken $authToken -ActionUri $getVmAppsUri -Raw -Parameters @{
                    projectName = $probeVm.ProjectName
                    vmName      = $probeVm.VMName
                }
                Write-Log ($vmRaw | ConvertTo-Json -Depth 10) -Color Gray
                $objs = @(Get-VroObjectArray -Response $vmRaw)
                Write-Log " Parsed objects: $($objs.Count)" -Color Cyan
                if ($objs.Count -gt 0) {
                    Write-Log ("  Property names on object[0]: " + (($objs[0].PSObject.Properties.Name) -join ', ')) -Color Green
                    Write-Log ($objs[0] | ConvertTo-Json -Depth 6) -Color Gray
                }
            }
            catch { Write-Log " getVmApplications failed: $($_.Exception.Message)" -Color Red }

            # 3) returnApplicationVms - raw shape for the first tag
            $firstTag = ($probeVm.AppApplication -split ";\s*" | Where-Object { $_ } | Select-Object -First 1)
            if ($firstTag) {
                Write-Log "`n --- returnApplicationVms (raw) for tag '$firstTag' ---" -Color Yellow
                try {
                    $rRaw = Invoke-VroActionRest -VraServer $vraServer -AuthToken $authToken -ActionUri $returnAppVmsUri -Raw -Parameters @{
                        applicationName  = ($firstTag -replace '_', ' ')
                        projectName      = $probeVm.ProjectName
                        vmName           = $probeVm.VMName
                        phasedOutEnabled = $phasedOutEnabled
                    }
                    Write-Log ($rRaw | ConvertTo-Json -Depth 10) -Color Gray
                }
                catch { Write-Log " returnApplicationVms failed: $($_.Exception.Message)" -Color Red }
            }
        }
        Write-Log "`n Probe done - set `$ProbeVroActions = `$false to run the full review." -Color Yellow
        return
    }

    if ($ReviewDebug -and (Test-Path $ReviewDebugPath)) { Remove-Item $ReviewDebugPath -Force }

    $reviewSet = if ($ReviewLimit -gt 0) { @($results | Select-Object -First $ReviewLimit) } else { $results }
    $reviewTotal = @($reviewSet).Count
    if ($ReviewLimit -gt 0) { Write-Log " (limited to first $reviewTotal VMs)" -Color Yellow }

    # --- Pre-build the CAG catalogue per unique project (main thread) ---
    # Far fewer projects than VMs, and it keeps the per-project cache out of the
    # runspaces (each runspace would otherwise have its own empty cache and refetch).
    # ProjectId is required: the external-values endpoint is keyed on it.
    $projectMap = @{}
    foreach ($r in $reviewSet) {
        if ($r.ProjectName -and $r.ProjectId -and -not $projectMap.ContainsKey($r.ProjectName)) {
            $projectMap[$r.ProjectName] = $r.ProjectId
        }
    }
    Write-Log " Pre-loading CAG catalogue for $($projectMap.Count) project(s)..." -Color Gray
    $cagByProject = @{}
    foreach ($pn in $projectMap.Keys) {
        $cagByProject[$pn] = Get-CagForProject -ProjectName $pn -ProjectId $projectMap[$pn] -VraServer $vraServer -AuthToken $authToken -CagUri $getCagAppsUri -PhasedOut $phasedOutEnabled
        $c = $cagByProject[$pn]
        Write-Log ("   {0}: {1} app(s), {2} sub-app(s), {3} phased-out" -f $pn, @($c.Apps).Count, @($c.SubApps).Count, (@($c.PhasedOutApps).Count + @($c.PhasedOutSubApps).Count)) -Color DarkGray
    }
    Write-Log " CAG catalogue ready" -Color Gray

    # --- App -> owning project index (for the Project Placement column) -----
    # To say "move the VM to project X" we need a catalogue for EVERY project, not
    # just the ones in the review set, so any project's CAG list is fetched here once.
    # $appToProject stays $null when the check is off, which makes the review report
    # "Not checked" rather than guessing. $appClass follows the same lifecycle so
    # the tag-classification fallback also stays inert when placement is off.
    $appToProject = $null
    $appClass     = $null
    if ($CheckProjectPlacement) {
        # Full project list. Fetched here rather than reused from the deployment phase
        # because that map is rebuilt as name->id above, and replay mode skips it entirely.
        $allProjects = @{}
        try {
            $allProjResp = Invoke-RestMethod -Uri "https://$vraServer/iaas/api/projects?`$top=1000" -Method Get -Headers @{
                "Authorization" = "Bearer $authToken"
                "Content-Type"  = "application/json"
            } -TimeoutSec 60
            foreach ($p in @($allProjResp.content)) { if ($p.id -and $p.name) { $allProjects[$p.name] = $p.id } }
        }
        catch {
            Write-Log " Could not load full project list for placement check: $($_.Exception.Message)" -Color Yellow
        }

        if ($allProjects.Count -gt 0) {
            $toFetch = @($allProjects.Keys | Where-Object { -not $cagByProject.ContainsKey($_) })
            Write-Log " Project placement: indexing $($allProjects.Count) project(s) ($($toFetch.Count) new CAG fetch(es))..." -Color Gray

            foreach ($pn in $toFetch) {
                try {
                    $cagByProject[$pn] = Get-CagForProject -ProjectName $pn -ProjectId $allProjects[$pn] -VraServer $vraServer -AuthToken $authToken -CagUri $getCagAppsUri -PhasedOut $phasedOutEnabled
                }
                catch {
                    Write-Log "   $pn : CAG fetch failed - $($_.Exception.Message)" -Color Yellow
                }
            }

            # Normalised app name -> list of projects whose CAG contains it.
            # A name can map to several projects; the review reports them all rather
            # than picking one.
            $appToProject = @{}
            # Parallel index: normalised app name -> class ('Application' | 'SubApplication').
            # Used as a fallback for the tag classification when a tag isn't in the VM's
            # OWN project CAG - a Sub-App living in another project should still be
            # classified as Sub-App rather than reported as "Not found in CAG".
            # Sub-App wins when a name appears as both across projects, matching the
            # local per-VM classification preference.
            $appClass = @{}
            foreach ($pn in $cagByProject.Keys) {
                $c = $cagByProject[$pn]
                foreach ($a in (@($c.Apps) + @($c.SubApps))) {
                    if (-not $a) { continue }
                    $k = Normalize-AppName $a
                    if (-not $k) { continue }
                    if ($appToProject.ContainsKey($k)) {
                        if ($appToProject[$k] -notcontains $pn) { $appToProject[$k] = @($appToProject[$k]) + $pn }
                    }
                    else { $appToProject[$k] = @($pn) }
                }
                # Sub-Apps first so an App entry can't overwrite a Sub-App
                foreach ($a in @($c.SubApps)) {
                    if (-not $a) { continue }
                    $k = Normalize-AppName $a
                    if ($k) { $appClass[$k] = 'SubApplication' }
                }
                foreach ($a in @($c.Apps)) {
                    if (-not $a) { continue }
                    $k = Normalize-AppName $a
                    if ($k -and -not $appClass.ContainsKey($k)) { $appClass[$k] = 'Application' }
                }
            }
            Write-Log " Project placement index: $($appToProject.Count) distinct app/sub-app name(s)" -Color Gray
        }
        else {
            Write-Log " Project placement check skipped - no project list available" -Color Yellow
        }
    }

    # Shared across runspaces: app-name -> decommission status. Many VMs share the
    # same upstream app, so this avoids re-running returnApplicationVms per VM.
    $appStatusCache = [hashtable]::Synchronized(@{})

    $reviewed = 0
    $reviewFailed = [System.Collections.Generic.List[object]]::new()

    if ($ReviewPoolSize -le 1) {
        # ---------- Sequential (original behaviour) ----------
        foreach ($vm in $reviewSet) {
            Write-Log " [$($reviewed + 1)/$reviewTotal] $($vm.VMName)..." -Color DarkGray
            $cat = if ($vm.ProjectName -and $cagByProject.ContainsKey($vm.ProjectName)) { $cagByProject[$vm.ProjectName] } else { [PSCustomObject]@{ Apps = @(); SubApps = @() } }
            try {
                $rev = Invoke-CmdbReview -Vm $vm -Catalog $cat -VraServer $vraServer -AuthToken $authToken -GetVmAppsUri $getVmAppsUri -ReturnAppVmsUri $returnAppVmsUri -PhasedOut $phasedOutEnabled -ClassFields $UpstreamClassFields -DebugPath $(if ($ReviewDebug) { $ReviewDebugPath } else { $null }) -UseWorkflowLogs $UseWorkflowLogs -WorkflowId $UpstreamWorkflowId -WfInputVmName $UpstreamWfInputVmName -WfInputProjectName $UpstreamWfInputProjectName -WorkflowWaitSec $WorkflowWaitSec -AppStatusCache $appStatusCache -AppToProject $appToProject -AppClass $appClass
                Add-Member -InputObject $vm -NotePropertyName Action                 -NotePropertyValue $rev.Action                 -Force
                Add-Member -InputObject $vm -NotePropertyName NSXMatchCMDB           -NotePropertyValue $rev.NSXMatchCMDB           -Force
                Add-Member -InputObject $vm -NotePropertyName DecommCompare          -NotePropertyValue $rev.DecommCompare          -Force
                Add-Member -InputObject $vm -NotePropertyName UpstreamToApp          -NotePropertyValue $rev.UpstreamToApp          -Force
                Add-Member -InputObject $vm -NotePropertyName UpstreamTo             -NotePropertyValue $rev.UpstreamTo             -Force
                Add-Member -InputObject $vm -NotePropertyName MultipleUpstream       -NotePropertyValue $rev.MultipleUpstream       -Force
                Add-Member -InputObject $vm -NotePropertyName MultipleUpstreamCI     -NotePropertyValue $rev.MultipleUpstreamCI     -Force
                Add-Member -InputObject $vm -NotePropertyName NoUpstreamRelationship -NotePropertyValue $rev.NoUpstreamRelationship -Force
                Add-Member -InputObject $vm -NotePropertyName ProjectPlacementCI     -NotePropertyValue $rev.ProjectPlacementCI     -Force
                Add-Member -InputObject $vm -NotePropertyName ProjectPlacementResult -NotePropertyValue $rev.ProjectPlacementResult -Force
                Add-Member -InputObject $vm -NotePropertyName Decommissioned         -NotePropertyValue $rev.Decommissioned         -Force
                Add-Member -InputObject $vm -NotePropertyName UpstreamLifecycleStatus -NotePropertyValue $rev.UpstreamLifecycleStatus -Force
            }
            catch {
                $reviewFailed.Add([PSCustomObject]@{ VMName = $vm.VMName; ProjectName = $vm.ProjectName; Error = $_.Exception.Message })
                Write-Log "   FAILED: $($_.Exception.Message)" -Color Red
            }
            $reviewed++
            if ($reviewed % $IncrementalSaveEvery -eq 0) {
                Write-Log " Reviewed $reviewed / $reviewTotal (saving partial)" -Color Gray
                try { $results | Select-Object $exportColumns | Export-Csv -Path $partialCsvPath -NoTypeInformation -Encoding UTF8 } catch { }
            }
        }
    }
    else {
        # ---------- Parallel (runspace pool) ----------
        Write-Log " Running review with $ReviewPoolSize parallel workers..." -Color Cyan

        # Inject the helper functions this phase needs into every runspace
        $fnNames = @(
            'Normalize-AppName','Invoke-VroActionRest','Get-CagCatalog','Get-VroObjectArray',
            'Get-FirstFieldValue','Format-CiClass','Get-VroJson','Get-UpstreamCIs','Get-CiStatuses',
            'Get-JsonBlockFromText','Get-UpstreamCIsFromLog','Get-CiStatusesFromLog',
            'Invoke-VroWorkflowWithLogs','Invoke-VroActionWithLogs','Get-AppDecommStatus','Invoke-CmdbReview'
        )
        $iss = [System.Management.Automation.Runspaces.InitialSessionState]::CreateDefault()
        foreach ($fn in $fnNames) {
            $cmd = Get-Command $fn -ErrorAction SilentlyContinue
            if ($cmd) {
                $iss.Commands.Add(
                    (New-Object System.Management.Automation.Runspaces.SessionStateFunctionEntry($fn, $cmd.Definition))
                )
            }
        }

        $reviewPool = [System.Management.Automation.Runspaces.RunspaceFactory]::CreateRunspacePool(1, $ReviewPoolSize, $iss, $Host)
        $reviewPool.Open()

        # Worker: runs one VM's review and returns the fields + debug text.
        # Debug is RETURNED (not written) so the collector can write it serially -
        # concurrent writes to one file would interleave and corrupt it.
        $reviewBlock = {
            param($Vm, $Catalog, $VraServer, $AuthToken, $GetVmAppsUri, $ReturnAppVmsUri,
                  $PhasedOut, $ClassFields, $WantDebug,
                  $UseWorkflowLogs, $WorkflowId, $WfInputVmName, $WfInputProjectName, $WorkflowWaitSec,
                  $AppStatusCache, $AppToProject, $AppClass)

            [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
            [System.Net.ServicePointManager]::Expect100Continue = $false
            if (-not ([System.Management.Automation.PSTypeName]'TrustAllCertsPolicy').Type) {
                Add-Type @"
using System.Net;
using System.Security.Cryptography.X509Certificates;
public class TrustAllCertsPolicy : ICertificatePolicy {
    public bool CheckValidationResult(
        ServicePoint srvPoint, X509Certificate certificate,
        WebRequest request, int certificateProblem) { return true; }
}
"@
            }
            [System.Net.ServicePointManager]::CertificatePolicy = New-Object TrustAllCertsPolicy
            [System.Net.ServicePointManager]::ServerCertificateValidationCallback = $null

            $tmpDebug = $null
            if ($WantDebug) { $tmpDebug = [System.IO.Path]::GetTempFileName() }

            try {
                $rev = Invoke-CmdbReview -Vm $Vm -Catalog $Catalog -VraServer $VraServer -AuthToken $AuthToken `
                    -GetVmAppsUri $GetVmAppsUri -ReturnAppVmsUri $ReturnAppVmsUri -PhasedOut $PhasedOut `
                    -ClassFields $ClassFields -DebugPath $tmpDebug `
                    -UseWorkflowLogs $UseWorkflowLogs -WorkflowId $WorkflowId `
                    -WfInputVmName $WfInputVmName -WfInputProjectName $WfInputProjectName -WorkflowWaitSec $WorkflowWaitSec `
                    -AppStatusCache $AppStatusCache -AppToProject $AppToProject -AppClass $AppClass

                $dbgText = ""
                if ($tmpDebug -and (Test-Path $tmpDebug)) {
                    $dbgText = Get-Content -Path $tmpDebug -Raw -ErrorAction SilentlyContinue
                    Remove-Item $tmpDebug -Force -ErrorAction SilentlyContinue
                }

                return [PSCustomObject]@{
                    VMName    = $Vm.VMName
                    Review    = $rev
                    DebugText = $dbgText
                    Error     = $null
                }
            }
            catch {
                if ($tmpDebug -and (Test-Path $tmpDebug)) { Remove-Item $tmpDebug -Force -ErrorAction SilentlyContinue }
                return [PSCustomObject]@{
                    VMName    = $Vm.VMName
                    Review    = $null
                    DebugText = ""
                    Error     = $_.Exception.Message
                }
            }
        }

        # Queue every VM
        $reviewJobs = [System.Collections.Generic.List[object]]::new()
        foreach ($vm in $reviewSet) {
            $cat = if ($vm.ProjectName -and $cagByProject.ContainsKey($vm.ProjectName)) { $cagByProject[$vm.ProjectName] } else { [PSCustomObject]@{ Apps = @(); SubApps = @() } }
            $ps = [PowerShell]::Create().AddScript($reviewBlock)
            $ps.AddArgument($vm)                         | Out-Null
            $ps.AddArgument($cat)                        | Out-Null
            $ps.AddArgument($vraServer)                  | Out-Null
            $ps.AddArgument($authToken)                  | Out-Null
            $ps.AddArgument($getVmAppsUri)               | Out-Null
            $ps.AddArgument($returnAppVmsUri)            | Out-Null
            $ps.AddArgument($phasedOutEnabled)           | Out-Null
            $ps.AddArgument($UpstreamClassFields)        | Out-Null
            $ps.AddArgument([bool]$ReviewDebug)          | Out-Null
            $ps.AddArgument($UseWorkflowLogs)            | Out-Null
            $ps.AddArgument($UpstreamWorkflowId)         | Out-Null
            $ps.AddArgument($UpstreamWfInputVmName)      | Out-Null
            $ps.AddArgument($UpstreamWfInputProjectName) | Out-Null
            $ps.AddArgument($WorkflowWaitSec)            | Out-Null
            $ps.AddArgument($appStatusCache)             | Out-Null
            $ps.AddArgument($appToProject)               | Out-Null
            $ps.AddArgument($appClass)                   | Out-Null
            $ps.RunspacePool = $reviewPool
            $reviewJobs.Add(@{ PowerShell = $ps; Handle = $ps.BeginInvoke(); VMName = $vm.VMName; Vm = $vm })
        }

        # Collect in order; write debug + partial CSV serially here
        foreach ($job in $reviewJobs) {
            $out = $null
            try {
                if ($job.Handle.AsyncWaitHandle.WaitOne($ReviewJobTimeoutSec * 1000)) {
                    $out = @($job.PowerShell.EndInvoke($job.Handle))[0]
                }
                else {
                    $job.PowerShell.Stop()
                    $reviewFailed.Add([PSCustomObject]@{ VMName = $job.VMName; ProjectName = $job.Vm.ProjectName; Error = "timeout after ${ReviewJobTimeoutSec}s" })
                    Write-Log " [$($reviewed + 1)/$reviewTotal] $($job.VMName) | TIMEOUT" -Color Red
                }
            }
            catch {
                $reviewFailed.Add([PSCustomObject]@{ VMName = $job.VMName; ProjectName = $job.Vm.ProjectName; Error = $_.Exception.Message })
            }
            finally { $job.PowerShell.Dispose() }

            if ($out -and $out.Review) {
                $vm = $job.Vm; $rev = $out.Review
                Add-Member -InputObject $vm -NotePropertyName Action                 -NotePropertyValue $rev.Action                 -Force
                Add-Member -InputObject $vm -NotePropertyName NSXMatchCMDB           -NotePropertyValue $rev.NSXMatchCMDB           -Force
                Add-Member -InputObject $vm -NotePropertyName DecommCompare          -NotePropertyValue $rev.DecommCompare          -Force
                Add-Member -InputObject $vm -NotePropertyName UpstreamToApp          -NotePropertyValue $rev.UpstreamToApp          -Force
                Add-Member -InputObject $vm -NotePropertyName UpstreamTo             -NotePropertyValue $rev.UpstreamTo             -Force
                Add-Member -InputObject $vm -NotePropertyName MultipleUpstream       -NotePropertyValue $rev.MultipleUpstream       -Force
                Add-Member -InputObject $vm -NotePropertyName MultipleUpstreamCI     -NotePropertyValue $rev.MultipleUpstreamCI     -Force
                Add-Member -InputObject $vm -NotePropertyName NoUpstreamRelationship -NotePropertyValue $rev.NoUpstreamRelationship -Force
                Add-Member -InputObject $vm -NotePropertyName ProjectPlacementCI     -NotePropertyValue $rev.ProjectPlacementCI     -Force
                Add-Member -InputObject $vm -NotePropertyName ProjectPlacementResult -NotePropertyValue $rev.ProjectPlacementResult -Force
                Add-Member -InputObject $vm -NotePropertyName Decommissioned         -NotePropertyValue $rev.Decommissioned         -Force
                Add-Member -InputObject $vm -NotePropertyName UpstreamLifecycleStatus -NotePropertyValue $rev.UpstreamLifecycleStatus -Force

                if ($ReviewDebug -and $out.DebugText) {
                    $out.DebugText | Add-Content -Path $ReviewDebugPath -Encoding UTF8
                }
            }
            elseif ($out -and $out.Error) {
                $reviewFailed.Add([PSCustomObject]@{ VMName = $out.VMName; ProjectName = $job.Vm.ProjectName; Error = $out.Error })
                Write-Log " [$($reviewed + 1)/$reviewTotal] $($out.VMName) | FAILED: $($out.Error)" -Color Red
            }

            $reviewed++
            if ($reviewed % $IncrementalSaveEvery -eq 0) {
                Write-Log " Reviewed $reviewed / $reviewTotal (saving partial)" -Color Gray
                try { $results | Select-Object $exportColumns | Export-Csv -Path $partialCsvPath -NoTypeInformation -Encoding UTF8 } catch { }
            }
        }

        $reviewPool.Close(); $reviewPool.Dispose()
    }

    Write-Log " Review complete: $reviewed VMs" -Color Green
    if ($reviewFailed.Count -gt 0) {
        Write-Log " Review failures: $($reviewFailed.Count) - see $failedCsvPath" -Color Yellow
        try { $reviewFailed | Export-Csv -Path $failedCsvPath -NoTypeInformation -Encoding UTF8 } catch { }
    }
}

# Summary
Write-Log "`n=== SUMMARY ===" -Color Cyan
Write-Log "VMs processed: $($vmQueue.Count)" -Color White
Write-Log "Successful: $successCount" -Color Green
Write-Log "Failed: $failCount" -Color Red
Write-Log "Matches: $(($results | Where-Object { $_.CompareResult -eq 'Match' }).Count)" -Color Green
Write-Log "Match (Multi): $(($results | Where-Object { $_.CompareResult -eq 'Match - Multiple Tags' }).Count)" -Color Green
Write-Log "Mismatches: $(($results | Where-Object { $_.CompareResult -eq 'Mismatch' }).Count)" -Color Red
Write-Log "Missing Data: $(($results | Where-Object { $_.CompareResult -eq 'Missing Data' }).Count)" -Color Gray
Write-Log "Time elapsed: $($stopwatch.Elapsed.ToString('hh\:mm\:ss'))" -Color White

# Normalise typographic characters that mangle in CSV, and repair mojibake.
#
# Two distinct problems are handled here:
#
# 1. FULL mojibake - all the mis-decoded bytes survived, e.g. an en dash (U+2013 =
#    E2 80 93) read as Windows-1252 becomes three characters. Round-tripping the
#    string back through CP1252 -> UTF-8 reverses the mis-decode cleanly.
#
# 2. PARTIAL mojibake - only the lead byte survived, leaving an orphan "a-with-
#    circumflex" with the trailing bytes gone. The round-trip CANNOT recover this
#    (0xE2 alone is not valid UTF-8, so it decodes to the replacement character and
#    the guard correctly rejects the result). These are matched as literal sequences
#    instead. An orphan surrounded by spaces is treated as a dash, which is the
#    overwhelmingly common source, but it IS a guess - the original bytes are gone.
#
# Root cause is upstream: Windows PowerShell's Invoke-RestMethod falls back to
# ISO-8859-1 when a response carries no charset in its Content-Type, so UTF-8 bytes
# are decoded as single-byte characters before this function ever sees them.
# Repairing here is a workaround, not a fix at source.
function ConvertTo-CleanText {
    param($s)
    if ($null -eq $s) { return $s }
    $s = [string]$s

    # --- 1. Round-trip repair ----------------------------------------------
    # Windows PowerShell's Invoke-RestMethod falls back to ISO-8859-1 (Latin-1) when
    # a response carries no charset in its Content-Type, so UTF-8 bytes arrive decoded
    # one byte per character. An en dash (E2 80 93) becomes three characters:
    # a-circumflex plus TWO C1 CONTROL characters, which render as nothing in Excel -
    # so the cell LOOKS like a lone a-circumflex when the bytes are all still present.
    #
    # Latin-1 is tried FIRST because it is the actual PowerShell default and is a
    # straight 1:1 byte mapping, so it can always re-encode what it decoded. CP1252
    # is tried second for data that came through a CP1252 path instead; it cannot
    # represent the C1 controls, so it must not be tried first.
    # A repair is kept only when it parses as valid UTF-8 and yields no replacement
    # character - otherwise the original string is left untouched.
    if ($s -match "[$([char]0x0080)-$([char]0x009F)$([char]0x00E2)$([char]0x00C2)$([char]0x20AC)]") {
        foreach ($cp in @(28591, 1252)) {
            try {
                $enc      = [Text.Encoding]::GetEncoding($cp, [Text.EncoderFallback]::ExceptionFallback, [Text.DecoderFallback]::ExceptionFallback)
                $bytes    = $enc.GetBytes($s)
                $strictU8 = [Text.Encoding]::GetEncoding('utf-8', [Text.EncoderFallback]::ExceptionFallback, [Text.DecoderFallback]::ExceptionFallback)
                $repaired = $strictU8.GetString($bytes)
                if ($repaired -notmatch [char]0xFFFD) { $s = $repaired; break }
            }
            catch { continue }   # not encodable in this codepage, or not valid UTF-8
        }
    }

    # --- 2. Literal mojibake sequences -------------------------------------
    # Fallback for strings the round-trip could not repair. Each key is what the
    # UTF-8 encoding of that character looks like after a CP1252 mis-decode.
    $map = [ordered]@{
        "$([char]0x00E2)$([char]0x20AC)$([char]0x201C)" = '-'    # en dash   U+2013
        "$([char]0x00E2)$([char]0x20AC)$([char]0x201D)" = '-'    # em dash   U+2014
        "$([char]0x00E2)$([char]0x20AC)$([char]0x02DC)" = "'"    # open quote  U+2018
        "$([char]0x00E2)$([char]0x20AC)$([char]0x2122)" = "'"    # close quote U+2019
        "$([char]0x00E2)$([char]0x20AC)$([char]0x0153)" = '"'    # open dquote U+201C
        "$([char]0x00E2)$([char]0x20AC)$([char]0x00A6)" = '...'  # ellipsis  U+2026
        "$([char]0x00C2)$([char]0x00A0)"                = ' '    # NBSP      U+00A0
    }
    foreach ($k in $map.Keys) { $s = $s.Replace($k, $map[$k]) }

    # --- 3. Latin-1 form that survived an unrepairable round-trip -----------
    # a-circumflex followed by the C1 controls for an en/em dash.
    $s = $s -replace "$([char]0x00E2)[$([char]0x0080)-$([char]0x009F)][$([char]0x0080)-$([char]0x009F)]", '-'
    # Any remaining C1 control characters are never legitimate in a CI name.
    $s = $s -replace "[$([char]0x0080)-$([char]0x009F)]", ''

    # --- 4. Typographic characters to plain ASCII --------------------------
    $s = $s -replace [char]0x2013, '-' -replace [char]0x2014, '-'
    $s = $s -replace [char]0x00A0, ' '
    $s = $s -replace [char]0x2018, "'" -replace [char]0x2019, "'"
    $s = $s -replace [char]0x201C, '"' -replace [char]0x201D, '"'
    $s = $s -replace [char]0xFFFD, ''

    # Collapse any double spacing the substitutions introduced
    $s = $s -replace '  +', ' '
    return $s.Trim()
}

# Export results (CompareResult kept internal for console/summary; CSV uses NSXMatchCMDB)
foreach ($r in $results) {
    foreach ($p in $r.PSObject.Properties) {
        if ($p.Value -is [string]) { $p.Value = ConvertTo-CleanText $p.Value }
    }
}
$resultsPath = "$resultsDir\CMDBRelations_$(Get-Date -Format 'yyyyMMdd_HHmmss').csv"
$results | Select-Object $exportColumns | Export-Csv -Path $resultsPath -NoTypeInformation -Encoding UTF8
Write-Log "`nResults saved: $resultsPath" -Color White

# Email report
if ($SendEmail) {
    Write-Log "`n=== SENDING EMAIL ===" -Color Cyan

    $matchCount = @($results | Where-Object { $_.CompareResult -eq 'Match' }).Count
    $matchMultiCount = @($results | Where-Object { $_.CompareResult -eq 'Match - Multiple Tags' }).Count
    $mismatchCount = @($results | Where-Object { $_.CompareResult -eq 'Mismatch' }).Count
    $missingCount = @($results | Where-Object { $_.CompareResult -eq 'Missing Data' }).Count
    $totalVMs = @($results).Count
    $generatedAt = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'

    $emailBody = "<html>"
    $emailBody += "<body style='font-family: Segoe UI, Arial, sans-serif; color: #333;'>"
    $emailBody += "<h2 style='color: #2c3e50;'>CMDB Relations Comparison Report</h2>"
    $emailBody += "<p>Generated: $generatedAt</p>"
    $emailBody += "<h3 style='color: #2c3e50;'>Summary</h3>"
    $emailBody += "<table style='border-collapse:collapse; margin-bottom:20px;'>"
    $emailBody += "<tr style='background:#2c3e50; color:white;'>"
    $emailBody += "<th style='padding:8px 16px; border:1px solid #ddd; text-align:left;'>Category</th>"
    $emailBody += "<th style='padding:8px 16px; border:1px solid #ddd; text-align:right;'>Count</th>"
    $emailBody += "</tr>"
    $emailBody += "<tr style='background:#e8f5e9;'>"
    $emailBody += "<td style='padding:6px 16px; border:1px solid #ddd;'>Match</td>"
    $emailBody += "<td style='padding:6px 16px; border:1px solid #ddd; text-align:right; color:green; font-weight:bold;'>$matchCount</td>"
    $emailBody += "</tr>"
    $emailBody += "<tr style='background:#e8f5e9;'>"
    $emailBody += "<td style='padding:6px 16px; border:1px solid #ddd;'>Match - Multiple Tags</td>"
    $emailBody += "<td style='padding:6px 16px; border:1px solid #ddd; text-align:right; color:green; font-weight:bold;'>$matchMultiCount</td>"
    $emailBody += "</tr>"
    $emailBody += "<tr style='background:#ffebee;'>"
    $emailBody += "<td style='padding:6px 16px; border:1px solid #ddd;'>Mismatch</td>"
    $emailBody += "<td style='padding:6px 16px; border:1px solid #ddd; text-align:right; color:red; font-weight:bold;'>$mismatchCount</td>"
    $emailBody += "</tr>"
    $emailBody += "<tr style='background:#f5f5f5;'>"
    $emailBody += "<td style='padding:6px 16px; border:1px solid #ddd;'>Missing Data</td>"
    $emailBody += "<td style='padding:6px 16px; border:1px solid #ddd; text-align:right; color:gray; font-weight:bold;'>$missingCount</td>"
    $emailBody += "</tr>"
    $emailBody += "<tr style='background:#e3f2fd;'>"
    $emailBody += "<td style='padding:6px 16px; border:1px solid #ddd; font-weight:bold;'>Total VMs</td>"
    $emailBody += "<td style='padding:6px 16px; border:1px solid #ddd; text-align:right; font-weight:bold;'>$totalVMs</td>"
    $emailBody += "</tr>"
    $emailBody += "</table>"
    $emailBody += "</body></html>"

    try {
        # Reset SSL policies so they don't interfere with SMTP TLS
        [System.Net.ServicePointManager]::ServerCertificateValidationCallback = $null
        [System.Net.ServicePointManager]::CertificatePolicy = $null

        $emailParams = @{
            To = $EmailTo
            From = $EmailFrom
            Subject = $EmailSubject
            Body = $emailBody
            BodyAsHtml = $true
            SmtpServer = $SMTPServer
            Port = $SMTPPort
            UseSsl = $UseSSL
            Attachments = $resultsPath
        }
        Send-MailMessage @emailParams
        Write-Log "Email sent to $EmailTo" -Color Green

        # Clean up CSV after sending
        if (Test-Path $resultsPath) {
            Remove-Item -Path $resultsPath -Force
            Write-Log "CSV cleaned up" -Color Gray
        }
    }
    catch {
        Write-Log "Failed to send email: $($_.Exception.Message)" -Color Red
        Write-Log "CSV retained: $resultsPath" -Color Yellow
    }
}
