# ================================================================
# VMware Aria Automation - Bulk CMDB Relations Extractor + Review
#
# Phase 1 (parallel, runspace pool - via form-service external-values):
#   showVmDetails       -> NSX scope/tag per VM
#   getVmApplications   -> CMDB CI list per VM (NSX-vs-CMDB match)
#
# Phase 2 (per unique VM, serial - via /vco/api/actions REST):
#   getVmApplications   -> called again to capture LOG output, which
#                          carries retrieveCIRelationshipInfoByKey with
#                          upstreamCIs[] and downstreamCIs[].
#   getCagApplications  -> classify tag as App vs Sub-App
#
# Six review columns appended per VM row:
#   NSXMatchCMDB, AppOrSubApp, UpstreamToApp, MultipleUpstream,
#   NoUpstreamRelationship, Upstream App Decomm
# CompareResult is kept internal (not exported).
#
# Encoding: Export-Csv -Encoding UTF8; text normalised via
# ConvertTo-CleanText to strip smart quotes / em-dash / NBSP.
# ================================================================

# ============================ CONFIG ============================
$vraServer  = "<vra-server-fqdn>"
$resultsDir = "C:\Logs"

# vRO action URIs (module/name form)
$showVmDetailsUri = "<module>/showVmDetails"
$getVmAppsUri     = "<module>/getVmApplications"
$getCagAppsUri    = "<module>/getCagApplications"

# NSX Manager (fallback for VMs with empty AppApplication)
$NSXManager    = "<nsx-manager-fqdn>"
$NSXAuthMode   = "vIDM"          # "Local" or "vIDM"
$NSXvIDMDomain = "<domain>"
$NSXCredPath   = "C:\Scripts\Creds\nsx_cred.xml"

# Email
$SendEmail    = $true
$EmailTo      = "<recipient@company>"
$EmailFrom    = "<sender@company>"
$EmailSubject = "CMDB Relations Comparison Report - $(Get-Date -Format 'yyyy-MM-dd')"
$SMTPServer   = "<smtp-server>"
$SMTPPort     = 465
$UseSSL       = $true

# Runspace tuning (Phase 1)
$PoolSize          = 30
$JobTimeoutSeconds = 120

# Review-phase debug
$ReviewDebugPath = Join-Path $resultsDir "review_debug.txt"
# ================================================================


function Write-Log {
    param($Message, $Color = "White")
    Write-Host $Message -ForegroundColor $Color
}


# ---------------- Helpers ----------------

function Normalize-AppName {
    param($Name)
    if (-not $Name) { return "" }
    return ($Name.ToLower().Trim() -replace '[_\s\-\.]+', '')
}


function ConvertTo-CleanText {
    # Normalise typographic chars (em/en dash, NBSP, curly quotes) to ASCII.
    param([string]$Text)
    if (-not $Text) { return $Text }
    $map = @{
        [char]0x2013 = '-'
        [char]0x2014 = '-'
        [char]0x2018 = "'"
        [char]0x2019 = "'"
        [char]0x201C = '"'
        [char]0x201D = '"'
        [char]0x00A0 = ' '
        [char]0x2026 = '...'
    }
    $sb = [System.Text.StringBuilder]::new($Text.Length)
    foreach ($ch in $Text.ToCharArray()) {
        if ($map.ContainsKey($ch)) { [void]$sb.Append($map[$ch]) }
        else                       { [void]$sb.Append($ch) }
    }
    return $sb.ToString()
}


function Get-JsonBlockFromText {
    # Brace-matched JSON block extractor.
    param(
        [Parameter(Mandatory)][string]$Text,
        [Parameter(Mandatory)][string]$Key
    )
    $pattern = '"' + [regex]::Escape($Key) + '"\s*:\s*\{'
    $m = [regex]::Match($Text, $pattern)
    if (-not $m.Success) { return $null }

    $start = $m.Index + $m.Length - 1
    $depth = 0
    for ($i = $start; $i -lt $Text.Length; $i++) {
        $c = $Text[$i]
        if     ($c -eq '{') { $depth++ }
        elseif ($c -eq '}') {
            $depth--
            if ($depth -eq 0) { return $Text.Substring($start, $i - $start + 1) }
        }
    }
    return $null
}


function Get-UpstreamCIsFromLog {
    # Extract upstreamCIs[] from retrieveCIRelationshipInfoByKey block in log text.
    param([string]$LogText)
    $out = [System.Collections.Generic.List[object]]::new()
    if (-not $LogText) { return ,$out }

    $block = Get-JsonBlockFromText -Text $LogText -Key 'retrieveCIRelationshipInfoByKey'
    if (-not $block) { return ,$out }

    try { $obj = $block | ConvertFrom-Json -ErrorAction Stop }
    catch { return ,$out }

    $upstream = if     ($obj.upstreamCIs) { $obj.upstreamCIs }
                elseif ($obj.UpstreamCIs) { $obj.UpstreamCIs }
                else                      { $null }
    if (-not $upstream) { return ,$out }

    foreach ($u in @($upstream)) {
        $out.Add([PSCustomObject]@{
            UpstreamCIID                = [string]$u.UpstreamCIID
            UpstreamCIName              = [string]$u.UpstreamCIName
            UpstreamCICMSClass          = [string]$u.UpstreamCICMSClass
            UpstreamCIType              = [string]$u.UpstreamCIType
            UpstreamCISubtype           = [string]$u.UpstreamCISubtype
            UpstreamCIStatus            = [string]$u.UpstreamCIStatus
            UpstreamRelationshipSubtype = [string]$u.UpstreamRelationshipSubtype
        })
    }
    return ,$out
}


function Invoke-VroActionWithLogs {
    # POST /vco/api/actions/{module}/{name}/executions, capture execId,
    # then GET /syslogs then /logs.
    # Returns @{ ReturnBody; LogText; ExecId; LogEndpoint; LogChars }
    param(
        [Parameter(Mandatory)][string]$Server,
        [Parameter(Mandatory)][string]$ActionUri,   # "<module>/<name>"
        [Parameter(Mandatory)][hashtable]$Headers,
        [Parameter(Mandatory)][hashtable]$Inputs    # key = param name, value = string
    )

    $parts = $ActionUri -split "/"
    if ($parts.Count -ne 2) { throw "ActionUri must be '<module>/<name>' - got '$ActionUri'" }
    $module = $parts[0]; $name = $parts[1]
    $execUri = "https://$Server/vco/api/actions/$module/$name/executions"

    $paramList = @()
    foreach ($k in $Inputs.Keys) {
        $paramList += @{
            name  = $k
            type  = "string"
            value = @{ string = @{ value = [string]$Inputs[$k] } }
        }
    }
    $body = @{ parameters = $paramList } | ConvertTo-Json -Depth 10

    $execId = $null
    $returnBody = ""
    try {
        $r = Invoke-WebRequest -Uri $execUri -Method Post -Headers $Headers -Body $body -UseBasicParsing
        $returnBody = $r.Content
        if ($r.Headers["Location"]) { $execId = ($r.Headers["Location"] -split "/")[-1] }
        if (-not $execId -and $r.Content) {
            try { $b = $r.Content | ConvertFrom-Json; if ($b.id) { $execId = $b.id } } catch { }
        }
    } catch {
        return @{ ReturnBody=""; LogText=""; ExecId=$null; LogEndpoint="none"; LogChars=0; Error=$_.Exception.Message }
    }

    if (-not $execId) {
        return @{ ReturnBody=$returnBody; LogText=""; ExecId=$null; LogEndpoint="none"; LogChars=0 }
    }

    Start-Sleep -Milliseconds 1500

    $endpoints = @( "$execUri/$execId/syslogs", "$execUri/$execId/logs" )
    $logText = ""; $hit = "none"
    foreach ($ep in $endpoints) {
        try {
            $lr = Invoke-WebRequest -Uri $ep -Method Get -Headers $Headers -UseBasicParsing
            if ($lr.Content -and $lr.Content.Length -gt 0) {
                $logText = $lr.Content
                $hit = $ep
                break
            }
        } catch { }
    }

    return @{
        ReturnBody  = $returnBody
        LogText     = $logText
        ExecId      = $execId
        LogEndpoint = $hit
        LogChars    = $logText.Length
    }
}


# --------- TLS / cert bypass ---------
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
[System.Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }


# ---------------- AUTH ----------------
Write-Log "=== AUTHENTICATION ===" -Color Cyan
$credential = Get-Credential -Message "Enter VMware Aria Automation credentials"
$authBody = @{
    username = $credential.UserName
    password = $credential.GetNetworkCredential().Password
} | ConvertTo-Json
$authResponse = Invoke-RestMethod -Uri "https://$vraServer/csp/gateway/am/api/login" `
    -Method Post -Headers @{ "Content-Type" = "application/json" } -Body $authBody
$authToken = $authResponse.cspAuthToken
Write-Log "Authentication successful!" -Color Green

$vroHeaders = @{
    "Authorization" = "Bearer $authToken"
    "Content-Type"  = "application/json"
    "Accept"        = "application/json"
}


# --------- Project ID -> Name map ---------
Write-Log "`n=== BUILDING PROJECT MAP ===" -Color Cyan
$projectMap = @{}
try {
    $projResp = Invoke-RestMethod -Uri "https://$vraServer/iaas/api/projects?`$top=1000" `
        -Method Get -Headers $vroHeaders
    $projList = if ($projResp.content) { $projResp.content } else { $projResp }
    foreach ($p in $projList) {
        if ($p.id -and $p.name) { $projectMap[$p.id] = $p.name }
    }
    Write-Log "  Cached $($projectMap.Count) project(s)" -Color Green
} catch {
    Write-Log "  Project map failed: $($_.Exception.Message) (continuing with deployment.projectName only)" -Color Yellow
}


# --------- Fetch deployments ---------
Write-Log "`n=== FETCHING DEPLOYMENTS ===" -Color Cyan
$vmQueue = [System.Collections.Generic.List[hashtable]]::new()
$page = 0
$size = 1000
$totalProcessed = 0
$skippedCount = 0

do {
    $uri = "https://$vraServer/deployment/api/deployments?page=$page&size=$size&expand=resources"
    Write-Log "  Page $($page + 1)..." -Color Gray
    $response = Invoke-RestMethod -Uri $uri -Method Get -Headers $vroHeaders
    $deployments = if ($response.content) { $response.content } else { $response }

    foreach ($dep in $deployments) {
        if ($dep.status -and $dep.status -in @("DELETE_SUCCESSFUL","FAILED","DELETE_INPROGRESS")) {
            $skippedCount++; continue
        }
        $machines = @($dep.resources | Where-Object { $_.type -eq "Cloud.vSphere.Machine" })
        if ($machines.Count -eq 0) { continue }

        $projName = $dep.projectName
        if (-not $projName -and $dep.projectId -and $projectMap.ContainsKey($dep.projectId)) {
            $projName = $projectMap[$dep.projectId]
        }

        foreach ($machine in $machines) {
            if ($machine.state -and $machine.state -notin @("OK","STARTED","")) { continue }

            $vmName = if ($machine.properties.resourceName) { $machine.properties.resourceName }
                      elseif ($machine.properties.hostname) { $machine.properties.hostname }
                      else { $machine.name }

            $vmQueue.Add(@{
                DeploymentName = $dep.name
                VMName         = $vmName
                ProjectId      = $dep.projectId
                ProjectName    = $projName
            })
        }
    }

    $totalProcessed += $deployments.Count
    $page++
    $hasMore = if ($response.totalPages) { $page -lt $response.totalPages }
               elseif ($response.totalElements) { $totalProcessed -lt $response.totalElements }
               else { $deployments.Count -eq $size }
} while ($hasMore)

Write-Log "Scanned: $totalProcessed deployments (skipped $skippedCount deleted/failed)" -Color Cyan
Write-Log "VMs to process: $($vmQueue.Count)" -Color Cyan


# ---------------- Phase 1: parallel runspace pool ----------------
$scriptBlock = {
    param($VraServer, $AuthToken, $ShowVmDetailsUri, $GetVmAppsUri,
          $VMName, $ProjectId, $ProjectName, $DeploymentName)

    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    [System.Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }

    $headers = @{
        "Authorization" = "Bearer $AuthToken"
        "Content-Type"  = "application/json"
    }
    $uri = "https://$VraServer/form-service/api/forms/renderer/external-values?projectId=$ProjectId"

    $bodyArray = @(
        @{
            uri         = $ShowVmDetailsUri
            dataSource  = "scriptAction"
            parameters  = @( @{ name = "vmName"; value = $VMName } )
            useResultsFromRequestId = -1
            fieldType   = @{ dataType = "complex" }
            fields      = @(
                @{ label = "Scope"; type = @{ dataType = "string" }; id = "scope" },
                @{ label = "Tag";   type = @{ dataType = "string" }; id = "tag" }
            )
            isMultiple  = $true
            requestId   = 1
        },
        @{
            uri         = $GetVmAppsUri
            dataSource  = "scriptAction"
            parameters  = @(
                @{ name = "vmName";      value = $VMName },
                @{ name = "projectName"; value = $ProjectName }
            )
            useResultsFromRequestId = -1
            fieldType   = @{ dataType = "string" }
            isMultiple  = $true
            requestId   = 2
        }
    )
    $body = "[" + (($bodyArray | ForEach-Object { $_ | ConvertTo-Json -Depth 5 -Compress }) -join ",") + "]"

    try {
        $response = Invoke-RestMethod -Uri $uri -Method Post -Headers $headers -Body $body

        $appApplications = [System.Collections.ArrayList]::new()
        $infraOs = ""; $appLayer = ""; $vmApplications = ""

        foreach ($result in $response) {
            switch ($result.requestId) {
                1 {
                    if ($result.data -is [array]) {
                        foreach ($item in $result.data) {
                            if ($item.scope -and $item.tag) {
                                switch ($item.scope) {
                                    "app-application" { [void]$appApplications.Add($item.tag) }
                                    "infra-os"        { $infraOs  = $item.tag }
                                    "app-layer"       { $appLayer = $item.tag }
                                }
                            }
                        }
                    }
                }
                2 {
                    if ($result.data -is [array]) {
                        $vmApplications = ($result.data | Where-Object { $_ -and $_ -notmatch "^---" }) -join "; "
                    }
                }
            }
        }

        $appApplication = ($appApplications | Select-Object -Unique) -join "; "

        $match = "Missing Data"; $matchedApps = @()
        if ($appApplications.Count -gt 0 -and $vmApplications) {
            $ciList = $vmApplications -split ";\s*"
            foreach ($tag in $appApplications) {
                $normTag = ($tag.ToLower().Trim() -replace '[_\s\-\.]+', '')
                foreach ($ci in $ciList) {
                    $normCI = ($ci.ToLower().Trim() -replace '[_\s\-\.]+', '')
                    if ($normTag -and $normCI -and $normTag -eq $normCI) { $matchedApps += $tag; break }
                }
            }
            if ($matchedApps.Count -gt 0) {
                $match = if ($appApplications.Count -gt 1) { "Match - Multiple Tags" } else { "Match" }
            } else { $match = "Mismatch" }
        }

        return [PSCustomObject]@{
            DeploymentName = $DeploymentName
            VMName         = $VMName
            ProjectId      = $ProjectId
            ProjectName    = $ProjectName
            AppApplication = $appApplication
            InfraOS        = $infraOs
            AppLayer       = $appLayer
            CMDBCI         = $vmApplications
            CompareResult  = $match
            Status         = "Success"
        }
    }
    catch {
        return [PSCustomObject]@{
            DeploymentName = $DeploymentName
            VMName         = $VMName
            ProjectId      = $ProjectId
            ProjectName    = $ProjectName
            AppApplication = ""
            InfraOS        = ""
            AppLayer       = ""
            CMDBCI         = ""
            CompareResult  = ""
            Status         = "Failed: $($_.Exception.Message)"
        }
    }
}

Write-Log "`n=== PHASE 1: $($vmQueue.Count) VMs ($PoolSize parallel, ${JobTimeoutSeconds}s timeout) ===" -Color Cyan
$stopwatch = [System.Diagnostics.Stopwatch]::StartNew()

$runspacePool = [System.Management.Automation.Runspaces.RunspaceFactory]::CreateRunspacePool(1, $PoolSize)
$runspacePool.Open()

$results      = [System.Collections.Generic.List[object]]::new()
$jobs         = [System.Collections.Generic.List[object]]::new()
$completed    = 0
$successCount = 0
$failCount    = 0

foreach ($vm in $vmQueue) {
    $ps = [PowerShell]::Create().AddScript($scriptBlock)
    $ps.AddArgument($vraServer)         | Out-Null
    $ps.AddArgument($authToken)         | Out-Null
    $ps.AddArgument($showVmDetailsUri)  | Out-Null
    $ps.AddArgument($getVmAppsUri)      | Out-Null
    $ps.AddArgument($vm.VMName)         | Out-Null
    $ps.AddArgument($vm.ProjectId)      | Out-Null
    $ps.AddArgument($vm.ProjectName)    | Out-Null
    $ps.AddArgument($vm.DeploymentName) | Out-Null
    $ps.RunspacePool = $runspacePool
    $jobs.Add(@{ PowerShell = $ps; Handle = $ps.BeginInvoke(); VMName = $vm.VMName })
}

foreach ($job in $jobs) {
    $completed++
    if ($job.Handle.AsyncWaitHandle.WaitOne($JobTimeoutSeconds * 1000)) {
        $result = $job.PowerShell.EndInvoke($job.Handle)
        if ($result) {
            foreach ($r in $result) {
                if ($r.Status -eq "Success") {
                    $successCount++
                    $matchColor = switch ($r.CompareResult) {
                        "Match"                  { "Green" }
                        "Match - Multiple Tags"  { "Green" }
                        "Mismatch"               { "Red" }
                        default                  { "Gray" }
                    }
                    Write-Log "[$completed/$($vmQueue.Count)] $($r.VMName) | $($r.AppApplication) | $($r.CompareResult)" -Color $matchColor
                } else {
                    $failCount++
                    Write-Log "[$completed/$($vmQueue.Count)] $($r.VMName) | FAILED - $($r.Status)" -Color Red
                }

                $results.Add([PSCustomObject]@{
                    DeploymentName = [string]$r.DeploymentName
                    VMName         = [string]$r.VMName
                    ProjectId      = [string]$r.ProjectId
                    ProjectName    = [string]$r.ProjectName
                    AppApplication = [string]$r.AppApplication
                    InfraOS        = [string]$r.InfraOS
                    AppLayer       = [string]$r.AppLayer
                    CMDBCI         = [string]$r.CMDBCI
                    CompareResult  = [string]$r.CompareResult
                })
            }
        }
    } else {
        $failCount++
        Write-Log "[$completed/$($vmQueue.Count)] $($job.VMName) | TIMEOUT after ${JobTimeoutSeconds}s" -Color Red
        $job.PowerShell.Stop()
    }
    $job.PowerShell.Dispose()
}

if ($runspacePool) { $runspacePool.Close(); $runspacePool.Dispose() }
$stopwatch.Stop()


# ---------------- NSX FALLBACK ----------------
$missingAppVMs = @($results | Where-Object { -not $_.AppApplication })
if ($missingAppVMs.Count -gt 0) {
    Write-Log "`n=== NSX FALLBACK: $($missingAppVMs.Count) VMs with empty AppApplication ===" -Color Cyan

    function Connect-NSXManagerFallback {
        param([string]$Server, [PSCredential]$Credential,
              [string]$AuthMode = "Local", [string]$VIDMDomain = "")
        $headers = @{ "Content-Type" = "application/json"; "Accept" = "application/json" }

        if ($AuthMode -eq "Local") {
            $pair = "{0}:{1}" -f $Credential.UserName, $Credential.GetNetworkCredential().Password
            $bytes = [System.Text.Encoding]::ASCII.GetBytes($pair)
            $headers["Authorization"] = "Basic " + [System.Convert]::ToBase64String($bytes)
            Write-Log "  NSX authenticating (Local/Basic)..." -Color Cyan
        } else {
            Write-Log "  NSX authenticating via vIDM session..." -Color Cyan
            $sessionUri = "https://${Server}/api/session/create"
            $rawUser = $Credential.UserName
            $password = $Credential.GetNetworkCredential().Password
            if ($rawUser -match '^(.+)\\(.+)$')  { $samName = $Matches[2] }
            elseif ($rawUser -match '^([^@]+)@') { $samName = $Matches[1] }
            else { $samName = $rawUser }

            $body = "j_username=$([uri]::EscapeDataString($samName))&j_password=$([uri]::EscapeDataString($password))"
            $sessionResponse = Invoke-WebRequest -Uri $sessionUri -Method Post `
                -ContentType "application/x-www-form-urlencoded" -Body $body `
                -SessionVariable "nsxSession" -UseBasicParsing -ErrorAction Stop
            $xsrfToken = $sessionResponse.Headers["X-XSRF-TOKEN"]
            if (-not $xsrfToken) { throw "NSX vIDM: no X-XSRF-TOKEN for $samName" }
            $headers["X-XSRF-TOKEN"] = $xsrfToken
            $script:NSXFallbackSession = $nsxSession
            Write-Log "  NSX authenticated as: $samName" -Color Green
        }

        $testParams = @{ Uri = "https://${Server}/policy/api/v1/infra"; Headers = $headers; Method = "Get"; ErrorAction = "Stop" }
        if ($script:NSXFallbackSession) { $testParams["WebSession"] = $script:NSXFallbackSession }
        $null = Invoke-RestMethod @testParams
        Write-Log "  NSX connection verified" -Color Green
        return $headers
    }

    [System.Net.ServicePointManager]::ServerCertificateValidationCallback = $null
    if (-not ([System.Management.Automation.PSTypeName]'TrustAllCertsPolicy').Type) {
        Add-Type @"
using System.Net;
using System.Security.Cryptography.X509Certificates;
public class TrustAllCertsPolicy : ICertificatePolicy {
    public bool CheckValidationResult(
        ServicePoint srvPoint, X509Certificate certificate,
        WebRequest request, int certificateProblem) { return true; }
}
"@
    }
    [System.Net.ServicePointManager]::CertificatePolicy = New-Object TrustAllCertsPolicy

    $script:NSXFallbackSession = $null
    if (Test-Path $NSXCredPath) {
        $nsxCred = Import-Clixml -Path $NSXCredPath
    } else {
        $nsxCred = Get-Credential -Message "Enter NSX Manager credentials"
        $credDir = Split-Path $NSXCredPath -Parent
        if (-not (Test-Path $credDir)) { New-Item -ItemType Directory -Path $credDir -Force | Out-Null }
        $nsxCred | Export-Clixml -Path $NSXCredPath
    }

    try {
        $nsxHeaders = Connect-NSXManagerFallback -Server $NSXManager -Credential $nsxCred `
            -AuthMode $NSXAuthMode -VIDMDomain $NSXvIDMDomain
        $nsxFilled = 0
        foreach ($vm in $missingAppVMs) {
            try {
                $nsxUri = "https://${NSXManager}/api/v1/fabric/virtual-machines?display_name=$($vm.VMName)"
                $inv = @{ Uri = $nsxUri; Headers = $nsxHeaders; Method = "Get" }
                if ($script:NSXFallbackSession) { $inv["WebSession"] = $script:NSXFallbackSession }
                $nsxResponse = Invoke-RestMethod @inv

                if ($nsxResponse.results -and $nsxResponse.results.Count -gt 0) {
                    $nsxVM = $nsxResponse.results[0]
                    if ($nsxVM.tags) {
                        $nsxAppTags = @()
                        foreach ($tag in $nsxVM.tags) {
                            $tagValue = $tag.tag -replace '^ST-', ''
                            switch ($tag.scope) {
                                "app-application" { $nsxAppTags += $tagValue }
                                "infra-os"        { if (-not $vm.InfraOS)  { $vm.InfraOS  = $tagValue } }
                                "app-layer"       { if (-not $vm.AppLayer) { $vm.AppLayer = $tagValue } }
                            }
                        }
                        if ($nsxAppTags.Count -gt 0) {
                            $vm.AppApplication = ($nsxAppTags | Select-Object -Unique) -join "; "
                            $nsxFilled++
                            Write-Log "  $($vm.VMName) | NSX Tags: $($vm.AppApplication)" -Color Green

                            $matchedApps = @()
                            if ($vm.CMDBCI) {
                                $ciList = $vm.CMDBCI -split ";\s*"
                                foreach ($tag in $nsxAppTags) {
                                    $normTag = ($tag.ToLower().Trim() -replace '[_\s\-\.]+', '')
                                    foreach ($ci in $ciList) {
                                        $normCI = ($ci.ToLower().Trim() -replace '[_\s\-\.]+', '')
                                        if ($normTag -and $normCI -and $normTag -eq $normCI) { $matchedApps += $tag; break }
                                    }
                                }
                            }
                            $vm.CompareResult = if ($matchedApps.Count -gt 0) {
                                if ($nsxAppTags.Count -gt 1) { "Match - Multiple Tags" } else { "Match" }
                            } else { "Mismatch" }
                        }
                    }
                }
            } catch {
                Write-Log "  $($vm.VMName) | NSX lookup failed: $($_.Exception.Message)" -Color Red
            }
            Start-Sleep -Milliseconds 100
        }
        Write-Log "  NSX filled: $nsxFilled / $($missingAppVMs.Count)" -Color Cyan
    } catch {
        Write-Log "  NSX authentication failed: $($_.Exception.Message) (skipping)" -Color Red
    }
}


# ---------------- Phase 2: REVIEW ----------------
Write-Log "`n=== PHASE 2: REVIEW (getVmApplications logs + getCagApplications) ===" -Color Cyan

# Reset TLS/cert callback in case NSX section altered it
[System.Net.ServicePointManager]::CertificatePolicy = $null
[System.Net.ServicePointManager]::ServerCertificateValidationCallback = { $true }

$vroHeaders = @{
    "Authorization" = "Bearer $authToken"
    "Content-Type"  = "application/json"
    "Accept"        = "application/json"
}

# Per-project CAG classification cache
$cagCache = @{}
# Per-VM upstream cache: "$projectName|$vmName" -> @{ UpstreamCIs; Meta }
$vmCache  = @{}

function Get-CagForProject {
    param([string]$ProjectName)
    if (-not $ProjectName) { return @{ Apps = @(); SubApps = @() } }
    if ($cagCache.ContainsKey($ProjectName)) { return $cagCache[$ProjectName] }

    $apps = @(); $subApps = @()
    try {
        $res = Invoke-VroActionWithLogs -Server $vraServer -ActionUri $getCagAppsUri -Headers $vroHeaders `
            -Inputs @{ projectName = $ProjectName; phasedOutEnabled = "true" }

        $data = $null
        if ($res.ReturnBody) {
            try { $data = $res.ReturnBody | ConvertFrom-Json } catch { $data = $res.ReturnBody }
        }
        $arr = @()
        if     ($data -is [array])         { $arr = $data }
        elseif ($data.value -is [array])   { $arr = $data.value }
        elseif ($data -is [string])        { $arr = $data -split "`r?`n" }

        $bucket = "none"
        foreach ($line in $arr) {
            $s = ([string]$line).Trim()
            if (-not $s) { continue }
            if     ($s -match '^---\s*Applications\s*---$')      { $bucket = "apps";    continue }
            elseif ($s -match '^---\s*Sub-?Applications\s*---$') { $bucket = "subapps"; continue }
            switch ($bucket) {
                "apps"    { $apps    += $s }
                "subapps" { $subApps += $s }
            }
        }
    } catch {
        Write-Log "  CAG lookup failed for project '$ProjectName': $($_.Exception.Message)" -Color Yellow
    }

    $entry = @{ Apps = $apps; SubApps = $subApps }
    $cagCache[$ProjectName] = $entry
    return $entry
}

function Get-UpstreamForVm {
    # Call getVmApplications via /vco/api/actions to get access to LOGS,
    # then scrape retrieveCIRelationshipInfoByKey.upstreamCIs from log text.
    param([string]$VmName, [string]$ProjectName)
    $key = "$ProjectName|$VmName"
    if (-not $VmName) { return @{ UpstreamCIs = @(); Meta = @{} } }
    if ($vmCache.ContainsKey($key)) { return $vmCache[$key] }

    $res = Invoke-VroActionWithLogs -Server $vraServer -ActionUri $getVmAppsUri -Headers $vroHeaders `
        -Inputs @{ vmName = $VmName; projectName = $ProjectName }

    $upstream = @()
    if ($res.LogText) {
        $upstream = Get-UpstreamCIsFromLog -LogText $res.LogText
    }

    $entry = @{
        UpstreamCIs = $upstream
        Meta        = @{
            ExecId      = $res.ExecId
            LogEndpoint = $res.LogEndpoint
            LogChars    = $res.LogChars
        }
    }
    $vmCache[$key] = $entry
    return $entry
}

