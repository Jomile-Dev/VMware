# Normalise typographic characters that mangle in CSV (en/em dashes -> '-',
# NBSP -> space, curly quotes -> straight) so CI names export cleanly.
function ConvertTo-CleanText {
    param($s)
    if ($null -eq $s) { return $s }
    $s = [string]$s
    $s = $s -replace [char]0x2013, '-' -replace [char]0x2014, '-'
    $s = $s -replace [char]0x00A0, ' '
    $s = $s -replace [char]0x2018, "'" -replace [char]0x2019, "'"
    $s = $s -replace [char]0x201C, '"' -replace [char]0x201D, '"'
    return $s
}

