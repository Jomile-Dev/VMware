$t = "PASTE_TOKEN_HERE"
$p = $t.Split('.')[1].Replace('-','+').Replace('_','/')
switch ($p.Length % 4) { 2 { $p += '==' } 3 { $p += '=' } }
$c = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($p)) | ConvertFrom-Json
"issued  : " + [DateTimeOffset]::FromUnixTimeSeconds($c.iat).LocalDateTime
"expires : " + [DateTimeOffset]::FromUnixTimeSeconds($c.exp).LocalDateTime
"lifetime (min) : {0:N1}" -f (([DateTimeOffset]::FromUnixTimeSeconds($c.exp) - [DateTimeOffset]::FromUnixTimeSeconds($c.iat)).TotalMinutes)
"remaining (min): {0:N1}" -f (([DateTimeOffset]::FromUnixTimeSeconds($c.exp).LocalDateTime - (Get-Date)).TotalMinutes)
