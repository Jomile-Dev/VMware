#Requires -Version 5.1
<#
    vrniAppTierUpdate.ps1
    List     - export vRNI applications and their tiers to CSV
    Update   - bring existing vRNI applications in line with the four-zone tier layout
    Create   - read the NSX distributed firewall security policy names (each policy = one application)
               and create any that are missing in vRNI, with the four zone tiers
    NSX security groups / tags are cross-checked and reported for every app.

    Tier layout (tier names are the zone names exactly):
        FrontEnd, Management, Internal, Protected
    Tier membership filter:
        Security Group = 'SG-<APP CI>-<Zone>'
    NSX tag expected per zone:
        ST-<APP_CI>-<Zone>      (spaces in the CI replaced with underscores)

    Application names may contain spaces and are never changed on existing apps.
    Update : the SG base is read from the app's existing FrontEnd filter, not built from the app name.
    Create : the DFW policy name is the application name and the SG base is SG-<policy name>.
#>

#region CONFIG ---------------------------------------------------------------
# vRNI connection
$VrniServer          = '<vrni-fqdn>'                             # vRNI (Aria Operations for Networks) FQDN
$VidmServer          = ''                                        # blank = ask vRNI which vIDM appliance to use
$VidmDomain          = ''                                        # optional - only tried if the plain UPN login fails
$CredentialPath      = '<path-to-cred.xml>'                      # Export-Clixml PSCredential for vIDM / vRNI - if the file is missing you are prompted instead

# NSX connection - Create mode, and the SG check in Update / Create
$NsxServer           = '<nsx-manager-fqdn>'                      # NSX Manager FQDN
$NsxCredentialPath   = ''                                        # Export-Clixml PSCredential for NSX - blank = reuse the vRNI login

# What to run
$Mode                = 'Update'                                  # 'List', 'Update' or 'Create'
$DryRun              = $true                                     # Update / Create - $true = show the plan only, no changes in vRNI

# Update mode - CSV (column: ApplicationName, exact vRNI app names) OR blank = all apps
$UpdateCSV           = ''                                        # e.g. 'C:\Scripts\Input\vrniUpdate.csv'

# Tiers
$Zones               = @('FrontEnd', 'Management', 'Internal', 'Protected')   # Tier names (exactly these)

# Create mode - which DFW security policies count as applications
$NsxPolicyCategories = @('Application')                          # DFW categories to read - blank array = all categories
$NsxPolicyExclude    = ''                                        # regex of policy names to skip, e.g. '^(Default|Sample)'

# Checks and API behaviour
$CheckTags           = $true                                     # look up the ST- tags in vRNI (only for apps that will change) - $false = skip the tag check
$NsxCrossCheck       = $true                                     # report whether the expected SGs (NSX) and tags (vRNI inventory) exist
$ShowProgress        = $true                                     # progress bar plus a status line for each step / app
$FastNameLookup      = $true                                     # try to get app names from the list / bulk summary calls before one call per app
$RequestDelayMs      = 200                                       # pause after every API call (avoids HTTP 429)
$MaxRetries          = 5                                         # retries on HTTP 429, backing off each time
$Threads             = 4                                         # parallel tier reads (1 = one at a time) - lower it if you see 429 lines

# Output
$OutputDir           = '.\Reports'                               # CSV reports are written here
$SkipCertCheck       = $true                                     # bypass self-signed certificate errors
#endregion CONFIG ------------------------------------------------------------

$ErrorActionPreference = 'Stop'
$script:Base       = "https://$VrniServer/api/ni"
$script:Token      = $null
$script:ApproveAll = $false
$script:QuitNow    = $false
$script:NsxSession  = $null
$script:NsxXsrf     = $null
$script:NsxGroupTable = $null
$script:TierCache  = $null

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
if ($SkipCertCheck -and -not ('TrustAllCertsPolicy' -as [type])) {
    Add-Type @"
using System.Net;
using System.Security.Cryptography.X509Certificates;
public class TrustAllCertsPolicy : ICertificatePolicy {
    public bool CheckValidationResult(ServicePoint sp, X509Certificate c, WebRequest r, int p) { return true; }
}
"@
    [Net.ServicePointManager]::CertificatePolicy = New-Object TrustAllCertsPolicy
}

#region helpers --------------------------------------------------------------
# Timestamped status line
function Show-Step {
    param([string]$Text, [string]$Color = 'White')
    Write-Host ("[{0}] {1}" -f (Get-Date -Format 'HH:mm:ss'), $Text) -ForegroundColor $Color
}

# Pull the response body out of a failed call - Windows PowerShell 5.1 hides it by default
function Get-ErrorText {
    param($ErrorRecord)
    $msg = $ErrorRecord.Exception.Message
    try {
        $resp = $ErrorRecord.Exception.Response
        if ($resp) {
            $sr   = New-Object System.IO.StreamReader($resp.GetResponseStream())
            $body = $sr.ReadToEnd()
            if ($body) { $msg = "$msg | $body" }
        }
    } catch {}
    $msg
}

# Generic REST call - JSON body unless told otherwise, retries on HTTP 429 (Retry-After if given, else backoff)
function Invoke-Api {
    param(
        [string]$Method = 'GET',
        [Parameter(Mandatory)][string]$Uri,
        $Body,
        [hashtable]$Headers = @{},
        [string]$ContentType = 'application/json'
    )
    $p = @{ Method = $Method; Uri = $Uri; Headers = $Headers; ContentType = $ContentType; UseBasicParsing = $true }
    if ($null -ne $Body) {
        if ($ContentType -eq 'application/json' -and $Body -isnot [string]) { $Body = $Body | ConvertTo-Json -Depth 10 }
        $p.Body = $Body
    }
    for ($try = 0; $try -le $MaxRetries; $try++) {
        try {
            $r = Invoke-RestMethod @p
            if ($RequestDelayMs) { Start-Sleep -Milliseconds $RequestDelayMs }
            return $r
        } catch {
            $code = 0
            $resp = $_.Exception.Response
            if ($resp) { $code = [int]$resp.StatusCode }
            if ($code -eq 429 -and $try -lt $MaxRetries) {
                $wait = [math]::Pow(2, $try) * 2
                try { $ra = $resp.Headers['Retry-After']; if ($ra) { $wait = [int]$ra } } catch {}
                Write-Host "429 from vRNI - waiting $wait s (retry $($try + 1)/$MaxRetries)" -ForegroundColor Yellow
                Start-Sleep -Seconds $wait
                continue
            }
            throw (Get-ErrorText $_)
        }
    }
}

# vRNI call - adds the NetworkInsight token header to Invoke-Api
function Invoke-Vrni {
    param([string]$Method = 'GET', [string]$Path, $Body)
    Invoke-Api -Method $Method -Uri "$script:Base$Path" -Body $Body `
        -Headers @{ Authorization = "NetworkInsight $script:Token"; Accept = 'application/json' }
}

# vIDM login, then exchange the vIDM token for a vRNI token
function Connect-Vrni {
    param([pscredential]$Credential)
    # 1. Ask vRNI which vIDM appliance and OAuth client-id it uses
    Show-Step 'Connecting to vRNI - asking for the vIDM client-id (1/3)'
    $client = Invoke-Api -Uri "$script:Base/auth/vidm/client-id"
    $vidm   = if ($VidmServer) { $VidmServer } else { $client.vidm_appliance }
    if (-not $client.client_id -or -not $vidm) { throw 'Could not get vIDM client-id/appliance from vRNI.' }

    # 2. Get a user access token from vIDM (password grant) - plain UPN first, domain only as a fallback
    #    (keeps failed logins down so the account is not locked out)
    Show-Step "vIDM appliance: $vidm"
    $attempts = @(@{ Domain = '' })
    if ($VidmDomain) { $attempts += @{ Domain = $VidmDomain } }

    $vidmToken = $null
    $n = 0
    foreach ($a in $attempts) {
        $n++
        $how = if ($a.Domain) { 'with domain field' } else { 'plain username' }
        Show-Step "vIDM login attempt $n of $($attempts.Count) ($how) (2/3)"
        $form = @{
            grant_type = 'password'
            username   = $Credential.UserName
            password   = $Credential.GetNetworkCredential().Password
            client_id  = $client.client_id
        }
        if ($a.Domain) { $form.domain = $a.Domain }
        try {
            $vidmToken = Invoke-Api -Method POST -Uri "https://$vidm/SAAS/auth/oauthtoken" `
                -Body $form -ContentType 'application/x-www-form-urlencoded'
            $form.password = $null
            if ($vidmToken.access_token) { Show-Step 'vIDM login OK' 'Green'; break }
        } catch {
            $form.password = $null
            Write-Host "vIDM login attempt failed: $_" -ForegroundColor Yellow
        }
    }
    if (-not $vidmToken -or -not $vidmToken.access_token) { throw 'vIDM did not return an access_token.' }

    # 3. Exchange the vIDM token for a vRNI token
    Show-Step 'Exchanging the vIDM token for a vRNI token (3/3)'
    $ni = Invoke-Api -Method POST -Uri "$script:Base/auth/token/vidm" -Body @{ vidm_token = $vidmToken.access_token }
    if (-not $ni.token) { throw 'vRNI did not return a token.' }
    $script:Token = $ni.token
    Show-Step 'vRNI login OK' 'Green'
}

# Delete the vRNI token at the end - each user is limited to 100 valid tokens
function Disconnect-Vrni {
    if ($script:Token) { try { Invoke-Vrni -Method DELETE -Path '/auth/token' | Out-Null } catch {} }
}

# Cursor-based paging for list calls (size=100 per page) - pass -Label to show each page as it is read
function Get-Paged {
    param([string]$Path, [string]$Label)
    $all = @(); $cursor = $null; $page = 0
    do {
        $page++
        $sep = if ($Path.Contains('?')) { '&' } else { '?' }
        $uri = "$Path${sep}size=100"
        if ($cursor) { $uri += "&cursor=$cursor" }
        $r = Invoke-Vrni -Path $uri
        if ($r.results) { $all += @($r.results) }
        if ($Label) { Show-Step "  $Label page ${page}: $(@($r.results).Count) entries (total $($all.Count))" }
        $cursor = $r.cursor
    } while ($cursor -and $r.results -and @($r.results).Count -gt 0)
    $all
}

# Y / N / A (yes to all) / Q (quit) prompt used before each app is changed
function Get-UserConfirm {
    param([string]$Prompt)
    if ($script:ApproveAll) { return 'Y' }
    do { $a = (Read-Host "$Prompt [Y]es / [N]o / [A]ll / [Q]uit").Trim().ToUpper() } until ($a -in 'Y','N','A','Q')
    if ($a -eq 'A') { $script:ApproveAll = $true; return 'Y' }
    $a
}

# One row of the output CSV (no entity IDs - names only)
function New-Row {
    param($App, $Action, $Tier, $Filter, $SgInNsx, $TagInNsx, $Result, $Note)
    [pscustomobject]@{
        Application = $App; Action = $Action; TierName = $Tier; Filter = $Filter
        SgInNsx = $SgInNsx; TagInNsx = $TagInNsx; Result = $Result; Note = $Note
    }
}

# Looks for an NSX object by name in vRNI's inventory - returns Found / Missing / Error / NotChecked
# Informational only: SGs for the other zones may not exist in NSX yet
function Test-VrniEntity {
    param([string]$EntityType, [string]$Name)
    if (-not $NsxCrossCheck) { return 'NotChecked' }
    try {
        $r = Invoke-Vrni -Method POST -Path '/search' -Body @{
            entity_type = $EntityType
            filter      = "name = '$Name'"
            size        = 1
        }
        if ($r.results -and @($r.results).Count -gt 0) { 'Found' } else { 'Missing' }
    } catch { 'Error' }
}

# SG check - uses the NSX group table when it was loaded (no API call), otherwise one vRNI search per name
function Get-SgStatus {
    param([string]$Name)
    if (-not $NsxCrossCheck) { return 'NotChecked' }
    if ($script:NsxGroupTable) { if ($script:NsxGroupTable.ContainsKey($Name)) { return 'Found' } else { return 'Missing' } }
    Test-VrniEntity -EntityType 'BaseSecurityGroup' -Name $Name
}

# Turn one tier detail (as vRNI returns it) into: name, id, the Security Group filters, count of non-search criteria
function ConvertTo-TierInfo {
    param($Detail, [string]$Id)
    $filters = @(); $other = 0
    foreach ($c in @($Detail.group_membership_criteria)) {
        if ($c.membership_type -eq 'SearchMembershipCriteria' -and $c.search_membership_criteria.filter) {
            $filters += [string]$c.search_membership_criteria.filter
        } else { $other++ }
    }
    [pscustomobject]@{ Name = $Detail.name; Id = $Id; Filters = $filters; OtherCriteria = $other }
}

# Read every tier of an app one call at a time (used when the parallel read is off or failed for that app)
function Get-AppTiers {
    param([string]$AppId)
    $out = @()
    foreach ($ref in (Get-Paged -Path "/groups/applications/$AppId/tiers")) {
        $out += ConvertTo-TierInfo -Detail (Invoke-Vrni -Path "/groups/tiers/$($ref.entity_id)") -Id $ref.entity_id
    }
    $out
}

# Read the tiers of all apps up front with $Threads parallel workers and keep them in $script:TierCache
#   - the worker only does read-only GETs (tier list, then each tier), with its own 429 back-off
#   - anything that fails here is simply read again one at a time later
function Initialize-TierCache {
    param($Apps)
    $script:TierCache = @{}
    $total = @($Apps).Count
    if ($Threads -le 1 -or $total -lt 2) { return }

    $worker = {
        param($Base, $Token, $AppId, $Delay, $Retries)
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        function Get-One {
            param($Path)
            $hdr = @{ Authorization = "NetworkInsight $Token"; Accept = 'application/json' }
            for ($t = 0; $t -le $Retries; $t++) {
                try {
                    $r = Invoke-RestMethod -Method GET -Uri "$Base$Path" -Headers $hdr -ContentType 'application/json' -UseBasicParsing
                    if ($Delay) { Start-Sleep -Milliseconds $Delay }
                    return $r
                } catch {
                    $code = 0; $resp = $_.Exception.Response
                    if ($resp) { $code = [int]$resp.StatusCode }
                    if ($code -eq 429 -and $t -lt $Retries) { Start-Sleep -Seconds ([math]::Pow(2, $t) * 2); continue }
                    throw
                }
            }
        }
        try {
            $refs = @(); $cursor = $null
            do {
                $uri = "/groups/applications/$AppId/tiers?size=100"
                if ($cursor) { $uri += "&cursor=$cursor" }
                $r = Get-One $uri
                if ($r.results) { $refs += @($r.results) }
                $cursor = $r.cursor
            } while ($cursor -and $r.results -and @($r.results).Count -gt 0)
            $items = @()
            foreach ($ref in $refs) { $items += [pscustomobject]@{ Id = $ref.entity_id; Detail = (Get-One "/groups/tiers/$($ref.entity_id)") } }
            [pscustomobject]@{ AppId = $AppId; Items = $items; Error = $null }
        } catch {
            [pscustomobject]@{ AppId = $AppId; Items = @(); Error = "$_" }
        }
    }

    Show-Step "Reading the tiers of $total apps with $Threads parallel reads..." 'Cyan'
    $sw   = [Diagnostics.Stopwatch]::StartNew()
    $pool = [runspacefactory]::CreateRunspacePool(1, $Threads)
    $pool.Open()
    $jobs = New-Object System.Collections.Generic.List[object]
    foreach ($a in $Apps) {
        $ps = [powershell]::Create()
        $ps.RunspacePool = $pool
        [void]$ps.AddScript($worker.ToString()).AddArgument($script:Base).AddArgument($script:Token).AddArgument($a.Id).AddArgument($RequestDelayMs).AddArgument($MaxRetries)
        $jobs.Add([pscustomobject]@{ Ps = $ps; Handle = $ps.BeginInvoke() })
    }

    $lastShown = 0
    do {
        $done = @($jobs | Where-Object { $_.Handle.IsCompleted }).Count
        if ($ShowProgress) { Write-Progress -Activity 'Reading tiers' -Status "$done / $total" -PercentComplete (($done / [math]::Max($total, 1)) * 100) }
        if ($done - $lastShown -ge 25) { $lastShown = $done; Show-Step "  tiers read: $done / $total" }
        if ($done -lt $total) { Start-Sleep -Milliseconds 300 }
    } while ($done -lt $total)
    Write-Progress -Activity 'Reading tiers' -Completed

    $failed = 0
    foreach ($j in $jobs) {
        $res = @($j.Ps.EndInvoke($j.Handle)) | Select-Object -First 1
        $j.Ps.Dispose()
        if ($res -and -not $res.Error) {
            $script:TierCache[$res.AppId] = @($res.Items | ForEach-Object { ConvertTo-TierInfo -Detail $_.Detail -Id $_.Id })
        } else { $failed++ }
    }
    $pool.Close(); $pool.Dispose()
    $color = if ($failed -gt 0) { 'Yellow' } else { 'Green' }
    Show-Step "Tiers read for $($script:TierCache.Count) of $total apps in $([math]::Round($sw.Elapsed.TotalSeconds)) s (failed: $failed - those are read again one at a time)" $color
}

# Request body for a tier - VMs where Security Group = '<SG name>'
function New-TierBody {
    param([string]$Name, [string]$Filter)
    @{
        name = $Name
        group_membership_criteria = @(@{
            membership_type            = 'SearchMembershipCriteria'
            search_membership_criteria = @{ entity_type = 'BaseVirtualMachine'; filter = $Filter }
        })
    }
}

# NSX Manager session login - reuses the vRNI login unless $NsxCredentialPath is set
function Connect-Nsx {
    param([pscredential]$Credential)
    $c = $Credential
    if ($NsxCredentialPath) { $c = Import-Clixml -LiteralPath $NsxCredentialPath }
    if (-not $c) { throw 'No NSX credential supplied.' }
    $form = @{ j_username = $c.UserName; j_password = $c.GetNetworkCredential().Password }
    try {
        $r = Invoke-WebRequest -Method POST -Uri "https://$NsxServer/api/session/create" -Body $form -ContentType 'application/x-www-form-urlencoded' -SessionVariable nsxSess -UseBasicParsing
    } catch { $form.j_password = $null; throw (Get-ErrorText $_) }
    $form.j_password = $null
    $script:NsxSession = $nsxSess
    $script:NsxXsrf    = $r.Headers['X-XSRF-TOKEN']
}

# NSX Manager call - session cookie plus XSRF token
function Invoke-Nsx {
    param([string]$Path)
    $p = @{
        Method = 'GET'; Uri = "https://$NsxServer$Path"; WebSession = $script:NsxSession
        Headers = @{ 'X-XSRF-TOKEN' = $script:NsxXsrf; Accept = 'application/json' }
        ContentType = 'application/json'; UseBasicParsing = $true
    }
    try { $r = Invoke-RestMethod @p } catch { throw (Get-ErrorText $_) }
    if ($RequestDelayMs) { Start-Sleep -Milliseconds $RequestDelayMs }
    $r
}

# Cursor-based paging for NSX Policy list calls
function Get-NsxPaged {
    param([string]$Path)
    $all = @(); $cursor = $null
    do {
        $sep = if ($Path.Contains('?')) { '&' } else { '?' }
        $uri = $Path
        if ($cursor) { $uri += "${sep}cursor=$cursor" }
        $r = Invoke-Nsx -Path $uri
        if ($r.results) { $all += @($r.results) }
        $cursor = $r.cursor
    } while ($cursor)
    $all
}

# DFW security policy names = the application list (default / system policies and excluded names dropped)
function Get-NsxPolicyNames {
    $pol = @(Get-NsxPaged -Path '/policy/api/v1/infra/domains/default/security-policies')
    $names = foreach ($x in $pol) {
        if ($x.is_default -or $x._system_owned) { continue }
        if ($NsxPolicyCategories.Count -gt 0 -and $NsxPolicyCategories -notcontains $x.category) { continue }
        if ($NsxPolicyExclude -and $x.display_name -match $NsxPolicyExclude) { continue }
        $x.display_name
    }
    @($names | Where-Object { $_ } | Sort-Object -Unique)
}

# Every NSX group display name, case-insensitive lookup table (used to report which SGs exist)
function Get-NsxGroupNames {
    $t = New-Object System.Collections.Hashtable([StringComparer]::OrdinalIgnoreCase)
    foreach ($g in (Get-NsxPaged -Path '/policy/api/v1/infra/domains/default/groups')) { $t[[string]$g.display_name] = $true }
    $t
}

# Application names as fast as possible - ID list first, then fill in names from the cheapest source that has them
#   1. names that already come back in the list response
#   2. bulk summaries (one call per 100 apps)
#   3. one call per app for whatever is still missing (slow, throttled)
function Get-AppIndex {
    $refs = @(Get-Paged -Path '/groups/applications' -Label 'applications')
    $names = @{}
    $pick  = { param($x) if ($x.entity_name) { [string]$x.entity_name } elseif ($x.name) { [string]$x.name } else { $null } }

    if ($FastNameLookup) {
        foreach ($x in $refs) { $n = & $pick $x; if ($n) { $names[$x.entity_id] = $n } }
        if ($names.Count -gt 0) { Show-Step "  $($names.Count) of $($refs.Count) names came back in the application list" }

        if ($names.Count -lt $refs.Count) {
            try {
                Show-Step '  trying the bulk application summaries...'
                $sum = @(Get-Paged -Path '/groups/applications/fetch?fetch_member_counts=false&fetch_update_status=false' -Label 'summaries')
                foreach ($x in $sum) { $n = & $pick $x; if ($n -and $x.entity_id) { $names[$x.entity_id] = $n } }
                Show-Step "  names known after the bulk call: $($names.Count) of $($refs.Count)"
            } catch { Show-Step "  bulk summaries not usable - $_" 'Yellow' }
        }
    }

    $todo = @($refs | Where-Object { -not $names.ContainsKey($_.entity_id) })
    if ($todo.Count -gt 0) {
        Show-Step "Fetching $($todo.Count) names one by one (about $([math]::Ceiling($todo.Count * ($RequestDelayMs + 150) / 1000)) s)"
        $i = 0
        foreach ($ref in $todo) {
            $i++
            $d = Invoke-Vrni -Path "/groups/applications/$($ref.entity_id)"
            $names[$ref.entity_id] = [string]$d.name
            if ($ShowProgress) { Write-Progress -Activity 'Reading application names' -Status "$i / $($todo.Count)" -PercentComplete (($i / [math]::Max($todo.Count, 1)) * 100) }
            if ($i % 25 -eq 0) { Show-Step "  names read: $i / $($todo.Count)" }
        }
        Write-Progress -Activity 'Reading application names' -Completed
    }

    @($refs | ForEach-Object { [pscustomobject]@{ Id = $_.entity_id; Name = $names[$_.entity_id] } } | Sort-Object Name)
}

# Compare app / policy names ignoring case and underscore-versus-space differences
function Get-NormName {
    param([string]$Name)
    (($Name -replace '[_\s]+', ' ').Trim()).ToLower()
}
#endregion helpers -----------------------------------------------------------

#region modes ----------------------------------------------------------------
# List mode - one row per tier (apps with no tiers still get a row)
function Invoke-ListMode {
    param($Apps)
    $rows = New-Object System.Collections.Generic.List[object]
    foreach ($app in $Apps) {
        if ($script:TierCache -and $script:TierCache.ContainsKey($app.Id)) { $tiers = @($script:TierCache[$app.Id]) }
        else { $tiers = Get-AppTiers -AppId $app.Id }
        if (@($tiers).Count -eq 0) {
            $rows.Add([pscustomobject]@{ Application = $app.Name; Tier = ''; Filter = '' })
        }
        foreach ($t in $tiers) {
            $rows.Add([pscustomobject]@{ Application = $app.Name; Tier = $t.Name; Filter = ($t.Filters -join ' ; ') })
        }
    }
    $rows
}

# Update mode - brings one existing app in line with the four zone tiers
#   1. find the FrontEnd tier and read the SG base from its filter
#   2. flag anything unusual as Review and leave it alone
#   3. plan: rename FrontEnd if needed, add the missing zone tiers
#   4. show the plan, ask, then apply (adds first, rename last)
function Update-App {
    param($App)
    $out    = New-Object System.Collections.Generic.List[object]
    $name   = $App.Name
    if ($script:TierCache -and $script:TierCache.ContainsKey($App.Id)) { $tiers = @($script:TierCache[$App.Id]) }
    else { $tiers = @(Get-AppTiers -AppId $App.Id) }

    # 1. FrontEnd tier - by name first, otherwise the tier with a single SG-<base>-FrontEnd filter
    $fe = @($tiers | Where-Object { $_.Name -ceq 'FrontEnd' })
    if ($fe.Count -eq 0) {
        $fe = @($tiers | Where-Object { $_.Filters.Count -eq 1 -and $_.Filters[0] -match "^Security Group = '.+-FrontEnd'$" })
    }
    $existingText = ($tiers | ForEach-Object { "$($_.Name): " + ($_.Filters -join ',') }) -join ' | '

    # 2. Anything that does not fit the pattern is listed for review, not guessed at
    if ($fe.Count -ne 1)               { $out.Add((New-Row $name 'Review' '' $existingText '' '' 'Review' 'Could not identify a single FrontEnd tier')); return $out }
    $feTier = $fe[0]
    if ($feTier.Filters.Count -ne 1)   { $out.Add((New-Row $name 'Review' $feTier.Name $existingText '' '' 'Review' 'FrontEnd tier has none or more than one filter')); return $out }
    if ($feTier.OtherCriteria -gt 0)   { $out.Add((New-Row $name 'Review' $feTier.Name $existingText '' '' 'Review' 'FrontEnd tier has extra non-search criteria')); return $out }
    if ($feTier.Filters[0] -notmatch "^Security Group = '(?<sg>SG-.+)-FrontEnd'$") {
        $out.Add((New-Row $name 'Review' $feTier.Name $existingText '' '' 'Review' 'FrontEnd filter is not Security Group = SG-<base>-FrontEnd')); return $out
    }
    # SG base comes from vRNI's own data:  SG-<APP CI>   (tag base:  ST-<APP_CI>)
    $base = $Matches['sg']
    $ci   = $base.Substring(3)
    $tagBase = 'ST-' + ($ci -replace '\s+', '_')

    $unexpected = @($tiers | Where-Object { $Zones -notcontains $_.Name -and $_.Id -ne $feTier.Id })
    if ($unexpected.Count -gt 0) {
        $out.Add((New-Row $name 'Review' ($unexpected.Name -join ',') $existingText '' '' 'Review' 'Tier name is not one of the zones')); return $out
    }
    foreach ($z in $Zones) {
        $t = @($tiers | Where-Object { $_.Name -ceq $z -and $_.Id -ne $feTier.Id })
        if ($t.Count -gt 0) {
            $expected = "Security Group = '$base-$z'"
            if (@($t[0].Filters).Count -ne 1 -or $t[0].Filters[0] -cne $expected) {
                $out.Add((New-Row $name 'Review' $z ($t[0].Filters -join ',') '' '' 'Review' "Existing $z tier filter does not match $expected")); return $out
            }
        }
    }

    # 3. Build the plan (NSX lookups are for the report only)
    $plan = New-Object System.Collections.Generic.List[object]
    foreach ($z in $Zones) {
        $expected = "Security Group = '$base-$z'"
        $sgNsx  = Get-SgStatus -Name "$base-$z"
        $tagNsx = 'NotChecked'
        if ($z -eq 'FrontEnd') {
            if ($feTier.Name -cne 'FrontEnd') {
                $plan.Add([pscustomobject]@{ Action = 'Rename'; Tier = 'FrontEnd'; Old = $feTier.Name; TierId = $feTier.Id; Filter = $feTier.Filters[0]; Sg = $sgNsx; Tag = $tagNsx })
            } else {
                $out.Add((New-Row $name 'None' 'FrontEnd' $feTier.Filters[0] $sgNsx $tagNsx 'Already compliant' ''))
            }
        } elseif (@($tiers | Where-Object { $_.Name -ceq $z }).Count -eq 0) {
            $plan.Add([pscustomobject]@{ Action = 'Add'; Tier = $z; Old = ''; TierId = ''; Filter = $expected; Sg = $sgNsx; Tag = $tagNsx })
        } else {
            $out.Add((New-Row $name 'None' $z $expected $sgNsx $tagNsx 'Already compliant' ''))
        }
    }

    # Tag lookup only for apps that have something to change - keeps the number of search calls down
    if ($plan.Count -gt 0 -and $CheckTags -and $NsxCrossCheck) {
        foreach ($p in $plan) { $p.Tag = Test-VrniEntity -EntityType 'SecurityTag' -Name "$tagBase-$($p.Tier)" }
    }

    if ($plan.Count -eq 0) { Write-Host "OK     : $name - already has the 4 zone tiers"; return $out }

    Write-Host ''
    Write-Host '------------------------------------------------------------'
    Write-Host "Application : $name" -ForegroundColor Cyan
    Write-Host "SG base     : $base"
    foreach ($p in $plan) {
        if ($p.Action -eq 'Rename') { Write-Host "  RENAME tier '$($p.Old)' -> 'FrontEnd'   (filter kept: $($p.Filter))   NSX SG: $($p.Sg)  tag: $($p.Tag)" }
        else                        { Write-Host "  ADD    tier $($p.Tier) -> $($p.Filter)   NSX SG: $($p.Sg)  tag: $($p.Tag)" }
    }
    Write-Host '------------------------------------------------------------'

    if ($DryRun) {
        foreach ($p in $plan) { $out.Add((New-Row $name $p.Action $p.Tier $p.Filter $p.Sg $p.Tag 'DryRun' $(if ($p.Old) { "Old name: $($p.Old)" } else { '' }))) }
        return $out
    }

    $answer = Get-UserConfirm -Prompt "Update '$name'?"
    if ($answer -eq 'N') { $out.Add((New-Row $name 'None' '' '' '' '' 'Skipped - declined' '')); return $out }
    if ($answer -eq 'Q') { $script:QuitNow = $true; $out.Add((New-Row $name 'None' '' '' '' '' 'Skipped - quit' '')); return $out }

    # 4. Apply - new tiers first, so a failed rename leaves the app no worse off
    foreach ($p in ($plan | Where-Object { $_.Action -eq 'Add' })) {
        try {
            Invoke-Vrni -Method POST -Path "/groups/applications/$($App.Id)/tiers" -Body (New-TierBody -Name $p.Tier -Filter $p.Filter) | Out-Null
            $out.Add((New-Row $name 'Add' $p.Tier $p.Filter $p.Sg $p.Tag 'Applied' ''))
            Write-Host "ADDED  : $name / $($p.Tier)" -ForegroundColor Green
        } catch { $out.Add((New-Row $name 'Add' $p.Tier $p.Filter $p.Sg $p.Tag 'Failed' "$_")); Write-Host "FAILED : $name / $($p.Tier) - $_" -ForegroundColor Red }
    }
    # Rename the existing tier to FrontEnd, keeping its filter
    foreach ($p in ($plan | Where-Object { $_.Action -eq 'Rename' })) {
        try {
            Invoke-Vrni -Method PUT -Path "/groups/applications/$($App.Id)/tiers/$($p.TierId)" -Body (New-TierBody -Name 'FrontEnd' -Filter $p.Filter) | Out-Null
            $out.Add((New-Row $name 'Rename' 'FrontEnd' $p.Filter $p.Sg $p.Tag 'Applied' "Old name: $($p.Old)"))
            Write-Host "RENAMED: $name / $($p.Old) -> FrontEnd" -ForegroundColor Green
        } catch { $out.Add((New-Row $name 'Rename' 'FrontEnd' $p.Filter $p.Sg $p.Tag 'Failed' "Old name: $($p.Old) | $_")); Write-Host "FAILED : rename on $name - $_" -ForegroundColor Red }
    }
    $out
}

# Create mode - builds one new vRNI app from a DFW policy name
#   1. app name = policy name, SG base = SG-<policy name>, tag base = ST-<policy_name>
#   2. plan the four zone tiers, each filtered on its zone SG (SG may not exist in NSX yet)
#   3. show the plan, ask, then create the app and its tiers
function New-AppFromPolicy {
    param([string]$Name, $NsxGroups)
    $out = New-Object System.Collections.Generic.List[object]

    # 1. Names that would break the filter go to review
    if ($Name -match "'") { $out.Add((New-Row $Name 'Review' '' '' '' '' 'Review' 'Policy name contains a single quote')); return $out }
    $base    = "SG-$Name"
    $tagBase = 'ST-' + ($Name -replace '\s+', '_')

    # 2. Plan (NSX / tag lookups are for the report only)
    $plan = foreach ($z in $Zones) {
        $sg = 'NotChecked'
        if ($NsxCrossCheck -and $NsxGroups) { $sg = if ($NsxGroups.ContainsKey("$base-$z")) { 'Found' } else { 'Missing' } }
        [pscustomobject]@{
            Tier = $z; Filter = "Security Group = '$base-$z'"; Sg = $sg
            Tag  = $(if ($CheckTags) { Test-VrniEntity -EntityType 'SecurityTag' -Name "$tagBase-$z" } else { 'NotChecked' })
        }
    }

    Write-Host ''
    Write-Host '------------------------------------------------------------'
    Write-Host "NEW Application : $Name" -ForegroundColor Cyan
    foreach ($p in $plan) { Write-Host "  ADD tier $($p.Tier) -> $($p.Filter)   NSX SG: $($p.Sg)  tag: $($p.Tag)" }
    Write-Host '------------------------------------------------------------'

    if ($DryRun) {
        foreach ($p in $plan) { $out.Add((New-Row $Name 'CreateApp' $p.Tier $p.Filter $p.Sg $p.Tag 'DryRun' '')) }
        return $out
    }

    # 3. Confirm, create the app, then its tiers
    $answer = Get-UserConfirm -Prompt "Create '$Name'?"
    if ($answer -eq 'N') { $out.Add((New-Row $Name 'None' '' '' '' '' 'Skipped - declined' '')); return $out }
    if ($answer -eq 'Q') { $script:QuitNow = $true; $out.Add((New-Row $Name 'None' '' '' '' '' 'Skipped - quit' '')); return $out }

    try {
        $app = Invoke-Vrni -Method POST -Path '/groups/applications' -Body @{ name = $Name }
        if (-not $app.entity_id) { throw 'vRNI did not return an entity_id for the new application.' }
    } catch {
        $out.Add((New-Row $Name 'CreateApp' '' '' '' '' 'Failed' "$_")); Write-Host "FAILED : $Name - $_" -ForegroundColor Red
        return $out
    }
    Write-Host "CREATED: $Name" -ForegroundColor Green
    foreach ($p in $plan) {
        try {
            Invoke-Vrni -Method POST -Path "/groups/applications/$($app.entity_id)/tiers" -Body (New-TierBody -Name $p.Tier -Filter $p.Filter) | Out-Null
            $out.Add((New-Row $Name 'CreateApp' $p.Tier $p.Filter $p.Sg $p.Tag 'Applied' ''))
        } catch {
            $out.Add((New-Row $Name 'CreateApp' $p.Tier $p.Filter $p.Sg $p.Tag 'Failed' "App created, tier failed: $_"))
            Write-Host "FAILED : $Name / $($p.Tier) - $_" -ForegroundColor Red
        }
    }
    $out
}
#endregion modes -------------------------------------------------------------

#region main -----------------------------------------------------------------
if (-not (Test-Path $OutputDir)) { New-Item -ItemType Directory -Path $OutputDir | Out-Null }
$stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
$swTotal = [Diagnostics.Stopwatch]::StartNew()
Show-Step "Mode: $Mode   DryRun: $DryRun" 'Cyan'

# Saved credential (Export-Clixml) - falls back to a prompt if the file is not there
if (-not $CredentialPath -or $CredentialPath -like '<*') {
    Show-Step 'CredentialPath is not set in CONFIG - prompting instead' 'Yellow'
    $cred = Get-Credential -Message 'vIDM user for vRNI'
}
elseif (-not (Test-Path -LiteralPath $CredentialPath)) {
    Show-Step "Credential file not found: $CredentialPath (looked from $((Get-Location).Path)) - prompting instead" 'Yellow'
    $cred = Get-Credential -Message 'vIDM user for vRNI'
}
else {
    $cred = Import-Clixml -LiteralPath $CredentialPath
    Show-Step 'Credential loaded from file' 'Green'
}
if (-not $cred) { throw 'No credential supplied.' }

# Connect, read the application list, then run the chosen mode (token is deleted in finally)
try {
    Connect-Vrni -Credential $cred

    # Application list gives IDs - names come from the fastest source available (see Get-AppIndex)
    Show-Step 'Reading application list...'
    $swNames = [Diagnostics.Stopwatch]::StartNew()
    $apps = @(Get-AppIndex)
    Show-Step "Found $($apps.Count) applications (took $([math]::Round($swNames.Elapsed.TotalSeconds)) s)" 'Green'

    # Update mode only - limit to the names in the CSV (exact vRNI names, spaces included)
    if ($UpdateCSV -and $Mode -eq 'Update') {
        $wanted = @(Import-Csv -Path $UpdateCSV | ForEach-Object { $_.ApplicationName.Trim() })
        $missing = @($wanted | Where-Object { $apps.Name -cnotcontains $_ })
        $apps = @($apps | Where-Object { $wanted -ccontains $_.Name })
    }

    # List mode - export every app and tier to CSV
    if ($Mode -eq 'List') {
        Initialize-TierCache -Apps $apps
        $file = Join-Path $OutputDir "vrni_apps_$stamp.csv"
        Invoke-ListMode -Apps $apps | Export-Csv -Path $file -NoTypeInformation -Encoding UTF8
        Write-Host "Saved: $file"
    }
    # Update mode - check each app against the four zone tiers, plan / apply, then export the report
    elseif ($Mode -eq 'Update') {
        $report = New-Object System.Collections.Generic.List[object]
        foreach ($m in $missing) { $report.Add((New-Row $m 'Review' '' '' '' '' 'Review' 'Name from CSV not found in vRNI')) }
        # Load every NSX group name once so the SG check needs no API call per app
        if ($NsxCrossCheck -and $NsxServer -and $NsxServer -notlike '<*') {
            try {
                Show-Step 'Loading NSX groups once for the SG check...'
                Connect-Nsx -Credential $cred
                $script:NsxGroupTable = Get-NsxGroupNames
                Show-Step "NSX groups loaded: $($script:NsxGroupTable.Count)" 'Green'
            } catch { Show-Step "NSX group load failed ($_) - using one vRNI search per SG instead" 'Yellow' }
        }

        Initialize-TierCache -Apps $apps

        $n = $apps.Count; $i = 0
        $swCheck = [Diagnostics.Stopwatch]::StartNew()
        Show-Step "Checking $n applications against the four zone tiers" 'Cyan'
        foreach ($app in $apps) {
            if ($script:QuitNow) { break }
            $i++
            $left = ''
            if ($i -gt 1) { $left = ", about $([math]::Ceiling($swCheck.Elapsed.TotalSeconds / ($i - 1) * ($n - $i + 1) / 60)) min left" }
            Show-Step "[$i/$n] $($app.Name)$left"
            if ($ShowProgress) { Write-Progress -Activity 'Checking applications' -Status "$i / $n - $($app.Name)" -PercentComplete (($i / [math]::Max($n, 1)) * 100) }
            try {
                foreach ($r in (Update-App -App $app)) {
                    $report.Add($r)
                    if ($r.Action -eq 'Review') { Show-Step "  REVIEW: $($r.Note)" 'Yellow' }
                }
            }
            catch { $report.Add((New-Row $app.Name 'Error' '' '' '' '' 'Failed' "$_")); Write-Host "ERROR  : $($app.Name) - $_" -ForegroundColor Red }
        }
        Write-Progress -Activity 'Checking applications' -Completed
        $file = Join-Path $OutputDir "vrni_tier_update_$stamp.csv"
        $report | Export-Csv -Path $file -NoTypeInformation -Encoding UTF8
        Write-Host ''
        Write-Host "Saved: $file"
        $report | Group-Object Result | Sort-Object Name | ForEach-Object { Write-Host ("  {0,-22} {1}" -f $_.Name, $_.Count) }
        $byApp   = @($report | Group-Object Application)
        $nReview = @($byApp | Where-Object { $_.Group.Action -contains 'Review' }).Count
        $nChange = @($byApp | Where-Object { $_.Group.Action -notcontains 'Review' -and (@($_.Group.Action) -match '^(Add|Rename)$').Count -gt 0 }).Count
        Show-Step "Apps checked: $($apps.Count)   need changes: $nChange   for review: $nReview   already compliant: $($apps.Count - $nChange - $nReview)" 'Cyan'
    }
    # Create mode - new vRNI apps from the NSX DFW policy list
    elseif ($Mode -eq 'Create') {
        # 1. NSX - DFW policy names are the application list, group names are for the SG check
        Show-Step 'Logging in to NSX Manager...'
        Connect-Nsx -Credential $cred
        Show-Step 'Logged in to NSX - reading DFW security policies...'
        $policyNames = @(Get-NsxPolicyNames)
        $nsxGroups   = $null
        if ($NsxCrossCheck) { $nsxGroups = Get-NsxGroupNames }
        Show-Step "Found $($policyNames.Count) application policies in NSX$(if ($nsxGroups) { " and $($nsxGroups.Count) groups" })" 'Green'

        # 2. Skip any policy vRNI already has (name match ignores case and _ versus space)
        $known = @{}
        foreach ($a in $apps) { $known[(Get-NormName $a.Name)] = $a.Name }

        # 3. Plan / create the rest, then export the report
        $report = New-Object System.Collections.Generic.List[object]
        $n = $policyNames.Count; $i = 0
        foreach ($pn in $policyNames) {
            if ($script:QuitNow) { break }
            $i++
            if ($ShowProgress) { Write-Progress -Activity 'Checking NSX policies' -Status "$i / $n - $pn" -PercentComplete (($i / [math]::Max($n, 1)) * 100) }
            $norm = Get-NormName $pn
            if ($known.ContainsKey($norm)) {
                $vrniName = $known[$norm]
                Write-Host "EXISTS : $pn (vRNI: $vrniName)"
                $report.Add((New-Row $pn 'None' '' '' '' '' 'Already in vRNI' "vRNI name: $vrniName"))
                continue
            }
            try { foreach ($r in (New-AppFromPolicy -Name $pn -NsxGroups $nsxGroups)) { $report.Add($r) } }
            catch { $report.Add((New-Row $pn 'Error' '' '' '' '' 'Failed' "$_")); Write-Host "ERROR  : $pn - $_" -ForegroundColor Red }
        }
        Write-Progress -Activity 'Checking NSX policies' -Completed
        $file = Join-Path $OutputDir "vrni_create_$stamp.csv"
        $report | Export-Csv -Path $file -NoTypeInformation -Encoding UTF8
        Write-Host ''
        Write-Host "Saved: $file"
        $report | Group-Object Result | Sort-Object Name | ForEach-Object { Write-Host ("  {0,-22} {1}" -f $_.Name, $_.Count) }
        $nExist  = @($report | Where-Object { $_.Result -eq 'Already in vRNI' }).Count
        $nReview = @($report | Where-Object { $_.Action -eq 'Review' }).Count
        $nNew    = @($report | Where-Object { $_.Action -eq 'CreateApp' } | Select-Object -ExpandProperty Application -Unique).Count
        Show-Step "Policies: $n   already in vRNI: $nExist   to create / created: $nNew   for review: $nReview" 'Cyan'
    }
    else { throw "Unknown `$Mode '$Mode' - use 'List', 'Update' or 'Create'." }

    Show-Step ("Finished in {0} s" -f [math]::Round($swTotal.Elapsed.TotalSeconds)) 'Green'
}
finally {
    Disconnect-Vrni
}
#endregion main --------------------------------------------------------------
