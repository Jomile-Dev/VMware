#region main -----------------------------------------------------------------
if (-not (Test-Path $OutputDir)) { New-Item -ItemType Directory -Path $OutputDir | Out-Null }
$stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
$swTotal = [Diagnostics.Stopwatch]::StartNew()
Show-Step "Mode: $Mode   DryRun: $DryRun   API limit: $(if ($MaxCallsPerSecond -gt 0) { "$MaxCallsPerSecond calls/s" } else { 'off' })" 'Cyan'

# Saved credential (Export-Clixml) - falls back to a prompt if the file is not there
if (-not $CredentialPath -or $CredentialPath -like '<*') {
    Show-Step 'CredentialPath is not set in CONFIG - prompting instead' 'Yellow'
    $cred = Get-Credential -Message 'vIDM user for vRNI'
}
elseif (-not (Test-Path -LiteralPath $CredentialPath)) {
    Show-Step "Credential file not found: $CredentialPath (looked from $((Get-Location).Path)) - prompting instead" 'Yellow'
    $cred = Get-Credential -Message 'vIDM user for vRNI'
}
else {
    $cred = Import-Clixml -LiteralPath $CredentialPath
    Show-Step 'Credential loaded from file' 'Green'
}
if (-not $cred) { throw 'No credential supplied.' }

# Steps used by the modes ------------------------------------------------------

# Update step - check each app against the four zone tiers, plan / apply (Update and Sync)
function Invoke-UpdateStep {
    param($Apps, $Report)
    $n = @($Apps).Count; $i = 0
    $swCheck = [Diagnostics.Stopwatch]::StartNew()
    Show-Step "Checking $n applications against the four zone tiers" 'Cyan'
    foreach ($app in $Apps) {
        if ($script:QuitNow) { break }
        $i++
        $left = ''
        if ($i -gt 1) { $left = ", about $([math]::Ceiling($swCheck.Elapsed.TotalSeconds / ($i - 1) * ($n - $i + 1) / 60)) min left" }
        Show-Step "[$i/$n] $($app.Name)$left"
        if ($ShowProgress) { Write-Progress -Activity 'Checking applications' -Status "$i / $n - $($app.Name)" -PercentComplete (($i / [math]::Max($n, 1)) * 100) }
        try {
            foreach ($r in (Update-App -App $app)) {
                $Report.Add($r)
                if ($r.Action -eq 'Review') { Show-Step "  REVIEW: $($r.Note)" 'Yellow' }
            }
        }
        catch { $Report.Add((New-Row $app.Name 'Error' '' '' '' '' 'Failed' "$_")); Write-Host "ERROR  : $($app.Name) - $_" -ForegroundColor Red }
    }
    Write-Progress -Activity 'Checking applications' -Completed
}

# Create step - a new vRNI app for every DFW policy that no vRNI app belongs to (Create and Sync)
function Invoke-CreateStep {
    param([string[]]$Policies, $AppPolicy, $AllApps, $Report, [switch]$QuietExisting)
    $owned = @{}
    foreach ($a in $AllApps) { $pol = $AppPolicy[$a.Id]; if ($pol -and $pol -ne '?') { $owned[$pol] = $a.Name } }
    $n = @($Policies).Count; $i = 0
    foreach ($pn in $Policies) {
        if ($script:QuitNow) { break }
        $i++
        if ($ShowProgress) { Write-Progress -Activity 'Checking NSX policies' -Status "$i / $n - $pn" -PercentComplete (($i / [math]::Max($n, 1)) * 100) }
        if ($owned.ContainsKey($pn)) {
            if (-not $QuietExisting) {
                Write-Host "EXISTS : $pn (vRNI: $($owned[$pn]))"
                $Report.Add((New-Row $pn 'None' '' '' '' '' 'Already in vRNI' "vRNI name: $($owned[$pn])"))
            }
            continue
        }
        try { foreach ($r in (New-AppFromPolicy -Name $pn -NsxGroups $script:NsxGroupTable)) { $Report.Add($r) } }
        catch { $Report.Add((New-Row $pn 'Error' '' '' '' '' 'Failed' "$_")); Write-Host "ERROR  : $pn - $_" -ForegroundColor Red }
    }
    Write-Progress -Activity 'Checking NSX policies' -Completed
}

# Orphan step - vRNI apps that no DFW policy belongs to (Create and Sync)
#   report only, unless $RemoveOrphans is on - then they are deleted (with all their tiers) after a separate Y/N/A/Q
#   returns @(orphan count, planned delete count)
function Invoke-OrphanStep {
    param($Apps, $AppPolicy, [int]$AllAppCount, $Report)
    foreach ($a in @($Apps | Where-Object { $AppPolicy[$_.Id] -eq '?' })) {
        $Report.Add((New-Row $a.Name 'Review' '' '' '' '' 'Review' 'More than one DFW policy matches this app - not created, updated or deleted'))
    }
    $orphans  = @($Apps | Where-Object { -not $AppPolicy[$_.Id] })
    $toDelete = @()
    if ($RemoveOrphans -and $orphans.Count -gt 0) {
        $toDelete = @($orphans | Where-Object { -not ($RemoveExclude -and $_.Name -match $RemoveExclude) })
        $pct = [math]::Round(100 * $toDelete.Count / [math]::Max($AllAppCount, 1))
        if ($script:NsxPolicies.Count -eq 0) {
            Show-Step 'No DFW policies were read from NSX - nothing will be deleted' 'Red'; $toDelete = @()
        } elseif ($pct -gt $RemoveMaxPercent) {
            Show-Step "$($toDelete.Count) of $AllAppCount apps ($pct%) would be deleted - over the $RemoveMaxPercent% safety limit, so nothing is deleted. Check `$NsxServers / the policy categories, or raise `$RemoveMaxPercent" 'Red'
            $toDelete = @()
        }
    }
    $deleteIds = @{}
    foreach ($d in $toDelete) { $deleteIds[$d.Id] = $true }

    foreach ($o in $orphans) {
        if ($script:QuitNow -or -not $deleteIds.ContainsKey($o.Id)) {
            $why = 'No DFW policy in NSX matches this app (by app name or FrontEnd SG name)'
            if ($RemoveOrphans -and $RemoveExclude -and $o.Name -match $RemoveExclude) { $why += ' - excluded from delete by $RemoveExclude' }
            $Report.Add((New-Row $o.Name 'None' '' '' '' '' 'In vRNI only' $why)); continue
        }
        Write-Host "  DELETE app '$($o.Name)' and all its tiers (no DFW policy in NSX)" -ForegroundColor Red
        if ($DryRun) { $Report.Add((New-Row $o.Name 'Delete' '' '' '' '' 'DryRun' 'No DFW policy in NSX')); continue }
        $answer = Get-UserConfirm -Prompt "DELETE '$($o.Name)' from vRNI?" -Kind 'delete'
        if ($answer -eq 'N') { $Report.Add((New-Row $o.Name 'None' '' '' '' '' 'In vRNI only' 'Delete declined')); continue }
        if ($answer -eq 'Q') { $script:QuitNow = $true; $Report.Add((New-Row $o.Name 'None' '' '' '' '' 'In vRNI only' 'Delete skipped - quit')); continue }
        try {
            Invoke-Vrni -Method DELETE -Path "/groups/applications/$($o.Id)" | Out-Null
            $Report.Add((New-Row $o.Name 'Delete' '' '' '' '' 'Applied' 'No DFW policy in NSX'))
            Write-Host "DELETED: $($o.Name)" -ForegroundColor Green
        } catch { $Report.Add((New-Row $o.Name 'Delete' '' '' '' '' 'Failed' "$_")); Write-Host "FAILED : delete of $($o.Name) - $_" -ForegroundColor Red }
    }
    if ($orphans.Count -gt 0) { Show-Step "$($orphans.Count) vRNI apps have no matching DFW policy in NSX$(if ($toDelete.Count) { " - $($toDelete.Count) planned for delete" } else { " - listed as 'In vRNI only' in the CSV" })" 'Yellow' }
    ,@($orphans.Count, $toDelete.Count)
}

# Save the report and print the totals by result
function Save-Report {
    param($Report, [string]$Prefix)
    $file = Join-Path $OutputDir "$Prefix`_$stamp.csv"
    $Report | Export-Csv -Path $file -NoTypeInformation -Encoding UTF8
    Write-Host ''
    Write-Host "Saved: $file"
    $Report | Group-Object Result | Sort-Object Name | ForEach-Object { Write-Host ("  {0,-22} {1}" -f $_.Name, $_.Count) }
}

# Per-app summary of the update rows: need changes / for review / already compliant
function Get-UpdateCounts {
    param($Report, [string[]]$AppNames)
    $rows  = @($Report | Where-Object { $AppNames -contains $_.Application })
    $byApp = @($rows | Group-Object Application)
    $nReview = @($byApp | Where-Object { $_.Group.Action -contains 'Review' }).Count
    $nChange = @($byApp | Where-Object { $_.Group.Action -notcontains 'Review' -and (@($_.Group.Action) -match '^(Add|Rename|RenameApp)$').Count -gt 0 }).Count
    $nOk     = @($byApp | Where-Object { $_.Group.Action -notcontains 'Review' -and (@($_.Group.Action) -match '^(Add|Rename|RenameApp)$').Count -eq 0 }).Count
    @{ Change = $nChange; Review = $nReview; Ok = $nOk }
}

# Connect, read the application list, then run the chosen mode (token is deleted in finally)
try {
    if ($Mode -notin 'List', 'Update', 'Create', 'Sync') { throw "Unknown `$Mode '$Mode' - use 'List', 'Update', 'Create' or 'Sync'." }
    Connect-Vrni -Credential $cred

    # Application list gives IDs - names come from the fastest source available (see Get-AppIndex)
    Show-Step 'Reading application list...'
    $swNames = [Diagnostics.Stopwatch]::StartNew()
    $apps = @(Get-AppIndex)
    Show-Step "Found $($apps.Count) applications (took $([math]::Round($swNames.Elapsed.TotalSeconds)) s)" 'Green'
    $allApps = $apps

    # Every existing app name (before any CSV filter) so a rename never collides with another app
    $script:AppNames = @{}
    foreach ($a in $apps) { $script:AppNames[$a.Name.ToLower()] = $true }

    # Optional CSV - limits Update / Create / Sync to these apps (exact vRNI names; for new apps, the DFW policy name)
    $wanted = $null; $limitNorm = $null
    if ($UpdateCSV -and $Mode -ne 'List') {
        if (-not (Test-Path -LiteralPath $UpdateCSV)) { throw "Update CSV not found: $UpdateCSV" }
        $rows = @(Import-Csv -LiteralPath $UpdateCSV)
        # Column can be ApplicationName, or Application (so a filtered report can be fed straight back in)
        $col = $null
        if ($rows.Count -gt 0) {
            $cols = @($rows[0].PSObject.Properties.Name)
            foreach ($c in 'ApplicationName', 'Application') { if (-not $col -and $cols -contains $c) { $col = $c } }
        }
        if (-not $col) { throw "Update CSV needs a column named ApplicationName or Application: $UpdateCSV" }
        $wanted = @($rows | ForEach-Object { [string]$_.$col } | Where-Object { $_ -and $_.Trim() } | ForEach-Object { $_.Trim() } | Select-Object -Unique)
        Show-Step "Update CSV: $($wanted.Count) app names read from column '$col'"
        $apps = @($apps | Where-Object { $wanted -ccontains $_.Name })
        $limitNorm = @{}
        foreach ($w in $wanted) { $limitNorm[(Get-NormName $w)] = $true }
    }
    $report = New-Object System.Collections.Generic.List[object]

    # List mode - export every app and tier to CSV
    if ($Mode -eq 'List') {
        Initialize-TierCache -Apps $apps
        $file = Join-Path $OutputDir "vrni_apps_$stamp.csv"
        Invoke-ListMode -Apps $apps | Export-Csv -Path $file -NoTypeInformation -Encoding UTF8
        Write-Host "Saved: $file"
    }
    # Update mode - existing vRNI apps only (NSX for the SG check, and the DFW policy names when renaming)
    elseif ($Mode -eq 'Update') {
        if ($wanted) { foreach ($m in @($wanted | Where-Object { $allApps.Name -cnotcontains $_ })) { $report.Add((New-Row $m 'Review' '' '' '' '' 'Review' 'Name from CSV not found in vRNI')) } }
        Initialize-Nsx -Credential $cred -NeedPolicies:($RenameApps -and $UseDfwNames) -NeedGroups:$NsxCrossCheck
        Initialize-TierCache -Apps $apps
        Initialize-LookupCache -Apps $apps
        Invoke-UpdateStep -Apps $apps -Report $report
        Save-Report -Report $report -Prefix 'vrni_tier_update'
        $c = Get-UpdateCounts -Report $report -AppNames @($apps.Name)
        Show-Step "Apps checked: $($apps.Count)   need changes: $($c.Change)   for review: $($c.Review)   already compliant: $($c.Ok)" 'Cyan'
    }
    # Create and Sync - the DFW policies (from every NSX Manager) are the list of applications
    else {
        Initialize-Nsx -Credential $cred -NeedPolicies -NeedGroups:$NsxCrossCheck
        $policies = @($script:NsxPolicies)
        if ($limitNorm) { $policies = @($policies | Where-Object { $limitNorm.ContainsKey((Get-NormName $_)) }) }

        # Which policy each vRNI app belongs to - by app name, then by FrontEnd SG name (needs the tiers of every app)
        Initialize-TierCache -Apps $allApps
        Show-Step 'Matching vRNI apps to DFW policies (app name, then FrontEnd SG name)...'
        $appPolicy = Resolve-AppPolicies -Apps $allApps
        $matched   = @($apps | Where-Object { $appPolicy[$_.Id] -and $appPolicy[$_.Id] -ne '?' })

        if ($wanted) {
            foreach ($m in @($wanted | Where-Object { ($allApps.Name -cnotcontains $_) -and -not ($policies | Where-Object { (Get-NormName $_) -eq (Get-NormName $m) }) })) {
                $report.Add((New-Row $m 'Review' '' '' '' '' 'Review' 'Name from CSV not found in vRNI or in the DFW policies'))
            }
        }

        if ($Mode -eq 'Sync') {
            Show-Step "Sync step 1 of 3 - update the $($matched.Count) apps that have a DFW policy" 'Cyan'
            Initialize-LookupCache -Apps $matched
            Invoke-UpdateStep -Apps $matched -Report $report
            Show-Step 'Sync step 2 of 3 - create apps for DFW policies that are not in vRNI' 'Cyan'
            Invoke-CreateStep -Policies $policies -AppPolicy $appPolicy -AllApps $allApps -Report $report -QuietExisting
            Show-Step 'Sync step 3 of 3 - apps in vRNI with no DFW policy' 'Cyan'
        } else {
            Invoke-CreateStep -Policies $policies -AppPolicy $appPolicy -AllApps $allApps -Report $report
        }
        $orph = Invoke-OrphanStep -Apps $apps -AppPolicy $appPolicy -AllAppCount $allApps.Count -Report $report

        Save-Report -Report $report -Prefix $(if ($Mode -eq 'Sync') { 'vrni_sync' } else { 'vrni_create' })
        $nNew = @($report | Where-Object { $_.Action -eq 'CreateApp' } | Select-Object -ExpandProperty Application -Unique).Count
        if ($Mode -eq 'Sync') {
            $c = Get-UpdateCounts -Report $report -AppNames @($matched.Name)
            Show-Step "Policies: $($policies.Count)   apps updated / to update: $($c.Change)   already compliant: $($c.Ok)   for review: $($c.Review)   new apps: $nNew   in vRNI only: $($orph[0])   to delete: $($orph[1])" 'Cyan'
        } else {
            $nExist  = @($report | Where-Object { $_.Result -eq 'Already in vRNI' }).Count
            $nReview = @($report | Where-Object { $_.Action -eq 'Review' }).Count
            Show-Step "Policies: $($policies.Count)   already in vRNI: $nExist   to create / created: $nNew   for review: $nReview   in vRNI only: $($orph[0])   to delete: $($orph[1])" 'Cyan'
        }
    }

    Show-Step ("Finished in {0} s" -f [math]::Round($swTotal.Elapsed.TotalSeconds)) 'Green'
}
finally {
    Disconnect-Vrni
}
