#Requires -Version 5.1
<#
    vrniAppTierUpdate.ps1
    List     - export vRNI applications and their tiers to CSV
    Update   - bring existing vRNI applications in line with the four-zone tier layout
    Create   - read the NSX distributed firewall security policy names (each policy = one application)
               and create any that are missing in vRNI, with the four zone tiers
    Sync     - Create and Update in one run: update the apps that have a DFW policy, create the missing ones,
               then report (or, with $RemoveOrphans, delete) vRNI apps that have no DFW policy
    One or more NSX Managers can be listed in $NsxServers - policies and groups are read from all of them.
    NSX security groups / tags are cross-checked and reported for every app.

    Tier layout (tier names are the zone names exactly):
        FrontEnd, Management, Internal, Protected
    Tier membership filter:
        Security Group = 'SG-<APP CI>-<Zone>'
    NSX tag expected per zone:
        ST-<APP_CI>-<Zone>      (spaces in the CI replaced with underscores)

    Tiers  : for existing apps the SG base is read from the app's FrontEnd filter; new apps use SG-<policy name>.
    Names  : new apps are named after their DFW policy; existing apps are only renamed with $RenameApps
             (to the DFW policy name). vRNI only allows letters, numbers, spaces, - and _ - other characters are dropped.
#>

#region CONFIG ---------------------------------------------------------------
# vRNI connection
$VrniServer          = '<vrni-fqdn>'                             # vRNI (Aria Operations for Networks) FQDN
$VidmServer          = ''                                        # blank = ask vRNI which vIDM appliance to use
$VidmDomain          = ''                                        # optional - only tried if the plain UPN login fails
$CredentialPath      = '<path-to-cred.xml>'                      # Export-Clixml PSCredential for vIDM / vRNI - if the file is missing you are prompted instead

# NSX connection - one or more NSX Managers (e.g. the management and the workload domain NSX)
$NsxServers          = '<nsx-manager-fqdn>'                      # one or more, e.g. @('<nsx-mgmt-fqdn>', '<nsx-wld-fqdn>') - policies and groups are read from all of them
$NsxCredentialPath   = ''                                        # Export-Clixml PSCredential for NSX - blank = reuse the vRNI login

# What to run
$Mode                = 'Update'                                  # 'List', 'Update', 'Create' or 'Sync' (Sync = create + update + orphan check in one run)
$DryRun              = $true                                     # Update / Create - $true = show the plan only, no changes in vRNI
$RenameApps          = $false                                    # Update - also rename each app to its SG-based name (spaces instead of _) - changes the name in vRNI
$UseDfwNames         = $true                                     # app rename only - the new app name comes from the NSX DFW policy name (tiers still follow the FrontEnd SG)

# Limit the run to some apps - CSV (column ApplicationName or Application) OR blank = all apps (Update / Create / Sync)
$UpdateCSV           = ''                                        # e.g. 'C:\Scripts\Input\vrniUpdate.csv'

# Tiers
$Zones               = @('FrontEnd', 'Management', 'Internal', 'Protected')   # Tier names (exactly these)

# Create / Sync - which DFW security policies count as applications, and what to do with apps that have no policy
$NsxPolicyCategories = @('Application')                          # DFW categories to read - blank array = all categories
$NsxPolicyExclude    = ''                                        # regex of policy names to skip, e.g. '^(Default|Sample)'
$RemoveOrphans       = $false                                    # Create / Sync - DELETE vRNI apps that have no DFW policy in NSX (asks Y/N/A/Q for each, separately)
$RemoveExclude       = ''                                        # regex of vRNI app names never to delete, e.g. '^(SDDC Manager|Other App)$'
$RemoveMaxPercent    = 25                                        # safety - delete nothing if more than this % of all apps would go

# Checks and API behaviour
$CheckTags           = $true                                     # look up the ST- tags in vRNI (only for apps that will change) - $false = skip the tag check
$NsxCrossCheck       = $true                                     # report whether the expected SGs (NSX) and tags (vRNI inventory) exist
$ShowProgress        = $true                                     # progress bar plus a status line for each step / app
$FastNameLookup      = $true                                     # try to get app names from the list / bulk summary calls before one call per app
$MaxCallsPerSecond   = 5                                         # API limiter - most calls per second across the whole script, parallel readers included (0 = no limit)
$RequestDelayMs      = 0                                         # extra pause after every call, on top of the limiter (normally 0)
$MaxRetries          = 5                                         # retries on HTTP 429, backing off each time
$TimeoutSec          = 60                                        # give up on a call that gets no answer after this many seconds (5.1 otherwise waits forever)
$Threads             = 4                                         # parallel tier reads (1 = one at a time) - lower it if you see 429 lines

# Output
$OutputDir           = '.\Reports'                               # CSV reports are written here
$SkipCertCheck       = $true                                     # bypass self-signed certificate errors
#endregion CONFIG ------------------------------------------------------------

$ErrorActionPreference = 'Stop'
$script:Base       = "https://$VrniServer/api/ni"
$script:Token      = $null
$script:ApproveAll = @{}
$script:QuitNow    = $false
$script:NsxSessions = @{}
$script:NsxPolicies = @()
$script:NsxGroupTable = $null
$script:TierCache  = $null
$script:LookupCache = $null
$script:AppNames   = $null
$script:TagSet     = $null
$script:SgSet      = $null
$script:PolicyByNorm = $null
# API limiter shared by the main script and every parallel reader - one slot every (1000 / $MaxCallsPerSecond) ms
$script:Limiter    = [hashtable]::Synchronized(@{ Next = [DateTime]::UtcNow; IntervalMs = $(if ($MaxCallsPerSecond -gt 0) { 1000.0 / $MaxCallsPerSecond } else { 0 }) })

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
# .NET Framework defaults that slow parallel calls in Windows PowerShell 5.1:
#   only 2 connections per server, and every POST waits for a "100-continue" reply before sending its body
[Net.ServicePointManager]::DefaultConnectionLimit = [math]::Max(16, $Threads * 2)
[Net.ServicePointManager]::Expect100Continue      = $false
[Net.ServicePointManager]::UseNagleAlgorithm      = $false
if ($SkipCertCheck -and -not ('TrustAllCertsPolicy' -as [type])) {
    Add-Type @"
using System.Net;
using System.Security.Cryptography.X509Certificates;
public class TrustAllCertsPolicy : ICertificatePolicy {
    public bool CheckValidationResult(ServicePoint sp, X509Certificate c, WebRequest r, int p) { return true; }
}
"@
    [Net.ServicePointManager]::CertificatePolicy = New-Object TrustAllCertsPolicy
}

#region helpers --------------------------------------------------------------
# Timestamped status line
function Show-Step {
    param([string]$Text, [string]$Color = 'White')
    Write-Host ("[{0}] {1}" -f (Get-Date -Format 'HH:mm:ss'), $Text) -ForegroundColor $Color
}

# Pull vRNI's / NSX's error text out of a failed call - Windows PowerShell 5.1 hides it by default
function Get-ErrorText {
    param($ErrorRecord)
    $msg = $ErrorRecord.Exception.Message
    # Invoke-RestMethod has usually read the reply already - its text is then in ErrorDetails
    if ($ErrorRecord.ErrorDetails -and $ErrorRecord.ErrorDetails.Message) { return "$msg | $($ErrorRecord.ErrorDetails.Message)" }
    try {
        $resp = $ErrorRecord.Exception.Response
        if ($resp) {
            $sr   = New-Object System.IO.StreamReader($resp.GetResponseStream())
            $body = $sr.ReadToEnd()
            if ($body) { $msg = "$msg | $body" }
        }
    } catch {}
    $msg
}

# API limiter - each call takes the next free time slot, so the whole script stays under $MaxCallsPerSecond
#   Wait-ApiSlot  : wait for this call's slot
#   Push-ApiPause : after a 429, hold every caller (main script and readers) until the pause is over
function Wait-ApiSlot {
    param($L)
    if (-not $L -or $L.IntervalMs -le 0) { return }
    [System.Threading.Monitor]::Enter($L.SyncRoot)
    try {
        $now  = [DateTime]::UtcNow
        $slot = if ($L.Next -gt $now) { $L.Next } else { $now }
        $L.Next = $slot.AddMilliseconds($L.IntervalMs)
    } finally { [System.Threading.Monitor]::Exit($L.SyncRoot) }
    $ms = ($slot - [DateTime]::UtcNow).TotalMilliseconds
    if ($ms -gt 0) { Start-Sleep -Milliseconds ([int][math]::Ceiling($ms)) }
}
function Push-ApiPause {
    param($L, [double]$Seconds)
    if (-not $L) { Start-Sleep -Seconds $Seconds; return }
    [System.Threading.Monitor]::Enter($L.SyncRoot)
    try { $until = [DateTime]::UtcNow.AddSeconds($Seconds); if ($L.Next -lt $until) { $L.Next = $until } }
    finally { [System.Threading.Monitor]::Exit($L.SyncRoot) }
}

# Generic REST call - JSON body unless told otherwise, retries on HTTP 429 (Retry-After if given, else backoff)
function Invoke-Api {
    param(
        [string]$Method = 'GET',
        [Parameter(Mandatory)][string]$Uri,
        $Body,
        [hashtable]$Headers = @{},
        [string]$ContentType = 'application/json'
    )
    $ProgressPreference = 'SilentlyContinue'   # 5.1 draws a progress bar for every web call, which slows it down
    $p = @{ Method = $Method; Uri = $Uri; Headers = $Headers; ContentType = $ContentType; UseBasicParsing = $true; TimeoutSec = $TimeoutSec }
    if ($null -ne $Body) {
        if ($ContentType -eq 'application/json' -and $Body -isnot [string]) { $Body = $Body | ConvertTo-Json -Depth 10 }
        $p.Body = $Body
    }
    # PowerShell 7 rejects a plain number in If-Match - skip its header check (Windows PowerShell 5.1 does not need this)
    if ($Headers.ContainsKey('If-Match') -and $PSVersionTable.PSVersion.Major -ge 6) { $p.SkipHeaderValidation = $true }
    for ($try = 0; $try -le $MaxRetries; $try++) {
        try {
            Wait-ApiSlot $script:Limiter
            $r = Invoke-RestMethod @p
            if ($RequestDelayMs) { Start-Sleep -Milliseconds $RequestDelayMs }
            return $r
        } catch {
            $code = 0
            $resp = $_.Exception.Response
            if ($resp) { $code = [int]$resp.StatusCode }
            if ($code -eq 429 -and $try -lt $MaxRetries) {
                $wait = [math]::Pow(2, $try) * 2
                try { $ra = $resp.Headers['Retry-After']; if ($ra) { $wait = [int]$ra } } catch {}
                Write-Host "429 from vRNI - pausing all calls for $wait s (retry $($try + 1)/$MaxRetries)" -ForegroundColor Yellow
                Push-ApiPause $script:Limiter $wait
                continue
            }
            throw (Get-ErrorText $_)
        }
    }
}

# vRNI call - adds the NetworkInsight token header to Invoke-Api
function Invoke-Vrni {
    param([string]$Method = 'GET', [string]$Path, $Body, [hashtable]$Extra = @{})
    $h = @{ Authorization = "NetworkInsight $script:Token"; Accept = 'application/json' }
    foreach ($k in $Extra.Keys) { $h[$k] = $Extra[$k] }
    Invoke-Api -Method $Method -Uri "$script:Base$Path" -Body $Body -Headers $h
}

# vIDM login, then exchange the vIDM token for a vRNI token
function Connect-Vrni {
    param([pscredential]$Credential)
    # 1. Ask vRNI which vIDM appliance and OAuth client-id it uses
    Show-Step "Connecting to vRNI ($VrniServer) - asking for the vIDM client-id (1/3)"
    $client = Invoke-Api -Uri "$script:Base/auth/vidm/client-id"
    $vidm   = if ($VidmServer) { $VidmServer } else { $client.vidm_appliance }
    if (-not $client.client_id -or -not $vidm) { throw 'Could not get vIDM client-id/appliance from vRNI.' }

    # 2. Get a user access token from vIDM (password grant) - plain UPN first, domain only as a fallback
    #    (keeps failed logins down so the account is not locked out)
    Show-Step "vIDM appliance: $vidm"
    $attempts = @(@{ Domain = '' })
    if ($VidmDomain) { $attempts += @{ Domain = $VidmDomain } }

    $vidmToken = $null
    $n = 0
    foreach ($a in $attempts) {
        $n++
        $how = if ($a.Domain) { 'with domain field' } else { 'plain username' }
        Show-Step "vIDM login attempt $n of $($attempts.Count) ($how) (2/3)"
        $form = @{
            grant_type = 'password'
            username   = $Credential.UserName
            password   = $Credential.GetNetworkCredential().Password
            client_id  = $client.client_id
        }
        if ($a.Domain) { $form.domain = $a.Domain }
        try {
            $vidmToken = Invoke-Api -Method POST -Uri "https://$vidm/SAAS/auth/oauthtoken" `
                -Body $form -ContentType 'application/x-www-form-urlencoded'
            $form.password = $null
            if ($vidmToken.access_token) { Show-Step 'vIDM login OK' 'Green'; break }
        } catch {
            $form.password = $null
            Write-Host "vIDM login attempt failed: $_" -ForegroundColor Yellow
        }
    }
    if (-not $vidmToken -or -not $vidmToken.access_token) { throw 'vIDM did not return an access_token.' }

    # 3. Exchange the vIDM token for a vRNI token
    Show-Step 'Exchanging the vIDM token for a vRNI token (3/3)'
    $ni = Invoke-Api -Method POST -Uri "$script:Base/auth/token/vidm" -Body @{ vidm_token = $vidmToken.access_token }
    if (-not $ni.token) { throw 'vRNI did not return a token.' }
    $script:Token = $ni.token
    Show-Step 'vRNI login OK' 'Green'
}

# Delete the vRNI token at the end - each user is limited to 100 valid tokens
function Disconnect-Vrni {
    if ($script:Token) { try { Invoke-Vrni -Method DELETE -Path '/auth/token' | Out-Null } catch {} }
}

# Cursor-based paging for list calls (size=100 per page) - pass -Label to show each page as it is read
function Get-Paged {
    param([string]$Path, [string]$Label, [int]$Size = 100)
    $all = @(); $cursor = $null; $page = 0
    do {
        $page++
        $sep = if ($Path.Contains('?')) { '&' } else { '?' }
        $uri = "$Path${sep}size=$Size"
        if ($cursor) { $uri += "&cursor=$cursor" }
        $r = Invoke-Vrni -Path $uri
        if ($r.results) { $all += @($r.results) }
        if ($Label) { Show-Step "  $Label page ${page}: $(@($r.results).Count) entries (total $($all.Count))" }
        $cursor = $r.cursor
    } while ($cursor -and $r.results -and @($r.results).Count -gt 0)
    $all
}

# Y / N / A (yes to all) / Q (quit) prompt used before each app is changed - 'All' only covers the same kind ('change' or 'delete')
function Get-UserConfirm {
    param([string]$Prompt, [string]$Kind = 'change')
    if ($script:ApproveAll[$Kind]) { return 'Y' }
    do { $a = (Read-Host "$Prompt [Y]es / [N]o / [A]ll / [Q]uit").Trim().ToUpper() } until ($a -in 'Y','N','A','Q')
    if ($a -eq 'A') { $script:ApproveAll[$Kind] = $true; return 'Y' }
    $a
}

# One row of the output CSV (no entity IDs - names only)
function New-Row {
    param($App, $Action, $Tier, $Filter, $SgInNsx, $TagInNsx, $Result, $Note)
    [pscustomobject]@{
        Application = $App; Action = $Action; TierName = $Tier; Filter = $Filter
        SgInNsx = $SgInNsx; TagInNsx = $TagInNsx; Result = $Result; Note = $Note
    }
}

# Looks for an NSX object by name in vRNI's inventory - returns Found / Missing / Error / NotChecked
# Informational only: SGs for the other zones may not exist in NSX yet
function Test-VrniEntity {
    param([string]$EntityType, [string]$Name)
    if (-not $NsxCrossCheck) { return 'NotChecked' }
    if ($EntityType -eq 'SecurityTag' -and $script:TagSet) { if ($script:TagSet.Contains($Name)) { return 'Found' } else { return 'Missing' } }
    if ($EntityType -eq 'BaseSecurityGroup' -and $script:SgSet) { if ($script:SgSet.Contains($Name)) { return 'Found' } else { return 'Missing' } }
    $key = "$EntityType|$Name"
    if ($script:LookupCache -and $script:LookupCache.ContainsKey($key)) { return $script:LookupCache[$key] }
    try {
        $r = Invoke-Vrni -Method POST -Path '/search' -Body @{
            entity_type = $EntityType
            filter      = "name = '$Name'"
            size        = 1
        }
        if ($r.results -and @($r.results).Count -gt 0) { 'Found' } else { 'Missing' }
    } catch { 'Error' }
}

# SG check - uses the NSX group table when it was loaded (no API call), otherwise one vRNI search per name
function Get-SgStatus {
    param([string]$Name)
    if (-not $NsxCrossCheck) { return 'NotChecked' }
    if ($script:NsxGroupTable) { if ($script:NsxGroupTable.ContainsKey($Name)) { return 'Found' } else { return 'Missing' } }
    Test-VrniEntity -EntityType 'BaseSecurityGroup' -Name $Name
}

# Turn one tier detail (as vRNI returns it) into: name, id, the Security Group filters, count of non-search criteria
function ConvertTo-TierInfo {
    param($Detail, [string]$Id)
    $filters = @(); $other = 0; $crit = @()
    foreach ($c in @($Detail.group_membership_criteria)) {
        if ($c.membership_type -eq 'SearchMembershipCriteria' -and $c.search_membership_criteria.filter) {
            $filters += [string]$c.search_membership_criteria.filter
            $crit    += [pscustomobject]@{ EntityType = [string]$c.search_membership_criteria.entity_type; Filter = [string]$c.search_membership_criteria.filter }
        } else { $other++ }
    }
    [pscustomobject]@{ Name = $Detail.name; Id = $Id; Filters = $filters; OtherCriteria = $other; Criteria = $crit }
}

# Read every tier of an app one call at a time (used when the parallel read is off or failed for that app)
function Get-AppTiers {
    param([string]$AppId)
    $out = @()
    foreach ($ref in (Get-Paged -Path "/groups/applications/$AppId/tiers")) {
        $out += ConvertTo-TierInfo -Detail (Invoke-Vrni -Path "/groups/tiers/$($ref.entity_id)") -Id $ref.entity_id
    }
    $out
}

# Run a read-only worker script block once per argument set, $Threads at a time - returns one result per set
#   - each worker call gets its own runspace from a small pool, so nothing is shared except the results
function Invoke-Parallel {
    param([scriptblock]$Worker, $ArgSets, [string]$Label, $Shared)
    $total = @($ArgSets).Count
    $pool  = [runspacefactory]::CreateRunspacePool(1, $Threads)
    $pool.Open()
    $jobs = New-Object System.Collections.Generic.List[object]
    foreach ($set in $ArgSets) {
        $ps = [powershell]::Create()
        $ps.RunspacePool = $pool
        [void]$ps.AddScript($Worker.ToString())
        foreach ($arg in $set) { [void]$ps.AddArgument($arg) }
        $jobs.Add([pscustomobject]@{ Ps = $ps; Handle = $ps.BeginInvoke() })
    }
    $lastShown = 0
    do {
        $done = @($jobs | Where-Object { $_.Handle.IsCompleted }).Count
        $extra = ''
        if ($Shared) { $extra = "  (429 waits: $($Shared.Hit429), $([math]::Round($Shared.Wait)) s waited)" }
        if ($ShowProgress) { Write-Progress -Activity $Label -Status "$done / $total$extra" -PercentComplete (($done / [math]::Max($total, 1)) * 100) }
        if ($done - $lastShown -ge 25) { $lastShown = $done; Show-Step "  $Label`: $done / $total$extra" }
        if ($done -lt $total) { Start-Sleep -Milliseconds 300 }
    } while ($done -lt $total)
    Write-Progress -Activity $Label -Completed
    $results = foreach ($j in $jobs) {
        @($j.Ps.EndInvoke($j.Handle)) | Select-Object -First 1
        $j.Ps.Dispose()
    }
    $pool.Close(); $pool.Dispose()
    @($results)
}

# Read the tiers of all apps up front ($Threads at a time) and keep them in $script:TierCache
#   - read-only GETs (tier list, then each tier) with their own 429 back-off
#   - anything that fails here is simply read again one at a time later
function Initialize-TierCache {
    param($Apps)
    $script:TierCache = @{}
    $total = @($Apps).Count
    if ($Threads -le 1 -or $total -lt 2) { return }

    $worker = {
        param($Base, $Token, $AppId, $Delay, $Retries, $Shared)
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        $ProgressPreference = 'SilentlyContinue'
        function Wait-ApiSlot {
            param($L)
            if (-not $L -or $L.IntervalMs -le 0) { return }
            [System.Threading.Monitor]::Enter($L.SyncRoot)
            try { $now = [DateTime]::UtcNow; $slot = if ($L.Next -gt $now) { $L.Next } else { $now }; $L.Next = $slot.AddMilliseconds($L.IntervalMs) }
            finally { [System.Threading.Monitor]::Exit($L.SyncRoot) }
            $ms = ($slot - [DateTime]::UtcNow).TotalMilliseconds
            if ($ms -gt 0) { Start-Sleep -Milliseconds ([int][math]::Ceiling($ms)) }
        }
        function Push-ApiPause {
            param($L, [double]$Seconds)
            if (-not $L) { Start-Sleep -Seconds $Seconds; return }
            [System.Threading.Monitor]::Enter($L.SyncRoot)
            try { $until = [DateTime]::UtcNow.AddSeconds($Seconds); if ($L.Next -lt $until) { $L.Next = $until } }
            finally { [System.Threading.Monitor]::Exit($L.SyncRoot) }
        }
        $swApp = [Diagnostics.Stopwatch]::StartNew(); $calls = 0; $busy = 0.0
        function Get-One {
            param($Path)
            $hdr = @{ Authorization = "NetworkInsight $Token"; Accept = 'application/json' }
            for ($t = 0; $t -le $Retries; $t++) {
                try {
                    Wait-ApiSlot $Shared.Limiter
                    $one = [Diagnostics.Stopwatch]::StartNew()
                    $r = Invoke-RestMethod -Method GET -Uri "$Base$Path" -Headers $hdr -ContentType 'application/json' -UseBasicParsing -TimeoutSec 120
                    $script:calls++; $script:busy += $one.Elapsed.TotalSeconds
                    if ($Delay) { Start-Sleep -Milliseconds $Delay }
                    return $r
                } catch {
                    $code = 0; $resp = $_.Exception.Response
                    if ($resp) { $code = [int]$resp.StatusCode }
                    if ($code -eq 429 -and $t -lt $Retries) { $w = [math]::Min([math]::Pow(2, $t) * 2, 8); try { $ra = $resp.Headers['Retry-After']; if ($ra) { $w = [int]$ra } } catch {}; $Shared.Hit429++; $Shared.Wait += $w; Push-ApiPause $Shared.Limiter $w; continue }
                    throw
                }
            }
        }
        try {
            $refs = @(); $cursor = $null
            do {
                $uri = "/groups/applications/$AppId/tiers?size=100"
                if ($cursor) { $uri += "&cursor=$cursor" }
                $r = Get-One $uri
                if ($r.results) { $refs += @($r.results) }
                $cursor = $r.cursor
            } while ($cursor -and $r.results -and @($r.results).Count -gt 0)
            $items = @()
            foreach ($ref in $refs) { $items += [pscustomobject]@{ Id = $ref.entity_id; Detail = (Get-One "/groups/tiers/$($ref.entity_id)") } }
            [pscustomobject]@{ AppId = $AppId; Items = $items; Error = $null; Seconds = $swApp.Elapsed.TotalSeconds; Calls = $calls; Busy = $busy; Tiers = @($refs).Count }
        } catch {
            [pscustomobject]@{ AppId = $AppId; Items = @(); Error = "$_"; Seconds = $swApp.Elapsed.TotalSeconds; Calls = $calls; Busy = $busy; Tiers = 0 }
        }
    }

    Show-Step "Reading the tiers of $total apps, $Threads at a time..." 'Cyan'
    $sw = [Diagnostics.Stopwatch]::StartNew()
    $shared = [hashtable]::Synchronized(@{ Hit429 = 0; Wait = 0.0; Limiter = $script:Limiter })
    $sets = foreach ($a in $Apps) { ,@($script:Base, $script:Token, $a.Id, $RequestDelayMs, $MaxRetries, $shared) }
    $failed = 0
    $stats = New-Object System.Collections.Generic.List[object]
    $nameById = @{}; foreach ($a in $Apps) { $nameById[$a.Id] = $a.Name }
    foreach ($res in (Invoke-Parallel -Worker $worker -ArgSets $sets -Label 'Reading tiers' -Shared $shared)) {
        if ($res) { $stats.Add($res) }
        if ($res -and -not $res.Error) {
            $script:TierCache[$res.AppId] = @($res.Items | ForEach-Object { ConvertTo-TierInfo -Detail $_.Detail -Id $_.Id })
        } else { $failed++ }
    }
    $color = if ($failed -gt 0) { 'Yellow' } else { 'Green' }
    Show-Step "Tiers read for $($script:TierCache.Count) of $total apps in $([math]::Round($sw.Elapsed.TotalSeconds)) s (failed: $failed - those are read again one at a time)" $color
    if ($shared.Hit429 -gt 0) { Show-Step "  vRNI throttled (429) $($shared.Hit429) times, $([math]::Round($shared.Wait)) s spent waiting across the readers - if this is high, lower `$Threads" 'Yellow' }

    # Where the time went - helps tell a slow vRNI from too few readers
    $calls = ($stats | Measure-Object -Property Calls -Sum).Sum
    $busy  = ($stats | Measure-Object -Property Busy  -Sum).Sum
    $tiersTotal = ($stats | Measure-Object -Property Tiers -Sum).Sum
    if ($calls -gt 0) {
        Show-Step ("  {0} calls for {1} tiers, {2:N2} s average per call (wall clock {3} s with {4} readers)" -f $calls, $tiersTotal, ($busy / $calls), [math]::Round($sw.Elapsed.TotalSeconds), $Threads)
        $slow = $stats | Sort-Object Seconds -Descending | Select-Object -First 3
        foreach ($x in $slow) { Show-Step ("  slowest: {0} - {1:N1} s, {2} tiers" -f $nameById[$x.AppId], $x.Seconds, $x.Tiers) }
    }
}

# Every name of one vRNI entity type in a few calls: the list (1000 per page), then names in batches of 1000
#   - returns a case-insensitive set, or $null if the list or names call is not usable on this vRNI
function Get-VrniEntityNames {
    param([string]$ListPath, [string]$Label)
    try {
        $refs = @(Get-Paged -Path $ListPath -Label $Label -Size 1000)
        $set  = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
        $need = New-Object System.Collections.Generic.List[string]
        foreach ($r in $refs) { if ($r.entity_name) { [void]$set.Add([string]$r.entity_name) } elseif ($r.entity_id) { $need.Add([string]$r.entity_id) } }
        for ($i = 0; $i -lt $need.Count; $i += 1000) {
            $batch = @($need[$i..([math]::Min($i + 999, $need.Count - 1))] | ForEach-Object { @{ entity_id = $_ } })
            $res = Invoke-Vrni -Method POST -Path '/entities/names' -Body @{ entities = $batch }
            foreach ($x in @($res.results)) { $n = if ($x.entity_name) { $x.entity_name } elseif ($x.name) { $x.name } else { $null }; if ($n) { [void]$set.Add([string]$n) } }
        }
        if ($set.Count -eq 0) { Show-Step "  $Label`: no names returned - falling back to one search per name" 'Yellow'; return $null }
        Show-Step "  $Label`: $($set.Count) names loaded in bulk" 'Green'
        # A few real names, so the naming the script expects can be compared with what vRNI actually holds
        $sample = @($set | Where-Object { $_ -like 'S[TG]-*' } | Select-Object -First 3)
        if ($sample.Count -eq 0) { $sample = @($set | Select-Object -First 3) }
        foreach ($x in $sample) { Show-Step "    example name in vRNI: $x" }
        return ,$set
    } catch { Show-Step "  $Label`: bulk load not usable ($_) - falling back to one search per name" 'Yellow'; return $null }
}

# Look up every SG / tag name the check will need, $Threads at a time, so the per-app check makes no API calls
#   - SG names only when the NSX group table was not loaded
#   - tag names only for apps that are missing at least one zone tier (the same apps the tag lookup is done for)
function Initialize-LookupCache {
    param($Apps)
    $script:LookupCache = @{}
    if (-not $NsxCrossCheck) { return }

    # Bulk first - a few calls for every tag / SG name, instead of one search per name
    if ($CheckTags) { Show-Step 'Loading all security tag names from vRNI...'; $script:TagSet = Get-VrniEntityNames -ListPath '/entities/security-tags' -Label 'security tags' }
    if (-not $script:NsxGroupTable) { Show-Step 'Loading all security group names from vRNI...'; $script:SgSet = Get-VrniEntityNames -ListPath '/entities/security-groups' -Label 'security groups' }

    if ($Threads -le 1 -or -not $script:TierCache) { return }

    $wanted = New-Object System.Collections.Generic.HashSet[string]
    foreach ($a in $Apps) {
        $tiers = $script:TierCache[$a.Id]
        if (-not $tiers) { continue }
        $base = $null
        foreach ($t in $tiers) { foreach ($f in $t.Filters) { if (-not $base -and $f -match "^Security Group = '(?<sg>SG-.+)-FrontEnd'$") { $base = $Matches['sg'] } } }
        if (-not $base) { continue }
        $tagBase = 'ST-' + ($base.Substring(3) -replace '\s+', '_')
        $names   = @($tiers | ForEach-Object { $_.Name })
        $needs   = @($Zones | Where-Object { $names -cnotcontains $_ }).Count -gt 0
        foreach ($z in $Zones) {
            if (-not $script:NsxGroupTable -and -not $script:SgSet) { [void]$wanted.Add("BaseSecurityGroup|$base-$z") }
            if ($CheckTags -and $needs -and -not $script:TagSet)  { [void]$wanted.Add("SecurityTag|$tagBase-$z") }
        }
    }
    if ($wanted.Count -eq 0) { return }

    $worker = {
        param($Base, $Token, $Type, $Name, $Delay, $Retries, $Shared)
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        $ProgressPreference = 'SilentlyContinue'
        function Wait-ApiSlot {
            param($L)
            if (-not $L -or $L.IntervalMs -le 0) { return }
            [System.Threading.Monitor]::Enter($L.SyncRoot)
            try { $now = [DateTime]::UtcNow; $slot = if ($L.Next -gt $now) { $L.Next } else { $now }; $L.Next = $slot.AddMilliseconds($L.IntervalMs) }
            finally { [System.Threading.Monitor]::Exit($L.SyncRoot) }
            $ms = ($slot - [DateTime]::UtcNow).TotalMilliseconds
            if ($ms -gt 0) { Start-Sleep -Milliseconds ([int][math]::Ceiling($ms)) }
        }
        function Push-ApiPause {
            param($L, [double]$Seconds)
            if (-not $L) { Start-Sleep -Seconds $Seconds; return }
            [System.Threading.Monitor]::Enter($L.SyncRoot)
            try { $until = [DateTime]::UtcNow.AddSeconds($Seconds); if ($L.Next -lt $until) { $L.Next = $until } }
            finally { [System.Threading.Monitor]::Exit($L.SyncRoot) }
        }
        $hdr  = @{ Authorization = "NetworkInsight $Token"; Accept = 'application/json' }
        $body = @{ entity_type = $Type; filter = "name = '$Name'"; size = 1 } | ConvertTo-Json
        $value = 'Error'
        for ($t = 0; $t -le $Retries; $t++) {
            try {
                Wait-ApiSlot $Shared.Limiter
                $r = Invoke-RestMethod -Method POST -Uri "$Base/search" -Headers $hdr -Body $body -ContentType 'application/json' -UseBasicParsing -TimeoutSec 120
                if ($Delay) { Start-Sleep -Milliseconds $Delay }
                $value = if ($r.results -and @($r.results).Count -gt 0) { 'Found' } else { 'Missing' }
                break
            } catch {
                $code = 0; $resp = $_.Exception.Response
                if ($resp) { $code = [int]$resp.StatusCode }
                if ($code -eq 429 -and $t -lt $Retries) { $w = [math]::Min([math]::Pow(2, $t) * 2, 8); try { $ra = $resp.Headers['Retry-After']; if ($ra) { $w = [int]$ra } } catch {}; $Shared.Hit429++; $Shared.Wait += $w; Push-ApiPause $Shared.Limiter $w; continue }
                break
            }
        }
        [pscustomobject]@{ Key = "$Type|$Name"; Value = $value }
    }

    Show-Step "Looking up $($wanted.Count) SG / tag names, $Threads at a time..." 'Cyan'
    $sw   = [Diagnostics.Stopwatch]::StartNew()
    $shared = [hashtable]::Synchronized(@{ Hit429 = 0; Wait = 0.0; Limiter = $script:Limiter })
    $sets = foreach ($k in $wanted) { $type, $name = $k.Split('|', 2); ,@($script:Base, $script:Token, $type, $name, $RequestDelayMs, $MaxRetries, $shared) }
    foreach ($res in (Invoke-Parallel -Worker $worker -ArgSets $sets -Label 'Looking up names' -Shared $shared)) {
        if ($res -and $res.Value -ne 'Error') { $script:LookupCache[$res.Key] = $res.Value }
    }
    Show-Step "Lookups done in $([math]::Round($sw.Elapsed.TotalSeconds)) s ($($script:LookupCache.Count) of $($wanted.Count) answered)" 'Green'
}

# Request body for a tier - VMs where Security Group = '<SG name>'
function New-TierBody {
    param([string]$Name, [string]$Filter)
    @{
        name = $Name
        group_membership_criteria = @(@{
            membership_type            = 'SearchMembershipCriteria'
            search_membership_criteria = @{ entity_type = 'BaseVirtualMachine'; filter = $Filter }
        })
    }
}

# NSX Manager session login (/api/session/create) - same approach as the NSX audit scripts
#   - tries the bare username first (DOMAIN\user or user@domain stripped to user), then the name as saved
#   - reuses the vRNI login unless $NsxCredentialPath is set; one session is kept per NSX Manager
function Connect-Nsx {
    param([string]$Server, [pscredential]$Credential)
    $c = $Credential
    if ($NsxCredentialPath) { $c = Import-Clixml -LiteralPath $NsxCredentialPath }
    if (-not $c) { throw 'No NSX credential supplied.' }

    $raw = $c.UserName
    if     ($raw -match '^(.+)\\(.+)$') { $bare = $Matches[2] }
    elseif ($raw -match '^([^@]+)@')     { $bare = $Matches[1] }
    else                                 { $bare = $raw }
    $tryNames = @($bare)
    if ($raw -ne $bare) { $tryNames += $raw }

    $ProgressPreference = 'SilentlyContinue'
    $pw = $c.GetNetworkCredential().Password
    $lastErr = ''
    $n = 0
    foreach ($u in $tryNames) {
        $n++
        $fmt = if ($n -eq 1 -and $raw -ne $bare) { 'bare username' } else { 'username as saved' }
        Show-Step "NSX login to $Server - attempt $n of $($tryNames.Count) ($fmt)"
        $body = "j_username=$([uri]::EscapeDataString($u))&j_password=$([uri]::EscapeDataString($pw))"
        try {
            $r = Invoke-WebRequest -Method POST -Uri "https://$Server/api/session/create" -Body $body -ContentType 'application/x-www-form-urlencoded' -SessionVariable nsxSess -UseBasicParsing -TimeoutSec $TimeoutSec
            $x = $r.Headers['X-XSRF-TOKEN']
            if ($x -is [array]) { $x = $x[0] }
            if (-not $x) { $lastErr = 'no X-XSRF-TOKEN returned'; Show-Step "  NSX login attempt $n - $lastErr" 'Yellow'; continue }
            $script:NsxSessions[$Server] = @{ Session = $nsxSess; Xsrf = $x }
            $pw = $null; $body = $null
            Show-Step "NSX login OK ($Server)" 'Green'
            return
        } catch {
            $lastErr = Get-ErrorText $_
            Show-Step "  NSX login attempt $n failed: $lastErr" 'Yellow'
        }
    }
    $pw = $null; $body = $null
    throw "NSX login to $Server failed ($lastErr) - check the username format NSX expects, or point `$NsxCredentialPath at a separate NSX credential file"
}

# NSX Manager call - that manager's session cookie plus XSRF token (read only)
function Invoke-Nsx {
    param([string]$Server, [string]$Path)
    $ProgressPreference = 'SilentlyContinue'
    $sess = $script:NsxSessions[$Server]
    if (-not $sess) { throw "Not logged in to NSX Manager $Server" }
    $p = @{
        Method = 'GET'; Uri = "https://$Server$Path"; WebSession = $sess.Session
        Headers = @{ 'X-XSRF-TOKEN' = $sess.Xsrf; Accept = 'application/json' }
        ContentType = 'application/json'; UseBasicParsing = $true; TimeoutSec = $TimeoutSec
    }
    Wait-ApiSlot $script:Limiter
    try { $r = Invoke-RestMethod @p } catch { throw (Get-ErrorText $_) }
    if ($RequestDelayMs) { Start-Sleep -Milliseconds $RequestDelayMs }
    $r
}

# Cursor-based paging for NSX Policy list calls
function Get-NsxPaged {
    param([string]$Server, [string]$Path)
    $all = @(); $cursor = $null
    do {
        $sep = if ($Path.Contains('?')) { '&' } else { '?' }
        $uri = $Path
        if ($cursor) { $uri += "${sep}cursor=$cursor" }
        $r = Invoke-Nsx -Server $Server -Path $uri
        if ($r.results) { $all += @($r.results) }
        $cursor = $r.cursor
    } while ($cursor)
    $all
}

# DFW security policy names on one NSX Manager = its application list (default / system policies and excluded names dropped)
function Get-NsxPolicyNames {
    param([string]$Server)
    $pol = @(Get-NsxPaged -Server $Server -Path '/policy/api/v1/infra/domains/default/security-policies')
    $names = foreach ($x in $pol) {
        if ($x.is_default -or $x._system_owned) { continue }
        if ($NsxPolicyCategories.Count -gt 0 -and $NsxPolicyCategories -notcontains $x.category) { continue }
        if ($NsxPolicyExclude -and $x.display_name -match $NsxPolicyExclude) { continue }
        $x.display_name
    }
    @($names | Where-Object { $_ } | Sort-Object -Unique)
}

# Every group display name on one NSX Manager, case-insensitive lookup table (used to report which SGs exist)
function Get-NsxGroupNames {
    param([string]$Server)
    $t = New-Object System.Collections.Hashtable([StringComparer]::OrdinalIgnoreCase)
    foreach ($g in (Get-NsxPaged -Server $Server -Path '/policy/api/v1/infra/domains/default/groups')) { $t[[string]$g.display_name] = $true }
    $t
}

# Log in to every NSX Manager in $NsxServers and read what this run needs from all of them
#   -NeedPolicies : DFW policy names (they drive creates, renames and deletes) - every manager must answer, or the run stops,
#                   because a partial list would make apps look like they have no policy
#   -NeedGroups   : group names for the SG check - if any manager fails, the SG check falls back to vRNI
function Initialize-Nsx {
    param([pscredential]$Credential, [switch]$NeedPolicies, [switch]$NeedGroups)
    $servers = @($NsxServers | Where-Object { $_ -and $_ -notlike '<*' })
    if ($servers.Count -eq 0) {
        if ($NeedPolicies) { throw 'No NSX Manager set in $NsxServers - this needs the DFW policy names' }
        return
    }
    if (-not $NeedPolicies -and -not $NeedGroups) { return }

    $policySet = New-Object 'System.Collections.Generic.HashSet[string]'
    $groups    = New-Object System.Collections.Hashtable([StringComparer]::OrdinalIgnoreCase)
    $groupsOk  = [bool]$NeedGroups
    foreach ($srv in $servers) {
        try { Connect-Nsx -Server $srv -Credential $Credential }
        catch {
            if ($NeedPolicies) { throw "$_ - every NSX Manager must be read for the DFW policy list" }
            Show-Step "$_ - checking SGs through vRNI instead" 'Yellow'; $groupsOk = $false; continue
        }
        if ($NeedPolicies) {
            $pn = @(Get-NsxPolicyNames -Server $srv)
            foreach ($x in $pn) { [void]$policySet.Add($x) }
            Show-Step "  $srv`: $($pn.Count) DFW application policies" 'Green'
        }
        if ($groupsOk) {
            try {
                $g = Get-NsxGroupNames -Server $srv
                foreach ($k in $g.Keys) { $groups[$k] = $true }
                Show-Step "  $srv`: $($g.Count) groups" 'Green'
            } catch { $groupsOk = $false; Show-Step "NSX login to $srv worked but reading the groups failed ($_) - checking SGs through vRNI instead" 'Yellow' }
        }
    }

    if ($NeedPolicies) {
        $script:NsxPolicies = @($policySet | Sort-Object)
        if ($script:NsxPolicies.Count -eq 0) { throw 'No DFW policies were read from NSX - check $NsxPolicyCategories' }
        $script:PolicyByNorm = @{}
        foreach ($x in $script:NsxPolicies) {
            $k = Get-NormName $x
            if ($script:PolicyByNorm.ContainsKey($k) -and $script:PolicyByNorm[$k] -ne $x) { $script:PolicyByNorm[$k] = '?' } else { $script:PolicyByNorm[$k] = $x }
        }
        Show-Step "DFW policies loaded: $($script:NsxPolicies.Count) from $($servers.Count) NSX Manager(s)" 'Green'
    }
    if ($groupsOk) { $script:NsxGroupTable = $groups; Show-Step "NSX groups loaded: $($groups.Count) from $($servers.Count) NSX Manager(s)" 'Green' }
}

# Application names as fast as possible - ID list first, then fill in names from the cheapest source that has them
#   1. names that already come back in the list response
#   2. bulk summaries (one call per 100 apps)
#   3. one call per app for whatever is still missing (slow, throttled)
function Get-AppIndex {
    $refs = @(Get-Paged -Path '/groups/applications' -Label 'applications')
    $names = @{}
    $pick  = { param($x) if ($x.entity_name) { [string]$x.entity_name } elseif ($x.name) { [string]$x.name } else { $null } }

    if ($FastNameLookup) {
        foreach ($x in $refs) { $n = & $pick $x; if ($n) { $names[$x.entity_id] = $n } }
        if ($names.Count -gt 0) { Show-Step "  $($names.Count) of $($refs.Count) names came back in the application list" }

        if ($names.Count -lt $refs.Count) {
            try {
                Show-Step '  trying the bulk application summaries...'
                $sum = @(Get-Paged -Path '/groups/applications/fetch?fetch_member_counts=false&fetch_update_status=false' -Label 'summaries')
                foreach ($x in $sum) { $n = & $pick $x; if ($n -and $x.entity_id) { $names[$x.entity_id] = $n } }
                Show-Step "  names known after the bulk call: $($names.Count) of $($refs.Count)"
            } catch { Show-Step "  bulk summaries not usable - $_" 'Yellow' }
        }
    }

    $todo = @($refs | Where-Object { -not $names.ContainsKey($_.entity_id) })
    if ($todo.Count -gt 0) {
        Show-Step "Fetching $($todo.Count) names one by one (about $([math]::Ceiling($todo.Count * ($RequestDelayMs + 150) / 1000)) s)"
        $i = 0
        foreach ($ref in $todo) {
            $i++
            $d = Invoke-Vrni -Path "/groups/applications/$($ref.entity_id)"
            $names[$ref.entity_id] = [string]$d.name
            if ($ShowProgress) { Write-Progress -Activity 'Reading application names' -Status "$i / $($todo.Count)" -PercentComplete (($i / [math]::Max($todo.Count, 1)) * 100) }
            if ($i % 25 -eq 0) { Show-Step "  names read: $i / $($todo.Count)" }
        }
        Write-Progress -Activity 'Reading application names' -Completed
    }

    @($refs | ForEach-Object { [pscustomobject]@{ Id = $_.entity_id; Name = $names[$_.entity_id] } } | Sort-Object Name)
}

# Compare app / policy names ignoring case, underscores, spaces and punctuation such as ( ) - so APP_NAME_X matches APP NAME (X)
function Get-NormName {
    param([string]$Name)
    (($Name -replace '[^A-Za-z0-9]+', ' ').Trim()).ToLower()
}

# DFW policy for a vRNI app - matched on the app name first, then on its FrontEnd SG name (ignoring _ / spaces / punctuation / case)
#   returns the policy name, $null when there is none, or '?' when more than one policy matches
function Find-DfwPolicy {
    param([string]$AppName, [string]$SgCi)
    if (-not $script:PolicyByNorm) { return $null }
    foreach ($k in @((Get-NormName $AppName), (Get-NormName $SgCi))) {
        if ($k -and $script:PolicyByNorm.ContainsKey($k)) { return $script:PolicyByNorm[$k] }
    }
    $null
}

# FrontEnd SG name of an app without the SG- prefix (from the tier cache, or read live), or $null
function Get-AppSgCi {
    param($App)
    $tiers = if ($script:TierCache -and $script:TierCache.ContainsKey($App.Id)) { $script:TierCache[$App.Id] } else { @(Get-AppTiers -AppId $App.Id) }
    foreach ($t in @($tiers)) { foreach ($f in @($t.Filters)) { if ($f -match "^Security Group = '(?<sg>SG-.+)-FrontEnd'$") { return $Matches['sg'].Substring(3) } } }
    $null
}

# Which DFW policy each vRNI app belongs to (app name first, then FrontEnd SG name) - AppId -> policy name, '?' or $null
function Resolve-AppPolicies {
    param($Apps)
    $map = @{}
    foreach ($a in $Apps) { $map[$a.Id] = Find-DfwPolicy -AppName $a.Name -SgCi (Get-AppSgCi -App $a) }
    $map
}

# vRNI only accepts letters, numbers, spaces, - and _ in an application name - anything else (such as brackets) is dropped
#   'APP (ENV) NAME' -> 'APP ENV NAME'
function Get-SafeAppName {
    param([string]$Name)
    (($Name -replace '[^A-Za-z0-9 _-]', ' ') -replace '\s+', ' ').Trim()
}
#endregion helpers -----------------------------------------------------------

#region modes ----------------------------------------------------------------
# List mode - one row per tier (apps with no tiers still get a row)
function Invoke-ListMode {
    param($Apps)
    $rows = New-Object System.Collections.Generic.List[object]
    foreach ($app in $Apps) {
        if ($script:TierCache -and $script:TierCache.ContainsKey($app.Id)) { $tiers = @($script:TierCache[$app.Id]) }
        else { $tiers = Get-AppTiers -AppId $app.Id }
        if (@($tiers).Count -eq 0) {
            $rows.Add([pscustomobject]@{ Application = $app.Name; Tier = ''; Filter = '' })
        }
        foreach ($t in $tiers) {
            $rows.Add([pscustomobject]@{ Application = $app.Name; Tier = $t.Name; Filter = ($t.Filters -join ' ; ') })
        }
    }
    $rows
}

# Rename an app in vRNI through "Add Application With Tiers" (it also edits a saved app when the entity_id is sent)
#   - If-Match carries the app's last modified time, so a change made by someone else in the meantime is refused
#   - every existing tier is sent back with its id and criteria, so the tiers stay as they are
function Rename-VrniApp {
    param($App, [string]$NewName)
    $d     = Invoke-Vrni -Path "/groups/applications/$($App.Id)"
    $tiers = @(Get-AppTiers -AppId $App.Id)
    foreach ($t in $tiers) {
        if ($t.OtherCriteria -gt 0 -or @($t.Criteria).Count -eq 0) { throw "Tier '$($t.Name)' has criteria that cannot be re-sent safely - rename the app by hand" }
    }
    $tierBody = @(foreach ($t in $tiers) {
        @{
            name = $t.Name
            entity_id = $t.Id
            group_membership_criteria = @(foreach ($c in $t.Criteria) {
                @{ membership_type = 'SearchMembershipCriteria'; search_membership_criteria = @{ entity_type = $c.EntityType; filter = $c.Filter } }
            })
        }
    })
    $body = @{ name = $NewName; entity_id = $App.Id; tiers = $tierBody }
    try {
        Invoke-Vrni -Method POST -Path '/groups/applications/full/' -Body $body -Extra @{ 'If-Match' = [string]$d.last_modified_time } | Out-Null
    } catch {
        # Keep the request that was refused (names and filters only - no credentials) so the cause can be checked
        $f = Join-Path $OutputDir ("rename_failed_{0}.json" -f ($App.Id -replace '[^\w]', '_'))
        try { @{ if_match = [string]$d.last_modified_time; body = $body } | ConvertTo-Json -Depth 10 | Set-Content -LiteralPath $f -Encoding UTF8 } catch {}
        throw "$_ (request saved to $f)"
    }
}

# Update mode - brings one existing app in line with the four zone tiers
#   1. find the FrontEnd tier and read the SG base from its filter
#   2. flag anything unusual as Review and leave it alone
#   3. plan: rename FrontEnd if needed, add the missing zone tiers
#   4. show the plan, ask, then apply (adds first, rename last)
function Update-App {
    param($App)
    $out    = New-Object System.Collections.Generic.List[object]
    $name   = $App.Name
    if ($script:TierCache -and $script:TierCache.ContainsKey($App.Id)) { $tiers = @($script:TierCache[$App.Id]) }
    else { $tiers = @(Get-AppTiers -AppId $App.Id) }

    # 1. FrontEnd tier - by name first, otherwise the tier with a single SG-<base>-FrontEnd filter
    $fe = @($tiers | Where-Object { $_.Name -ceq 'FrontEnd' })
    if ($fe.Count -eq 0) {
        $fe = @($tiers | Where-Object { $_.Filters.Count -eq 1 -and $_.Filters[0] -match "^Security Group = '.+-FrontEnd'$" })
    }
    $existingText = ($tiers | ForEach-Object { "$($_.Name): " + ($_.Filters -join ',') }) -join ' | '

    # 2. Anything that does not fit the pattern is listed for review, not guessed at
    if ($fe.Count -ne 1)               { $out.Add((New-Row $name 'Review' '' $existingText '' '' 'Review' 'Could not identify a single FrontEnd tier')); return $out }
    $feTier = $fe[0]
    if ($feTier.Filters.Count -ne 1)   { $out.Add((New-Row $name 'Review' $feTier.Name $existingText '' '' 'Review' 'FrontEnd tier has none or more than one filter')); return $out }
    if ($feTier.OtherCriteria -gt 0)   { $out.Add((New-Row $name 'Review' $feTier.Name $existingText '' '' 'Review' 'FrontEnd tier has extra non-search criteria')); return $out }
    if ($feTier.Filters[0] -notmatch "^Security Group = '(?<sg>SG-.+)-FrontEnd'$") {
        $out.Add((New-Row $name 'Review' $feTier.Name $existingText '' '' 'Review' 'FrontEnd filter is not Security Group = SG-<base>-FrontEnd')); return $out
    }
    $base = $Matches['sg']
    $ci   = $base.Substring(3)

    # Tiers always follow the FrontEnd SG:  SG-<APP CI>-<Zone>   (tag base:  ST-<APP_CI>)
    $tagBase = 'ST-' + ($ci -replace '\s+', '_')

    # App name (only with $RenameApps) - nothing here changes the tiers
    #   $UseDfwNames : new name = the NSX DFW policy name for this app (matched on app name, then FrontEnd SG name), cleaned for vRNI
    #   otherwise    : new name = the FrontEnd SG name, cleaned for vRNI
    #   when no safe new name can be worked out, only the rename is skipped - the tiers are still done
    $renameTo = $null
    if ($RenameApps) {
        $target = $null; $skip = $null
        if ($UseDfwNames) {
            $policy = Find-DfwPolicy -AppName $name -SgCi $ci
            if (-not $policy)       { $skip = 'No DFW policy in NSX matches this app - app not renamed' }
            elseif ($policy -eq '?') { $skip = 'More than one DFW policy matches this app - app not renamed' }
            else                    { $target = Get-SafeAppName $policy }
        } else {
            if ((Get-NormName $name) -ne (Get-NormName $ci)) { $skip = "App name differs from the SG base by more than _ / spaces / punctuation - app not renamed (SG base: $ci)" }
            else { $target = Get-SafeAppName $ci }
        }
        if ($target -and $name -cne $target -and $script:AppNames -and $script:AppNames.ContainsKey($target.ToLower())) { $skip = "An app named '$target' already exists - app not renamed"; $target = $null }
        if ($skip) { $out.Add((New-Row $name 'None' '' '' '' '' 'Rename skipped' $skip)); Show-Step "  $skip" 'Yellow' }
        elseif ($target -and $name -cne $target) { $renameTo = $target }
    }

    $unexpected = @($tiers | Where-Object { $Zones -notcontains $_.Name -and $_.Id -ne $feTier.Id })
    if ($unexpected.Count -gt 0) {
        $out.Add((New-Row $name 'Review' ($unexpected.Name -join ',') $existingText '' '' 'Review' 'Tier name is not one of the zones')); return $out
    }
    foreach ($z in $Zones) {
        $t = @($tiers | Where-Object { $_.Name -ceq $z -and $_.Id -ne $feTier.Id })
        if ($t.Count -gt 0) {
            $expected = "Security Group = '$base-$z'"
            if (@($t[0].Filters).Count -ne 1 -or $t[0].Filters[0] -cne $expected) {
                $out.Add((New-Row $name 'Review' $z ($t[0].Filters -join ',') '' '' 'Review' "Existing $z tier filter does not match $expected")); return $out
            }
        }
    }

    # 3. Build the plan (NSX lookups are for the report only)
    $plan = New-Object System.Collections.Generic.List[object]
    foreach ($z in $Zones) {
        $expected = "Security Group = '$base-$z'"
        $sgNsx  = Get-SgStatus -Name "$base-$z"
        $tagNsx = 'NotChecked'
        if ($z -eq 'FrontEnd') {
            if ($feTier.Name -cne 'FrontEnd') {
                $plan.Add([pscustomobject]@{ Action = 'Rename'; Tier = 'FrontEnd'; Old = $feTier.Name; TierId = $feTier.Id; Filter = $feTier.Filters[0]; Sg = $sgNsx; Tag = $tagNsx })
            } else {
                $out.Add((New-Row $name 'None' 'FrontEnd' $feTier.Filters[0] $sgNsx $tagNsx 'Already compliant' ''))
            }
        } elseif (@($tiers | Where-Object { $_.Name -ceq $z }).Count -eq 0) {
            $plan.Add([pscustomobject]@{ Action = 'Add'; Tier = $z; Old = ''; TierId = ''; Filter = $expected; Sg = $sgNsx; Tag = $tagNsx })
        } else {
            $out.Add((New-Row $name 'None' $z $expected $sgNsx $tagNsx 'Already compliant' ''))
        }
    }

    # Tag lookup only for apps that have something to change - keeps the number of search calls down
    if ($plan.Count -gt 0 -and $CheckTags -and $NsxCrossCheck) {
        foreach ($p in $plan) { $p.Tag = Test-VrniEntity -EntityType 'SecurityTag' -Name "$tagBase-$($p.Tier)" }
    }

    if ($plan.Count -eq 0 -and -not $renameTo) { Write-Host "OK     : $name - already has the 4 zone tiers"; return $out }

    Write-Host ''
    Write-Host '------------------------------------------------------------'
    Write-Host "Application : $name" -ForegroundColor Cyan
    Write-Host "SG base     : $base"
    if ($renameTo) { Write-Host "  RENAME app  '$name' -> '$renameTo'" -ForegroundColor Magenta }
    foreach ($p in $plan) {
        if ($p.Action -eq 'Rename') { Write-Host "  RENAME tier '$($p.Old)' -> 'FrontEnd'   (filter kept: $($p.Filter))   NSX SG: $($p.Sg)  tag: $($p.Tag)" }
        else                        { Write-Host "  ADD    tier $($p.Tier) -> $($p.Filter)   NSX SG: $($p.Sg)  tag: $($p.Tag)" }
    }
    Write-Host '------------------------------------------------------------'

    if ($DryRun) {
        if ($renameTo) { $out.Add((New-Row $name 'RenameApp' '' '' '' '' 'DryRun' "New name: $renameTo")) }
        foreach ($p in $plan) { $out.Add((New-Row $name $p.Action $p.Tier $p.Filter $p.Sg $p.Tag 'DryRun' $(if ($p.Old) { "Old name: $($p.Old)" } else { '' }))) }
        return $out
    }

    $answer = Get-UserConfirm -Prompt "Update '$name'?"
    if ($answer -eq 'N') { $out.Add((New-Row $name 'None' '' '' '' '' 'Skipped - declined' '')); return $out }
    if ($answer -eq 'Q') { $script:QuitNow = $true; $out.Add((New-Row $name 'None' '' '' '' '' 'Skipped - quit' '')); return $out }

    # 4. Apply - new tiers first, so a failed rename leaves the app no worse off
    foreach ($p in ($plan | Where-Object { $_.Action -eq 'Add' })) {
        try {
            Invoke-Vrni -Method POST -Path "/groups/applications/$($App.Id)/tiers" -Body (New-TierBody -Name $p.Tier -Filter $p.Filter) | Out-Null
            $out.Add((New-Row $name 'Add' $p.Tier $p.Filter $p.Sg $p.Tag 'Applied' ''))
            Write-Host "ADDED  : $name / $($p.Tier)" -ForegroundColor Green
        } catch { $out.Add((New-Row $name 'Add' $p.Tier $p.Filter $p.Sg $p.Tag 'Failed' "$_")); Write-Host "FAILED : $name / $($p.Tier) - $_" -ForegroundColor Red }
    }
    # Rename the existing tier to FrontEnd, keeping its filter
    foreach ($p in ($plan | Where-Object { $_.Action -eq 'Rename' })) {
        try {
            Invoke-Vrni -Method PUT -Path "/groups/applications/$($App.Id)/tiers/$($p.TierId)" -Body (New-TierBody -Name 'FrontEnd' -Filter $p.Filter) | Out-Null
            $out.Add((New-Row $name 'Rename' 'FrontEnd' $p.Filter $p.Sg $p.Tag 'Applied' "Old name: $($p.Old)"))
            Write-Host "RENAMED: $name / $($p.Old) -> FrontEnd" -ForegroundColor Green
        } catch { $out.Add((New-Row $name 'Rename' 'FrontEnd' $p.Filter $p.Sg $p.Tag 'Failed' "Old name: $($p.Old) | $_")); Write-Host "FAILED : rename on $name - $_" -ForegroundColor Red }
    }
    # Rename the app last, once its tiers are in place
    if ($renameTo) {
        try {
            Rename-VrniApp -App $App -NewName $renameTo
            $out.Add((New-Row $name 'RenameApp' '' '' '' '' 'Applied' "New name: $renameTo"))
            Write-Host "RENAMED: app '$name' -> '$renameTo'" -ForegroundColor Green
        } catch { $out.Add((New-Row $name 'RenameApp' '' '' '' '' 'Failed' "New name: $renameTo | $_")); Write-Host "FAILED : app rename on $name - $_" -ForegroundColor Red }
    }
    $out
}

# Create mode - builds one new vRNI app from a DFW policy name
#   1. app name = policy name, SG base = SG-<policy name>, tag base = ST-<policy_name>
#   2. plan the four zone tiers, each filtered on its zone SG (SG may not exist in NSX yet)
#   3. show the plan, ask, then create the app and its tiers
function New-AppFromPolicy {
    param([string]$Name, $NsxGroups)
    $out = New-Object System.Collections.Generic.List[object]

    # 1. Names that would break the filter go to review
    if ($Name -match "'") { $out.Add((New-Row $Name 'Review' '' '' '' '' 'Review' 'Policy name contains a single quote')); return $out }
    $base    = "SG-$Name"
    $tagBase = 'ST-' + ($Name -replace '\s+', '_')

    # 2. Plan (NSX / tag lookups are for the report only)
    $plan = foreach ($z in $Zones) {
        $sg = 'NotChecked'
        if ($NsxCrossCheck -and $NsxGroups) { $sg = if ($NsxGroups.ContainsKey("$base-$z")) { 'Found' } else { 'Missing' } }
        [pscustomobject]@{
            Tier = $z; Filter = "Security Group = '$base-$z'"; Sg = $sg
            Tag  = $(if ($CheckTags) { Test-VrniEntity -EntityType 'SecurityTag' -Name "$tagBase-$z" } else { 'NotChecked' })
        }
    }

    Write-Host ''
    Write-Host '------------------------------------------------------------'
    $appName = Get-SafeAppName $Name
    if ($appName -ceq $Name) { Write-Host "NEW Application : $appName" -ForegroundColor Cyan }
    else { Write-Host "NEW Application : $appName   (policy: $Name - characters vRNI does not accept removed)" -ForegroundColor Cyan }
    foreach ($p in $plan) { Write-Host "  ADD tier $($p.Tier) -> $($p.Filter)   NSX SG: $($p.Sg)  tag: $($p.Tag)" }
    Write-Host '------------------------------------------------------------'

    if ($DryRun) {
        foreach ($p in $plan) { $out.Add((New-Row $Name 'CreateApp' $p.Tier $p.Filter $p.Sg $p.Tag 'DryRun' '')) }
        return $out
    }

    # 3. Confirm, create the app, then its tiers
    $answer = Get-UserConfirm -Prompt "Create '$Name'?"
    if ($answer -eq 'N') { $out.Add((New-Row $Name 'None' '' '' '' '' 'Skipped - declined' '')); return $out }
    if ($answer -eq 'Q') { $script:QuitNow = $true; $out.Add((New-Row $Name 'None' '' '' '' '' 'Skipped - quit' '')); return $out }

    try {
        $app = Invoke-Vrni -Method POST -Path '/groups/applications' -Body @{ name = (Get-SafeAppName $Name) }
        if (-not $app.entity_id) { throw 'vRNI did not return an entity_id for the new application.' }
    } catch {
        $out.Add((New-Row $Name 'CreateApp' '' '' '' '' 'Failed' "$_")); Write-Host "FAILED : $Name - $_" -ForegroundColor Red
        return $out
    }
    Write-Host "CREATED: $Name" -ForegroundColor Green
    foreach ($p in $plan) {
        try {
            Invoke-Vrni -Method POST -Path "/groups/applications/$($app.entity_id)/tiers" -Body (New-TierBody -Name $p.Tier -Filter $p.Filter) | Out-Null
            $out.Add((New-Row $Name 'CreateApp' $p.Tier $p.Filter $p.Sg $p.Tag 'Applied' ''))
        } catch {
            $out.Add((New-Row $Name 'CreateApp' $p.Tier $p.Filter $p.Sg $p.Tag 'Failed' "App created, tier failed: $_"))
            Write-Host "FAILED : $Name / $($p.Tier) - $_" -ForegroundColor Red
        }
    }
    $out
}
