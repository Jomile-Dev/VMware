# Where the old VM lives
Get-VM -Name <old-vm> | Get-Datastore | Select-Object Name, Type | Format-Table -AutoSize

# If the RDM is currently attached to the old VM, this shows the pointer's datastore
Get-VM -Name <old-vm> | Get-HardDisk -DiskType RawPhysical, RawVirtual |
    Select-Object Name, ScsiCanonicalName, Filename | Format-Table -AutoSize
