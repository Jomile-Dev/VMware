$vm = Get-VM -Name <new-vm>
Get-ScsiController -VM $vm | Select-Object Name, Type, BusSharingMode
$vm.ExtensionData.Config.Hardware.Device |
    Where-Object { $_ -is [VMware.Vim.VirtualController] } |
    Select-Object @{n='Controller';e={$_.DeviceInfo.Label}}, @{n='Type';e={$_.GetType().Name}}
Get-HardDisk -VM $vm | Select-Object Name, DiskType, Filename
Get-Snapshot -VM $vm
