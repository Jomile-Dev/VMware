<#
    Search-NsxSyslogArchive.ps1

    Purpose : Search rotated NSX syslog archives for the audit event that created
              a local user account. Works on files copied off the appliances -
              the log API cannot reach rotated .gz archives.

    Runtime : Windows PowerShell 5.1. No modules required.

    Input   : A folder containing syslog files copied from the managers.
              Handles .gz and plain files. Decompresses as a stream, so large
              archives do not need to fit in memory.

    Naming  : Include the node name in each copied filename so the output can
              attribute a hit to the right manager, e.g.
                  nsxmgr-01_syslog.1.gz
                  nsxmgr-02_syslog.3.gz
#>

#region Configuration ---------------------------------------------------------

# Folder holding the copied log files.
$ArchiveDir = 'C:\Temp\NsxLogs'

# Account under investigation.
$TargetUser = 'OnfrAut2NSXT'

# Additional patterns. 'node/users' is the local-user API path.
$SearchPatterns = @(
    'node/users'
)

$OutputDir = 'C:\Temp\NsxUserAudit'

#endregion --------------------------------------------------------------------


#region Helpers ---------------------------------------------------------------

function Read-LogLines {
    <# Streams lines from a .gz or plain text log file. #>
    param([Parameter(Mandatory)] [string] $Path)

    $fs = $null; $gz = $null; $sr = $null
    try {
        $fs = [System.IO.File]::OpenRead($Path)

        if ($Path -like '*.gz') {
            $gz = New-Object System.IO.Compression.GzipStream(
                      $fs, [System.IO.Compression.CompressionMode]::Decompress)
            $sr = New-Object System.IO.StreamReader($gz)
        }
        else {
            $sr = New-Object System.IO.StreamReader($fs)
        }

        while (-not $sr.EndOfStream) {
            $sr.ReadLine()
        }
    }
    finally {
        if ($sr) { $sr.Dispose() }
        if ($gz) { $gz.Dispose() }
        if ($fs) { $fs.Dispose() }
    }
}

function ConvertFrom-AuditLine {
    param(
        [Parameter(Mandatory)] [string] $SourceFile,
        [Parameter(Mandatory)] [string] $Line
    )

    $ts      = ([regex]'\d{4}-\d{2}-\d{2}T[\d:.]+Z').Match($Line).Value
    $user    = ([regex]'username="([^"]*)"').Match($Line).Groups[1].Value
    $subcomp = ([regex]'subcomp="([^"]*)"').Match($Line).Groups[1].Value
    $comp    = ([regex]'comp="([^"]*)"').Match($Line).Groups[1].Value

    $request = ''
    $m = ([regex]"'(GET|POST|PUT|DELETE|PATCH)\s+([^']*)'").Match($Line)
    if ($m.Success) { $request = '{0} {1}' -f $m.Groups[1].Value, $m.Groups[2].Value }

    # CLI audit entries carry the command instead of an HTTP request.
    $command = ([regex]'CMD:\s*(.+?)(?:\s*\(duration|$)').Match($Line).Groups[1].Value

    [pscustomobject]@{
        Timestamp  = $ts
        ActedBy    = $user
        Component  = $comp
        SubComp    = $subcomp
        Request    = $request
        Command    = $command
        SourceFile = [System.IO.Path]::GetFileName($SourceFile)
        RawLine    = $Line.Trim()
    }
}

#endregion --------------------------------------------------------------------


#region Search ----------------------------------------------------------------

if (-not (Test-Path -LiteralPath $ArchiveDir)) {
    Write-Host ("Archive folder not found: {0}" -f $ArchiveDir) -ForegroundColor Red
    return
}
if (-not (Test-Path -LiteralPath $OutputDir)) {
    New-Item -Path $OutputDir -ItemType Directory -Force | Out-Null
}

$files = Get-ChildItem -LiteralPath $ArchiveDir -File |
         Where-Object { $_.Name -match 'syslog|\.gz$|\.log$' } |
         Sort-Object Name

if (-not $files) {
    Write-Host ("No log files found in {0}" -f $ArchiveDir) -ForegroundColor Yellow
    return
}

$patterns = @($TargetUser) + $SearchPatterns
$hits     = New-Object System.Collections.Generic.List[object]
$coverage = New-Object System.Collections.Generic.List[object]

Write-Host ''
Write-Host ("Searching {0} file(s) for '{1}'" -f $files.Count, $TargetUser) -ForegroundColor Cyan
Write-Host ('-' * 70)

foreach ($file in $files) {

    Write-Host ("[{0}] {1:N1} MB" -f $file.Name, ($file.Length / 1MB))

    $lineCount = 0
    $fileHits  = 0
    $firstTs   = $null
    $lastTs    = $null

    try {
        foreach ($line in (Read-LogLines -Path $file.FullName)) {

            $lineCount++

            $ts = ([regex]'\d{4}-\d{2}-\d{2}T[\d:.]+Z').Match($line).Value
            if ($ts) {
                if (-not $firstTs) { $firstTs = $ts }
                $lastTs = $ts
            }

            foreach ($pattern in $patterns) {
                if ($line -like ('*{0}*' -f $pattern)) {
                    $parsed = ConvertFrom-AuditLine -SourceFile $file.FullName -Line $line
                    $parsed | Add-Member -NotePropertyName 'MatchedPattern' -NotePropertyValue $pattern -Force
                    $hits.Add($parsed)
                    $fileHits++
                    break   # one hit record per line
                }
            }
        }
    }
    catch {
        Write-Host ("  read failed: {0}" -f $_.Exception.Message) -ForegroundColor Red
        continue
    }

    $coverage.Add([pscustomobject]@{
        File        = $file.Name
        Lines       = $lineCount
        OldestEntry = $firstTs
        NewestEntry = $lastTs
        Hits        = $fileHits
    })

    if ($fileHits -gt 0) {
        Write-Host ("  {0} hit(s)" -f $fileHits) -ForegroundColor Green
    }
    else {
        Write-Host '  no hits' -ForegroundColor DarkGray
    }
}

#endregion --------------------------------------------------------------------


#region Output ----------------------------------------------------------------

$stamp = Get-Date -Format 'yyyyMMdd-HHmmss'

Write-Host ''
Write-Host 'Coverage' -ForegroundColor Cyan
Write-Host ('-' * 70)
$coverage | Format-Table -AutoSize | Out-Host
Write-Host 'Check that the combined OldestEntry values reach back past the account'  -ForegroundColor Gray
Write-Host 'creation date. If they do not, you are missing archives from the managers.' -ForegroundColor Gray

Write-Host ''
Write-Host 'Matches' -ForegroundColor Cyan
Write-Host ('-' * 70)

if ($hits.Count -eq 0) {
    Write-Host 'No matching entries in the supplied archives.' -ForegroundColor Yellow
}
else {
    $hits | Sort-Object Timestamp |
        Select-Object Timestamp, ActedBy, SubComp, Request, Command, SourceFile |
        Format-Table -AutoSize -Wrap | Out-Host

    Write-Host 'ActedBy   : the account that performed the action.'          -ForegroundColor Gray
    Write-Host 'SubComp   : node-mgmt = UI/API call, cli = SSH session.'     -ForegroundColor Gray
    Write-Host 'Command   : populated for CLI-originated audit entries.'     -ForegroundColor Gray

    $csv = Join-Path $OutputDir ("NsxArchiveSearch-{0}-{1}.csv" -f $TargetUser, $stamp)
    $raw = Join-Path $OutputDir ("NsxArchiveSearch-{0}-{1}-raw.txt" -f $TargetUser, $stamp)

    $hits | Sort-Object Timestamp |
        Select-Object Timestamp, ActedBy, Component, SubComp, Request, Command, SourceFile, MatchedPattern |
        Export-Csv -Path $csv -NoTypeInformation -Encoding UTF8

    $hits | Sort-Object Timestamp | ForEach-Object { $_.RawLine } |
        Set-Content -Path $raw -Encoding UTF8

    Write-Host ''
    Write-Host ("Parsed : {0}" -f $csv) -ForegroundColor Green
    Write-Host ("Raw    : {0}" -f $raw) -ForegroundColor Green
}

Write-Host ''

#endregion --------------------------------------------------------------------
